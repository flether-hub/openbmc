[Unit]
Description=Disable the AST2600 built-in SuperIO (0x2E/0x2F decode)
DefaultDependencies=no
# The host is powered on after the BMC-ready heartbeat LED, which is started by
# ceb-gnrd-espi-heartbeat.service (multi-user.target), so this must come first.
Before=sysinit.target ceb-gnrd-espi-heartbeat.service x86-power-control.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ceb-gnrd-disable-superio.sh

[Install]
WantedBy=sysinit.target