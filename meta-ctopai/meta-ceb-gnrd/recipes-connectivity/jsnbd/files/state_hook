#!/bin/sh

if [ "$#" -ne 2 ]; then
    echo "usage: $0 <start|stop|recover> <config>" >&2
    exit 1
fi

action=$1
config=$2
case "$config" in
0) nbd_device=/dev/nbd0 ;;
1) nbd_device=/dev/nbd1 ;;
*) echo "invalid config $config" >&2; exit 1 ;;
esac

set -e
GADGET_BASE=/sys/kernel/config/usb_gadget
gadget_dir=$GADGET_BASE/mass-storage
owner_file=/run/nbd-proxy-gadget.owner
# Both hooks are children of the same nbd-proxy. A failed concurrent proxy
# must not remove the gadget owned by an existing session.
owner_id=$PPID:$config
# Serialize recovery, creation and teardown across both virtual media devices.
exec 9>/run/nbd-proxy-gadget.lock
flock -w 10 -x 9 || { echo "virtual media gadget lock is busy" >&2; exit 1; }
created=0
stage=initialization

log()
{
    echo "virtual-media[$config,proxy=$PPID,hook=$$]: $*" >&2
}

cleanup_gadget()
{
    [ -d "$gadget_dir" ] || return 0
    (
        cd "$gadget_dir" || return 1
        if [ -n "$(cat UDC)" ]; then
            log "unbind UDC=$(cat UDC) backing=$(cat functions/mass_storage.usb0/lun.0/file 2>/dev/null || true)"
            printf '\n' > UDC || return 1
        fi
        if [ -L configs/c.1/mass_storage.usb0 ]; then
            rm configs/c.1/mass_storage.usb0 || return 1
        fi
        if [ -d functions/mass_storage.usb0 ]; then
            rmdir functions/mass_storage.usb0 || return 1
        fi
        if [ -d configs/c.1/strings/0x409 ]; then
            rmdir configs/c.1/strings/0x409 || return 1
        fi
        if [ -d configs/c.1 ]; then
            rmdir configs/c.1 || return 1
        fi
        if [ -d strings/0x409 ]; then
            rmdir strings/0x409 || return 1
        fi
    ) || return 1
    rmdir "$gadget_dir"
}

hook_exit()
{
    rc=$?
    trap - 0
    if [ "$rc" -ne 0 ]; then
        log "$action failed stage=$stage (exit $rc)"
        if [ "$action" = start ] && [ "$created" -eq 1 ]; then
            log "rolling back incomplete gadget setup"
            if cleanup_gadget; then
                rm -f "$owner_file"
            else
                log "rollback failed; retaining ownership for stop cleanup"
            fi
        fi
    fi
    exit "$rc"
}
trap hook_exit 0

which_dev()
{
    in_use=$(
        for gadget in "$GADGET_BASE"/*; do
            [ -r "$gadget/UDC" ] || continue
            cat "$gadget/UDC"
        done
    )
    for udc in /sys/class/udc/*; do
        [ -e "$udc" ] || continue
        dev=${udc##*/}
        if ! printf '%s\n' "$in_use" | grep -Fqx -- "$dev"; then
            echo "$dev"
            return 0
        fi
    done
    log "no free USB device controller"
    return 1
}

recover_stale_gadget()
{
    [ -d "$gadget_dir" ] || return 0
    stale_owner=$(cat "$owner_file" 2>/dev/null) || {
        log "cannot identify existing gadget owner; retaining gadget"; return 1;
    }
    stale_pid=${stale_owner%%:*}
    stale_config=${stale_owner#*:}
    case "$stale_pid" in ''|*[!0-9]*|0) log "invalid gadget owner; retaining gadget"; return 1 ;; esac
    case "$stale_config" in
        0) stale_device=/dev/nbd0 ;;
        1) stale_device=/dev/nbd1 ;;
        *) log "invalid owner configuration; retaining gadget"; return 1 ;;
    esac
    [ "$stale_owner" = "$stale_pid:$stale_config" ] || return 1
    if [ -e "/proc/$stale_pid" ]; then
        log "gadget owner $stale_pid still exists; retaining active session"
        return 1
    fi
    stale_name=${stale_device##*/}
    backing=$(cat "$gadget_dir/functions/mass_storage.usb0/lun.0/file" 2>/dev/null || true)
    if [ -n "$backing" ] && [ "$backing" != "$stale_device" ]; then
        log "gadget backing differs from owner record; retaining gadget"
        return 1
    fi
    # A dead proxy does not imply a disconnected NBD. Its client can survive
    # until the kernel timeout, so require the kernel connection to be gone.
    if [ -e "/sys/block/$stale_name/pid" ]; then
        client_pid=$(cat "/sys/block/$stale_name/pid") || return 1
        [ "$client_pid" = 0 ] || {
            log "$stale_name still has NBD client $client_pid; retaining gadget"; return 1;
        }
    fi
    pending=$(awk '{print $9}' "/sys/block/$stale_name/stat") || return 1
    [ "$pending" = 0 ] || { log "$stale_name has pending I/O; retaining gadget"; return 1; }
    for block in /sys/class/block/"$stale_name"*; do
        block_name=${block##*/}
        case "$block_name" in "$stale_name"|"$stale_name"p[0-9]*) ;; *) continue ;; esac
        for holder in "$block"/holders/*; do
            [ ! -e "$holder" ] || { log "$block_name has a block holder; retaining gadget"; return 1; }
        done
        dev=$(cat "$block/dev") || return 1
        if awk -v dev="$dev" '$3 == dev {found=1} END {exit !found}' /proc/self/mountinfo; then
            log "$block_name is mounted; retaining gadget"
            return 1
        fi
        [ -b "/dev/$block_name" ] || { log "cannot inspect $block_name device node; retaining gadget"; return 1; }
        if fuser -s "/dev/$block_name"; then
            log "$block_name is open in another process; retaining gadget"
            return 1
        else
            usage_status=$?
            [ "$usage_status" = 1 ] || { log "cannot determine $block_name usage; retaining gadget"; return 1; }
        fi
    done
    # Recheck ownership under the hook lock immediately before unbinding.
    [ "$(cat "$owner_file")" = "$stale_owner" ] && [ ! -e "/proc/$stale_pid" ] || return 1
    log "reclaiming stale gadget owner=$stale_owner backing=$backing; NBD disconnected and unused"
    cleanup_gadget || return 1
    rm -f "$owner_file"
}

case "$action" in
recover)
    stage=recover-stale-gadget
    recover_stale_gadget
    ;;
start)
    log "start: backing device $nbd_device"
    [ -b "$nbd_device" ] || { log "backing block device is missing"; exit 1; }
    if [ -d "$gadget_dir" ]; then
        log "gadget already exists; previous session must finish cleanup first"
        exit 1
    fi
    stage=select-udc
    log "NBD sectors=$(cat /sys/block/${nbd_device##*/}/size 2>/dev/null || true) client_pid=$(cat /sys/block/${nbd_device##*/}/pid 2>/dev/null || true)"
    device=$(which_dev)
    log "selected UDC=$device"
    stage=create-gadget
    # mkdir without -p atomically rejects another session's existing gadget.
    mkdir "$gadget_dir"
    created=1
    printf '%s\n' "$owner_id" > "$owner_file"
    stage=configure-and-bind
    (
        cd "$gadget_dir"
        echo 0x1d6b > idVendor
        echo 0x0104 > idProduct
        mkdir -p strings/0x409
        echo OpenBMC > strings/0x409/manufacturer
        echo "Virtual Media Device" > strings/0x409/product
        mkdir -p configs/c.1/strings/0x409
        echo "config 1" > configs/c.1/strings/0x409/configuration
        mkdir -p functions/mass_storage.usb0
        ln -s functions/mass_storage.usb0 configs/c.1
        echo 1 > functions/mass_storage.usb0/lun.0/removable
        echo 1 > functions/mass_storage.usb0/lun.0/ro
        echo 0 > functions/mass_storage.usb0/lun.0/cdrom
        log "attach LUN backing=$nbd_device ro=1 removable=1 cdrom=0"
        echo "$nbd_device" > functions/mass_storage.usb0/lun.0/file
        log "binding $nbd_device to $device"
        echo "$device" > UDC
    )
    log "USB storage gadget bound successfully owner=$owner_id UDC=$(cat "$gadget_dir/UDC") backing=$(cat "$gadget_dir/functions/mass_storage.usb0/lun.0/file")"
    ;;
stop)
    owner=$(cat "$owner_file" 2>/dev/null || true)
    if [ "$owner" != "$owner_id" ]; then
        log "no gadget owned by this session; skipping cleanup expected=$owner_id actual=$owner"
        exit 0
    fi
    log "stop: disconnect USB gadget before removing its configuration"
    stage=unbind-and-remove
    cleanup_gadget
    rm -f "$owner_file"
    log "USB storage gadget removed"
    ;;
*) echo "invalid action $action" >&2; exit 1 ;;
esac
