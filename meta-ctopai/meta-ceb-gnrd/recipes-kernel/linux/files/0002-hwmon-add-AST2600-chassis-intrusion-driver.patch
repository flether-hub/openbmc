From: CEB-GNRD platform <platform@example.invalid>
Subject: [PATCH] hwmon: add AST2600 chassis intrusion latch support

Backport the AST2600 chassis hwmon driver and the SoC device-tree node needed
to expose the dedicated CHASI# latch as intrusion0_alarm.

Upstream-Status: Inappropriate [CEB-GNRD board-specific]
---
 drivers/hwmon/Kconfig                  |   9 +
 drivers/hwmon/Makefile                 |   1 +
 drivers/hwmon/aspeed-chassis.c         | 108 +++++++++++++++++++++
 arch/arm/boot/dts/aspeed/aspeed-g6.dtsi |   7 +
 4 files changed, 124 insertions(+)

diff --git a/drivers/hwmon/Kconfig b/drivers/hwmon/Kconfig
--- a/drivers/hwmon/Kconfig
+++ b/drivers/hwmon/Kconfig
@@ -407,6 +407,14 @@ config SENSORS_ASPEED_G6
 	  This driver can also be built as a module. If so, the module
 	  will be called aspeed_g6_pwm_tach.
 
+config SENSORS_ASPEED_CHASSIS
+	tristate "ASPEED AST2600 chassis intrusion driver"
+	depends on ARCH_ASPEED || COMPILE_TEST
+	help
+	  Enable support for the AST2600 dedicated chassis intrusion latch.
+	  The driver exposes the latched state through the standard hwmon
+	  intrusion0_alarm attribute.
+
 config SENSORS_ATXP1
 	tristate "Attansic ATXP1 VID controller"
 	depends on I2C
diff --git a/drivers/hwmon/Makefile b/drivers/hwmon/Makefile
--- a/drivers/hwmon/Makefile
+++ b/drivers/hwmon/Makefile
@@ -55,6 +55,7 @@
 obj-$(CONFIG_SENSORS_ASC7621)	+= asc7621.o
 obj-$(CONFIG_SENSORS_ASPEED)	+= aspeed-pwm-tacho.o
 obj-$(CONFIG_SENSORS_ASPEED_G6) += aspeed-g6-pwm-tach.o
+obj-$(CONFIG_SENSORS_ASPEED_CHASSIS) += aspeed-chassis.o
 obj-$(CONFIG_SENSORS_ASUS_ROG_RYUJIN)	+= asus_rog_ryujin.o
 obj-$(CONFIG_SENSORS_ATXP1)	+= atxp1.o
 obj-$(CONFIG_SENSORS_AXI_FAN_CONTROL) += axi-fan-control.o
diff --git a/drivers/hwmon/aspeed-chassis.c b/drivers/hwmon/aspeed-chassis.c
new file mode 100644
index 000000000000..000000000000
--- /dev/null
+++ b/drivers/hwmon/aspeed-chassis.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Copyright (C) 2021 ASPEED Technology Inc.
+ *
+ * AST2600 chassis intrusion (CHASI#) latch, exposed as hwmon intrusion0_alarm.
+ * The latch is polled (dbus-sensors reads it periodically), so the interrupt
+ * is left masked.  Writing 0 to intrusion0_alarm clears the latch.
+ */
+#include <linux/bits.h>
+#include <linux/hwmon.h>
+#include <linux/hwmon-sysfs.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+
+#define CHASSIS_CTRL_INTRUSION_CLEAR	BIT(0)
+#define CHASSIS_CTRL_INTRUSION_INT_EN	BIT(1)
+#define CHASSIS_CTRL_INTRUSION_STATUS	BIT(2)
+#define CHASSIS_CTRL_IO_POWER_INT_EN	BIT(9)
+#define CHASSIS_CTRL_CORE_POWER_INT_EN	BIT(17)
+
+struct aspeed_chassis {
+	void __iomem *base;
+	const struct attribute_group *groups[2];
+};
+
+static ssize_t intrusion0_alarm_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct aspeed_chassis *chassis = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n",
+			  !!(readl(chassis->base) & CHASSIS_CTRL_INTRUSION_STATUS));
+}
+
+static ssize_t intrusion0_alarm_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct aspeed_chassis *chassis = dev_get_drvdata(dev);
+	unsigned long val;
+	u32 ctrl;
+
+	if (kstrtoul(buf, 10, &val) < 0 || val != 0)
+		return -EINVAL;
+
+	/* The clear bit must be pulsed: set, then release. */
+	ctrl = readl(chassis->base);
+	writel(ctrl | CHASSIS_CTRL_INTRUSION_CLEAR, chassis->base);
+	writel(ctrl & ~CHASSIS_CTRL_INTRUSION_CLEAR, chassis->base);
+	return count;
+}
+
+static DEVICE_ATTR_RW(intrusion0_alarm);
+
+static struct attribute *aspeed_chassis_attrs[] = {
+	&dev_attr_intrusion0_alarm.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(aspeed_chassis);
+
+static int aspeed_chassis_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct aspeed_chassis *priv;
+	struct device *hwmon;
+	u32 ctrl;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	/* Polled only: keep the latch interrupts masked. */
+	ctrl = readl(priv->base);
+	ctrl &= ~(CHASSIS_CTRL_INTRUSION_INT_EN | CHASSIS_CTRL_IO_POWER_INT_EN |
+		  CHASSIS_CTRL_CORE_POWER_INT_EN);
+	writel(ctrl, priv->base);
+
+	hwmon = devm_hwmon_device_register_with_groups(dev, "aspeed_chassis",
+						       priv,
+						       aspeed_chassis_groups);
+	return PTR_ERR_OR_ZERO(hwmon);
+}
+
+static const struct of_device_id aspeed_chassis_of_table[] = {
+	{ .compatible = "aspeed,ast2600-chassis" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aspeed_chassis_of_table);
+
+static struct platform_driver aspeed_chassis_driver = {
+	.probe = aspeed_chassis_probe,
+	.driver = {
+		.name = KBUILD_MODNAME,
+		.of_match_table = aspeed_chassis_of_table,
+	},
+};
+module_platform_driver(aspeed_chassis_driver);
+
+MODULE_AUTHOR("ASPEED Technology Inc.");
+MODULE_DESCRIPTION("ASPEED AST2600 chassis intrusion driver");
+MODULE_LICENSE("GPL");
diff --git a/arch/arm/boot/dts/aspeed/aspeed-g6.dtsi b/arch/arm/boot/dts/aspeed/aspeed-g6.dtsi
--- a/arch/arm/boot/dts/aspeed/aspeed-g6.dtsi
+++ b/arch/arm/boot/dts/aspeed/aspeed-g6.dtsi
@@ -399,6 +399,13 @@ adc1: adc@1e6e9100 {
 				#io-channel-cells = <1>;
 				status = "disabled";
 			};
+
+			chassis: chassis@1e6ef010 {
+				compatible = "aspeed,ast2600-chassis";
+				reg = <0x1e6ef010 0x4>;
+				interrupts = <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;
+				status = "disabled";
+			};
 
 			sbc: secure-boot-controller@1e6f2000 {
 				compatible = "aspeed,ast2600-sbc";
-- 
2.43.0
