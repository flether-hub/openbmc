// SPDX-License-Identifier: GPL-2.0-or-later
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>

/*
 * CEB-GNRD network topology:
 *   MAC2: independent management RJ45 through the RTL8211 RGMII PHY
 *   MAC3: host-side NC-SI through the dedicated NCSI3 pin group
 *
 * Physical MAC2 is the independent RGMII2/RTL8211 port; physical MAC3 is the
 * E810 NC-SI port. Linux phandles are offset: &mac1 is physical MAC2 and
 * &mac2 is physical MAC3. Disable physical MAC1 and MAC4.
 */
#include "aspeed-ast2600-evb.dts"

/ {
    model = "CEB-GNRD Xeon 6 BMC";
    compatible = "ctopai,ceb-gnrd", "aspeed,ast2600";

    /* One SK hynix H5AN8G6NDJR-XNC, 8 Gbit x16 = 1 GiB.
     * U-Boot narrows this physical range to exclude VGA/SSP and ECC parity.
     * Do not hard-code the resulting size: it depends on detected RAM and
     * VGA straps. The inherited video/framebuffer pools allocate dynamically
     * inside the memory range handed over by U-Boot. */
    memory@80000000 {
        reg = <0x80000000 0x40000000>;
    };

    aliases {
        ethernet0 = &mac1;
        ethernet1 = &mac2;
    };

    /* PWM outputs of SYS_FAN0-5 as hwmon pwm1 of pwm-fan0..5: the
     * aspeed-g6-pwm-tach driver registers its PWMs only as a pwmchip, and
     * dbus-sensors' fansensor finds a fan's PWM in a "pwm-fanN" device
     * (otherwise "Connector ... no pwm channel found" and phosphor-pid-control
     * cannot set the fan speed).  pwm-fan starts at full duty; the fans stay
     * with the CPLD until BMC_FAN_BMC_OVERRIDE_N is driven high. */
    pwm-fan0 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 0 40000 0>;
    };

    pwm-fan1 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 1 40000 0>;
    };

    pwm-fan2 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 2 40000 0>;
    };

    pwm-fan3 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 3 40000 0>;
    };

    pwm-fan4 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 4 40000 0>;
    };

    pwm-fan5 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 5 40000 0>;
    };

    leds {
        compatible = "gpio-leds";

        bmc-heartbeat {
            label = "bmc-heartbeat";
            gpios = <&gpio0 127 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        /* System alert (fault) LED, driven through phosphor-led-manager (group
         * enclosure_fault).  The label is the LED name used in led.json and in
         * the D-Bus path; keep it free of dashes. */
        system-alert {
            label = "fault";
            gpios = <&gpio0 69 GPIO_ACTIVE_HIGH>;
            default-state = "off";
        };


        identify {
            label = "identify";
            gpios = <&gpio0 169 GPIO_ACTIVE_HIGH>;
            default-state = "off";
        };
    };

    /* Publish all confirmed AST2600 ADC inputs to hwmon/dbus-sensors. */
    iio-hwmon {
        compatible = "iio-hwmon";
        io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
            <&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
            <&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
            <&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
};
};

/* GPIO 名称及 offset 按 AST2600 GPIO A0 起始的 bank 顺序标注。 */
&gpio0 {
    gpio-line-names =
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "BMC_FRU_WP", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "BMC_SYS_ALERT_LED", "BMC_FAN_BMC_OVERRIDE_N", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "BMC_BIOS_FLASH_SELECT", "BMC_POWER_BUTTON_INPUT", "", "", "", "", "BMC_BIOS_BOOT_OK",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "BMC_HBLED_N",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "PCB_VER0", "PCB_VER1", "PCB_VER2", "CFG_VER0",
        "", "", "", "", "", "", "", "",
        "", "", "", "", "", "", "", "",
        "BMC_UID_BUTTON_N", "BMC_UID_LED", "BMC_CPU_POWER_BUTTON", "BMC_CPU_RESET", "BMC_CPU_PWRGD";
};

&mac0 {
    status = "disabled";
};

/* phosphor-ipmi-kcs defaults to ipmi-kcs3.  The host BIOS reaches the BMC KCS
 * interface at I/O port 0xCA2 (data) / 0xCA3 (status).  The kernel driver
 * refuses to probe without 'aspeed,lpc-io-reg'; KCS channel 3 only supports the
 * inferred status address, so a single address is given.  No SerIRQ
 * ('aspeed,lpc-interrupts') is configured: the host BIOS/OS drivers poll the KCS
 * status register. */
&kcs3 {
    status = "okay";
    aspeed,lpc-io-reg = <0xca2>;
};

/* Capture BIOS POST writes to I/O port 0x80. This snoop is separate from
 * Peripheral I/O-cycle completion, which AST2600 handles in hardware. */
&lpc_snoop {
    status = "okay";
    snoop-ports = <0x80>;
};

/* AST2600 dedicated CHASI# latch; publishes intrusion0_alarm via hwmon. */
&chassis {
    status = "okay";
};

/* WDT1 is reserved for systemd's hardware runtime watchdog.  When userspace stops
 * servicing /dev/watchdog (or the kernel panics) it resets the SoC only
 * ("soc"), not the whole chip ("system"): a full-chip reset drives the GPIOs to
 * their power-on state and could glitch the CPLD / host-facing signals (fan
 * ownership, BIOS flash select, power button outputs) while the host is running.
 * Check on the board that the GPIO levels stay stable across a watchdog reset. */
&wdt1 {
    status = "okay";
    aspeed,reset-type = "soc";
};

/* Reserve AST2600 GPIOW0-W7 for the Xeon 6 host eSPI connection.
 * ESPI selects W0-W5/W7; W6/AD7 is the separate ESPIALT group, so both
 * pinctrl groups are required. The driver makes the Peripheral and Virtual Wire
 * channels ready; OOB and Flash Access stay unused.
 */
&{/ahb} {
    espi: espi@1e6ee000 {
        compatible = "aspeed,ast2600-espi-peripheral";
        reg = <0x1e6ee000 0x1000>;
        interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&syscon ASPEED_CLK_GATE_ESPICLK>;
        resets = <&syscon 57>;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_espi_default &pinctrl_espialt_default>;
        status = "okay";
    };
};

/* Host serial console (SOL): AST2600 VUART1, which the host sees as COM1
 * (I/O 0x3F8) through the eSPI Peripheral channel.  It is bidirectional.  The BIOS
 * polls its line status register, so it must stay enabled or the BIOS can hang
 * waiting for "transmitter empty".  Linux names it ttyS5; udev (udev-aspeed-vuart)
 * adds the ttyVUART0 symlink that obmc-console uses.  The SerIRQ (IRQ4) only helps
 * host input: eSPI delivers it through a Virtual Wire (the channel is ready, but
 * whether the VUART interrupt really becomes an IRQ wire is untested), so check
 * on the board that typing in SOL reaches the host. */
&vuart1 {
    status = "okay";
    aspeed,lpc-io-reg = <0x3f8>;
    aspeed,lpc-interrupts = <4 IRQ_TYPE_LEVEL_HIGH>;
};

/* Default physical SOL: UART3 TX/RX, matching the physical-board dump.
 * UART5 remains the BMC debug console on ttyS4. */
&uart3 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_txd3_default &pinctrl_rxd3_default>;
};

/* BMC debug console is wired to the dedicated AST2600 UART5 pads C8/D8.
 * UART5 has no separate pinctrl group in the pinned AST2600 pinctrl driver.
 */
&uart5 {
    status = "okay";
};

/* AST2600 GFX drives the board VGA display path. RGB DAC and DDC are fixed
 * VGA signals; select the muxed horizontal/vertical sync pads explicitly.
 */
&gfx {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_vgahs_default &pinctrl_vgavs_default>;
};

/* Separate AST2600 capture engine used by BMC KVM for host video. */
&video {
    status = "okay";
    memory-region = <&video_engine_memory>;
};

/* USB2A is wired to the host VL805 port 4 and must operate as a device. */
&ehci0 {
    status = "disabled";
};

&vhub {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_usb2ad_default>;
};

/* RTL8211FS-CG: MDIO address 1, confirmed by the physical-board dump.
 * Use "rgmii-id" to match the physical-board dump's RX/TX delay mode.
 * PHY reset (RTL8211_SYS_RSTN) is driven by the CPLD, so no reset-gpios here. */
&ethphy1 {
    reg = <1>;
};

/* Physical MAC2: independent RJ45 through the RTL8211FS-CG PHY. */
&mac1 {
    status = "okay";
    phy-mode = "rgmii-id";
    phy-handle = <&ethphy1>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_rgmii2_default>;
};

/* Physical MAC3: NC-SI connection to the Intel E810. */
&mac2 {
    status = "okay";
    /delete-property/ phy-handle;
    /delete-property/ phy-mode;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_ncsi3_default>;
    use-ncsi;
};

&mac0 { status = "disabled"; };
&mac3 { status = "disabled"; };
/* The EVB include enables all four MDIO buses.  Only mdio1 (physical MAC2,
 * RTL8211FS) is used; the others claim pins that I2C12 needs (L26). */
&mdio0 { status = "disabled"; };
&mdio2 { status = "disabled"; };
&mdio3 { status = "disabled"; };

/* AST2600 Firmware SPI (FMC) hosts the 64 MiB Winbond W25Q512JVFIQ.
 * The schematic routes DQ2/DQ3 to AE12/AF12: select only FWQSPI.
 * Keep CS0/CLK/DQ0/DQ1 on the dedicated FWSPI boot pads; FWSPID would
 * incorrectly switch those signals to the alternate Y1-Y4 pads.
 */
&fmc {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_fwqspi_default>;
    /delete-node/ flash@0;

    flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        label = "bmc";
        spi-max-frequency = <50000000>;
        spi-rx-bus-width = <4>;
        spi-tx-bus-width = <4>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            u-boot@0 { reg = <0x00000000 0x000e0000>; label = "u-boot"; };
            u-boot-env@e0000 { reg = <0x000e0000 0x00020000>; label = "u-boot-env"; };
            kernel@100000 { reg = <0x00100000 0x00900000>; label = "kernel"; };
            rofs@a00000 { reg = <0x00a00000 0x02800000>; label = "rofs"; };
            rwfs@3200000 { reg = <0x03200000 0x00e00000>; label = "rwfs"; };
        };
    };
};

/* Host BIOS NOR on AST2600 SPI1 CS0 (Macronix MX25U51245GMI00).
 * SPI1 is used only by the BIOS updater and remains in single-bit mode.
 */
&spi1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_spi1_default>;
    /delete-node/ flash@0;

    flash@0 {
        /* Only bios-update.sh may bind spi-nor after taking ownership. */
        compatible = "ctopai,ceb-gnrd-host-bios";
        reg = <0>;
        label = "host-bios-chip";
        spi-max-frequency = <50000000>;
        spi-rx-bus-width = <1>;
        spi-tx-bus-width = <1>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            host-bios@0 {
                label = "host-bios";
                reg = <0x00000000 0x04000000>;
            };
        };
    };
};

/* SPI2 is not connected to either system or BIOS flash on this board. */
&spi2 {
    status = "disabled";
};

/* GPIOM1/NDCD1 is requested as GPIO by the BIOS updater; do not mux it as
 * UART1 modem control.
 */
&uart1 {
    status = "disabled";
};

/* The schematic labels these as ADC0..ADC15 and uses the 10K/1K or
 * 10K/10K dividers recorded in the Entity-Manager configuration.
 * AST2600 has two 8-channel ADC engines: pads ADC0-7 are &adc0 channels 0-7
 * and pads ADC8-15 are &adc1 channels 0-7. */
&adc0 {
    status = "okay";
    aspeed,int-vref-microvolt = <2500000>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
        &pinctrl_adc2_default &pinctrl_adc3_default
        &pinctrl_adc4_default &pinctrl_adc5_default
        &pinctrl_adc6_default &pinctrl_adc7_default>;
};

&adc1 {
    status = "okay";
    aspeed,int-vref-microvolt = <2500000>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
        &pinctrl_adc10_default &pinctrl_adc11_default
        &pinctrl_adc12_default &pinctrl_adc13_default
        &pinctrl_adc14_default &pinctrl_adc15_default>;
};

/* Six fan headers are wired to PWM/TACH channels 0..5.  The aspeed-g6-pwm-tach
 * driver needs "tach-ch" and "pwms" in each fan child (PWM period 40000 ns =
 * 25 kHz); the older "reg" / "aspeed,fan-tach-ch" form makes it fail with
 * "Failed to create fan -22". */
&pwm_tach {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default
        &pinctrl_pwm2_default &pinctrl_pwm3_default
        &pinctrl_pwm4_default &pinctrl_pwm5_default
        &pinctrl_tach0_default &pinctrl_tach1_default
        &pinctrl_tach2_default &pinctrl_tach3_default
        &pinctrl_tach4_default &pinctrl_tach5_default>;

    fan-0 {
        tach-ch = /bits/ 8 <0>;
        pwms = <&pwm_tach 0 40000 0>;
    };

    fan-1 {
        tach-ch = /bits/ 8 <1>;
        pwms = <&pwm_tach 1 40000 0>;
    };

    fan-2 {
        tach-ch = /bits/ 8 <2>;
        pwms = <&pwm_tach 2 40000 0>;
    };

    fan-3 {
        tach-ch = /bits/ 8 <3>;
        pwms = <&pwm_tach 3 40000 0>;
    };

    fan-4 {
        tach-ch = /bits/ 8 <4>;
        pwms = <&pwm_tach 4 40000 0>;
    };

    fan-5 {
        tach-ch = /bits/ 8 <5>;
        pwms = <&pwm_tach 5 40000 0>;
    };
};

/* PECI on AT29 / BMC_CPU_PECI connects to the Xeon 6 CPU.
 * CPU and DIMM temperatures are read over PECI, not the DIMM I3C buses.
 */
&peci0 {
    status = "okay";
};

/* CPU management uses AST2600 I3C3 on I3C3SCL_FSI1CLK/I3C3SDA_FSI1DATA.
 * DIMM temperatures are obtained over PECI; BMC I3C1/2 and I3C4 are unused.
 */
&i3c0 { status = "disabled"; };
&i3c1 { status = "disabled"; };
&i3c2 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i3c3_default>;
};
&i3c3 { status = "disabled"; };
&i3c4 { status = "disabled"; };
&i3c5 { status = "disabled"; };

/* This board has no eMMC and no SD card; the EVB include enables all three SDHCI
 * slots, which only makes the kernel probe cards that are not there
 * ("mmc0: Failed to initialize a non-removable card").
 */
&emmc { status = "disabled"; };
&emmc_controller { status = "disabled"; };
&sdhci0 { status = "disabled"; };
&sdhci1 { status = "disabled"; };
&sdc { status = "disabled"; };

/*
 * AST2600 DT labels are zero-based: schematic I2C7 is &i2c6.  The EVB
 * include enables demo devices on Linux i2c-7 and i2c-8; remove those before
 * assigning the board's actual temperature, CRPS and CPLD bus functions.
 */
/* PCIe slot I2C access: schematic AST I2C1..6 map to Linux &i2c0..&i2c5. */
&i2c0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c1_default>;
};

&i2c1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c2_default>;
};

&i2c2 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c3_default>;
};

&i2c3 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c4_default>;
};

&i2c4 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c5_default>;
};

&i2c5 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c6_default>;
};

&i2c6 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c7_default>;

    /* Four NST175H-QSPR sensors at 0x48-0x4b (strap code = low address bits):
     * EnvTemp_Inlet, EnvTemp_Outlet, BoardTemp_PCIe, BoardTemp_M2.  They are not
     * declared here: the Entity-Manager configuration (Type LM75A) makes
     * dbus-sensors create the devices itself.  Declaring them in both places made
     * every Entity-Manager scan log "Failed to register i2c client lm75a at 0x4x
     * (-16)", because the kernel already owned the address. */
};

&i2c7 {
    status = "okay";
    /* MEG-CRPS800AOP PMBus 1.2 supports at most 100 kbit/s. */
    clock-frequency = <100000>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c8_default>;
    /delete-node/ temp@2e;
    /delete-node/ eeprom@50;

    /* CRPS PMBus modules (0, 1 or 2 present at 0x58/0x59/0x5a) are not declared
     * here: ceb-gnrd-psu-detect creates a megcrps800 device for each installed
     * module, so empty slots do not log probe failures. */
};

/* Schematic I2C9 connects to CPLD-reserved pins; no target is currently used. */
&i2c8 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c9_default>;
    /delete-node/ lm75@4d;
};
/* The AST2600 internal RTC has no battery backup.  Disable it (the EVB include
 * enables it) so the battery-backed NCT3015Y below is rtc0, which the kernel
 * uses to set the system clock at boot (CONFIG_RTC_HCTOSYS_DEVICE="rtc0"). */
&rtc {
    status = "disabled";
};

/* Schematic RTC bus 10 is AST2600 I2C10 (Linux i2c9), on SDA2/SCL2
 * of the NCT3015Y-R; its first I2C port is connected to the host CPU. */
&i2c9 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c10_default>;

    /* NCT3015Y-R is bound through the nct3018y driver's only compatible. */
    rtc@6f {
        compatible = "nuvoton,nct3018y";
        reg = <0x6f>;
    };
};

/* Schematic I2C11 carries the FM24C08D motherboard FRU at address 0x50. */
&i2c10 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c11_default>;

    eeprom@50 {
        compatible = "atmel,24c08";
        reg = <0x50>;
        pagesize = <16>;
        size = <1024>;
        num-addresses = <4>;
        wp-gpios = <&gpio0 54 GPIO_ACTIVE_HIGH>;
    };
};

/* I2C12 TCA9546 and I2C13/14 MCIO are reserved board interfaces. */
&i2c11 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c12_default>;
};

&i2c12 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c13_default>;
};

&i2c13 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c14_default>;
};
/* CPU SMBUS_HOST PROM path: BMC_PROM_SCL/SDA use AST2600 I2C15 on
 * GPIOH4/SCL15 and GPIOH5/SDA15 (Linux adapter i2c-14). */
&i2c14 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c15_default>;
};
&i2c15 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c16_default>;
};
