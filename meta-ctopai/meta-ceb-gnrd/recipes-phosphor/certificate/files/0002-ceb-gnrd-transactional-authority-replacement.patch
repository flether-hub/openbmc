+// Durability is part of the transaction: no previous store is retired until
+// certificate payloads and the directory commit have reached the filesystem.
+void syncAuthorityPath(const fs::path& path, bool directory)
+{
+    const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW |
+                        (directory ? O_DIRECTORY : 0));
+    if (fd < 0)
+    {
+        throw std::system_error(errno, std::generic_category(), "open CA storage");
+    }
+    const int result = fsync(fd);
+    const int error = errno;
+    close(fd);
+    if (result != 0)
+    {
+        throw std::system_error(error, std::generic_category(), "sync CA storage");
+    }
+}
+
+void syncAuthorityDirectory(const fs::path& directory)
+{
+    for (const auto& entry : fs::directory_iterator(directory))
+    {
+        if (!fs::is_symlink(entry) && fs::is_regular_file(entry))
+        {
+            syncAuthorityPath(entry, false);
+        }
+    }
+    syncAuthorityPath(directory, true);
+}
+
+void validateAuthorityDirectory(const fs::path& directory)
+{
+    const fs::path list = directory / defaultAuthoritiesListFileName;
+    if (fs::exists(list))
+    {
+        checkAuthorityListSize(list);
+        const auto authorities = splitCertificates(list);
+        if (authorities.empty() || authorities.size() > maxNumAuthorityCertificates)
+        {
+            elog<InvalidCertificate>(InvalidCertificateReason("Invalid CA bundle count"));
+        }
+        auto store = getX509Store(list);
+        for (const auto& pem : authorities)
+        {
+            if (pem.size() >= 32 * 1024)
+            {
+                elog<InvalidCertificate>(InvalidCertificateReason("CA exceeds size limit"));
+            }
+            auto certificate = parseCert(pem);
+            validateCertificateAgainstStore(*store, *certificate);
+            validateCertificateStartDate(*certificate);
+            validateCertificateInSSLContext(*certificate);
+        }
+        return;
+    }
+    size_t count = 0;
+    for (const auto& entry : fs::directory_iterator(directory))
+    {
+        if (fs::is_symlink(entry) || !fs::is_regular_file(entry))
+        {
+            continue;
+        }
+        if (++count > maxNumAuthorityCertificates ||
+            fs::file_size(entry) == 0 || fs::file_size(entry) > 32 * 1024)
+        {
+            elog<InvalidCertificate>(InvalidCertificateReason("Invalid CA storage size"));
+        }
+        auto store = getX509Store(entry.path());
+        auto certificate = loadCert(entry.path());
+        validateCertificateAgainstStore(*store, *certificate);
+        validateCertificateStartDate(*certificate);
+        validateCertificateInSSLContext(*certificate);
+    }
+    if (count == 0)
+    {
+        elog<InvalidCertificate>(InvalidCertificateReason("CA storage is empty"));
+    }
+}
+
