From: CEB-GNRD maintainers <bmc@example.com>
Subject: [PATCH] pid: quiet transient telemetry logs and report zone transitions once

Allow 60 seconds for telemetry after daemon startup and each observed
host-state change. Suppress only transient availability diagnostics;
critical/threshold diagnostics remain immediate and persistent failures
are reported after the interval. Keep all failure detection and PWM
control active. Replace misleading missing text with the actual reason
and remove per-fan copies of the zone transition message.

Upstream-Status: Inappropriate [CEB-GNRD board policy]

diff --git a/hoststatemonitor.hpp b/hoststatemonitor.hpp
--- a/hoststatemonitor.hpp
+++ b/hoststatemonitor.hpp
@@ -6,6 +6,7 @@
 #include <sdbusplus/message.hpp>
 #include <xyz/openbmc_project/State/Host/common.hpp>
 
+#include <chrono>
 #include <functional>
 #include <iostream>
 #include <memory>
@@ -46,7 +47,29 @@
         return powerStatusOff;
     }
 
+    // Only diagnostics wait for host-powered telemetry to settle. Fan
+    // failure checks, protection demand and PWM output remain active.
+    bool sensorLogsSettling() const
+    {
+        return std::chrono::steady_clock::now() < sensorLogDeadline;
+    }
+
   private:
+    void recordState(const std::string& stateValue)
+    {
+        if (stateValue != lastHostState)
+        {
+            lastHostState = stateValue;
+            sensorLogDeadline = std::chrono::steady_clock::now() +
+                                std::chrono::seconds(60);
+        }
+        powerStatusOn = stateValue.ends_with(".Running");
+        powerStatusOff = stateValue.ends_with(".Off");
+    }
+
+    std::string lastHostState;
+    std::chrono::steady_clock::time_point sensorLogDeadline =
+        std::chrono::steady_clock::now() + std::chrono::seconds(60);
     explicit HostStateMonitor(sdbusplus::bus_t& bus);
 
     void handleStateChange(sdbusplus::message_t& message);
@@ -115,13 +138,7 @@
         {
             const std::string& stateValue =
                 std::get<std::string>(findState->second);
-            bool newPowerStatus = stateValue.ends_with(".Running");
-            powerStatusOff = stateValue.ends_with(".Off");
-
-            if (newPowerStatus != powerStatusOn)
-            {
-                powerStatusOn = newPowerStatus;
-            }
+            recordState(stateValue);
         }
     }
     catch (const std::exception& e)
@@ -145,8 +162,7 @@
         auto currentState = reply.unpack<std::variant<std::string>>();
 
         const std::string& stateValue = std::get<std::string>(currentState);
-        powerStatusOn = stateValue.ends_with(".Running");
-        powerStatusOff = stateValue.ends_with(".Off");
+        recordState(stateValue);
     }
     catch (const std::exception& e)
     {
