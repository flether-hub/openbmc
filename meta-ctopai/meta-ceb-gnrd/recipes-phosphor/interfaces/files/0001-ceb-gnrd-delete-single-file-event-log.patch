From: CEB-GNRD platform <ceb-gnrd@localhost>
Subject: [PATCH] eventlog: support single file-entry deletion without shifting IDs

Upstream-Status: Inappropriate [CEB-GNRD file event log policy]

diff --git a/redfish-core/include/utils/eventlog_utils.hpp b/redfish-core/include/utils/eventlog_utils.hpp
--- a/redfish-core/include/utils/eventlog_utils.hpp
+++ b/redfish-core/include/utils/eventlog_utils.hpp
@@ -24,6 +24,8 @@
 #include "utils/time_utils.hpp"
 
 #include <asm-generic/errno.h>
+#include <fcntl.h>
+#include <unistd.h>
 
 #include <boost/beast/http/status.hpp>
 #include <boost/url/format.hpp>
@@ -190,6 +192,92 @@
     std::ranges::sort(redfishLogFiles);
 
     return !redfishLogFiles.empty();
+}
+
+
+// Reserve the original timestamp/ordinal after deletion so other entry IDs
+// do not move. The message/arguments are overwritten in place, not hidden in
+// a browser cache; rsyslog's inode, append offset and file size stay unchanged.
+inline bool isDeletedFileEvent(const std::string& line)
+{
+    size_t space = line.find(' ');
+    return space != std::string::npos &&
+           std::string_view(line).substr(space + 1).starts_with("#DEL");
+}
+
+inline void deleteFileEvent(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& targetID)
+{
+    std::vector<std::filesystem::path> files;
+    getRedfishLogFiles(files);
+    event_log::UniqueEntryIDState state;
+    for (auto it = files.rbegin(); it != files.rend(); ++it)
+    {
+        int fd = open(it->c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+        if (fd < 0)
+        {
+            messages::internalError(asyncResp->res);
+            return;
+        }
+        FILE* raw = fdopen(fd, "r+");
+        if (raw == nullptr)
+        {
+            close(fd);
+            messages::internalError(asyncResp->res);
+            return;
+        }
+        auto closeFile = [](FILE* file) { static_cast<void>(fclose(file)); };
+        std::unique_ptr<FILE, decltype(closeFile)> stream(raw, closeFile);
+        while (true)
+        {
+            off_t offset = ftello(raw);
+            std::string line;
+            int ch = 0;
+            while ((ch = fgetc(raw)) != EOF && ch != '\n')
+            {
+                line.push_back(static_cast<char>(ch));
+            }
+            if (ferror(raw) != 0 || offset < 0)
+            {
+                messages::internalError(asyncResp->res);
+                return;
+            }
+            // Only complete records can be deleted. An append in progress is
+            // left untouched; the caller can retry when it becomes visible.
+            if (ch == EOF)
+            {
+                break;
+            }
+            std::string id;
+            if (!event_log::getUniqueEntryID(state, line, id) || id != targetID)
+            {
+                continue;
+            }
+            if (isDeletedFileEvent(line))
+            {
+                break;
+            }
+            size_t space = line.find(' ');
+            if (space == std::string::npos || line.size() - space - 1 < 4)
+            {
+                messages::internalError(asyncResp->res);
+                return;
+            }
+            std::string blank(line.size() - space - 1, ' ');
+            blank.replace(0, 4, "#DEL");
+            if (fseeko(raw, offset + static_cast<off_t>(space + 1), SEEK_SET) != 0 ||
+                fwrite(blank.data(), 1, blank.size(), raw) != blank.size() ||
+                fflush(raw) != 0 || fsync(fd) != 0)
+            {
+                messages::internalError(asyncResp->res);
+                return;
+            }
+            asyncResp->res.result(boost::beast::http::status::no_content);
+            return;
+        }
+    }
+    messages::resourceNotFound(asyncResp->res, "LogEntry", targetID);
 }
 
