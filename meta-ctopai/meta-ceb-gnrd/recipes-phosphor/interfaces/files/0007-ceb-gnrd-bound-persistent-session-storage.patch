From: CEB-GNRD platform <ceb-gnrd@localhost>
Subject: [PATCH] bound persistent sessions and event subscription payloads

Upstream-Status: Inappropriate [CEB-GNRD persistent storage budget]

Limit persistent sessions to 64 and session Context to 256 bytes. Basic and
mutual TLS transient authentication are not limited by persistent capacity.
Apply the same constraints when restoring old sessions and handle rejection
in Web login before dereferencing the returned session. Bound event creation
and update payloads to 16 KiB; firmware uploads retain their existing limit.

--- a/include/sessions.hpp
+++ b/include/sessions.hpp
@@ -261,11 +261,38 @@
 class SessionStore
 {
   public:
+    static constexpr std::size_t maxPersistentSessions = 64;
+    static constexpr std::size_t maxSessionContextSize = 256;
+
+    bool hasPersistentSessionCapacity() const
+    {
+        std::size_t count = 0;
+        for (const auto& entry : authTokens)
+        {
+            const auto& session = entry.second;
+            if (session->sessionType != SessionType::Basic &&
+                session->sessionType != SessionType::MutualTLS)
+            {
+                ++count;
+            }
+        }
+        return count < maxPersistentSessions;
+    }
+
     std::shared_ptr<UserSession> generateUserSession(
         std::string_view username, const boost::asio::ip::address& clientIp,
         const std::optional<std::string>& clientId, SessionType sessionType,
         bool isConfigureSelfOnly = false)
     {
+        applySessionTimeouts();
+        if ((clientId && clientId->size() > maxSessionContextSize) ||
+            ((sessionType != SessionType::Basic &&
+              sessionType != SessionType::MutualTLS) &&
+             !hasPersistentSessionCapacity()))
+        {
+            BMCWEB_LOG_WARNING("Persistent session storage limit reached");
+            return nullptr;
+        }
         // Only need csrf tokens for cookie based auth, token doesn't matter
         std::string sessionToken =
             bmcweb::getRandomIdOfLength(sessionTokenSize);
