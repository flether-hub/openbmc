From: CEB-GNRD maintainers <bmc@example.com>
Subject: [PATCH] apphandler: expose CEB-GNRD PCB revision in mc info AUX byte

Sample the board revision straps by their device-tree GPIO line names. Keep
the existing AUX firmware revision bytes intact and place the three-bit PCB
revision in the final AUX byte.

Upstream-Status: Inappropriate [CEB-GNRD board-specific behavior]
---
 apphandler.cpp | 75 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 75 insertions(+)

--- a/apphandler.cpp
+++ b/apphandler.cpp
@@ -3,6 +3,7 @@
 #include <arpa/inet.h>
 #include <fcntl.h>
 #include <limits.h>
+#include <gpiod.h>
 #include <linux/i2c-dev.h>
 #include <linux/i2c.h>
 #include <sys/ioctl.h>
@@ -37,6 +38,7 @@
 #include <filesystem>
 #include <fstream>
 #include <memory>
+#include <optional>
 #include <regex>
 #include <string>
 #include <string_view>
@@ -62,6 +64,78 @@
 using BMCState = sdbusplus::server::xyz::openbmc_project::state::BMC;
 namespace fs = std::filesystem;
 
+/* Return nullopt when the board straps cannot be sampled. This must not make
+ * the standard Get Device ID command unavailable. */
+static std::optional<uint8_t> getCebGnrdBoardRevision()
+{
+    constexpr std::array<const char*, 3> names = {
+        "PCB_VER0", "PCB_VER1", "PCB_VER2"};
+    std::error_code ec;
+    for (const auto& entry : fs::directory_iterator("/dev", ec))
+    {
+        if (ec)
+        {
+            return std::nullopt;
+        }
+        const std::string path = entry.path().string();
+        if (entry.path().filename().string().rfind("gpiochip", 0) != 0)
+        {
+            continue;
+        }
+
+        std::unique_ptr<gpiod_chip, decltype(&gpiod_chip_close)> chip(
+            gpiod_chip_open(path.c_str()), gpiod_chip_close);
+        if (!chip)
+        {
+            continue;
+        }
+
+        std::array<gpiod_line*, names.size()> lines{};
+        bool foundAll = true;
+        for (size_t i = 0; i < names.size(); ++i)
+        {
+            lines[i] = gpiod_chip_find_line(chip.get(), names[i]);
+            if (lines[i] == nullptr)
+            {
+                foundAll = false;
+                break;
+            }
+        }
+        if (!foundAll)
+        {
+            continue;
+        }
+
+        uint8_t revision = 0;
+        for (size_t bit = 0; bit < lines.size(); ++bit)
+        {
+            if (gpiod_line_request_input(lines[bit], "ceb-gnrd-mc-info") < 0)
+            {
+                return std::nullopt;
+            }
+            const int value = gpiod_line_get_value(lines[bit]);
+            gpiod_line_release(lines[bit]);
+            if (value < 0)
+            {
+                return std::nullopt;
+            }
+            revision |= static_cast<uint8_t>(value) << bit;
+        }
+        return revision;
+    }
+    return std::nullopt;
+}
+
+static uint32_t cebGnrdAux(uint32_t aux)
+{
+    if (const auto revision = getCebGnrdBoardRevision())
+    {
+        // AUX is returned little-endian; bits 31:24 are its fourth byte.
+        aux = (aux & 0x00ffffffU) | (static_cast<uint32_t>(*revision) << 24);
+    }
+    return aux;
+}
+
 #ifdef ENABLE_I2C_WHITELIST_CHECK
 typedef struct
 {
