From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Fri, 2 Oct 2026 00:00:00 +0000
Subject: [PATCH] fru: add an interactive gen command

'ipmitool fru gen [file]' asks, field by field, for the contents of the chassis,
board and product info areas (each prompt shows the format and a board
default) and writes the FRU image (default fru.bin). Serial defaults share
the generation date in UTC (YYMMDD) and the editable sequence 0001.

Upstream-Status: Inappropriate [CEB-GNRD board-specific helper]
---
 lib/ipmi_fru.c | 0
 1 file changed

--- a/lib/ipmi_fru.c
+++ b/lib/ipmi_fru.c
@@ -4414,7 +4414,7 @@
 ipmi_fru_help()
 {
 	lprintf(LOG_NOTICE,
+			"FRU Commands:  print read write upgEkey edit internaluse get gen");
-			"FRU Commands:  print read write upgEkey edit internaluse get");
 } /* ipmi_fru_help() */
 
 /* ipmi_fru_read_internal_use -  print internal use are in hex or file
@@ -4576,6 +4576,504 @@
 	return 0;
 }
 
+/* ---- "fru gen": interactive generation of a FRU image ---- */
+
+#include <stdio.h>
+#include <unistd.h>
+#include <termios.h>
+#include <time.h>
+
+/* worst case: product area, 3 + 7 fields of 64 bytes + end marker + padding */
+#define FRU_GEN_AREA_MAX    512
+#define FRU_GEN_FIELD_MAX   63
+
+/* fru_gen_read_line - read one line from stdin without the line ending
+ *
+ * returns -1 at end of input (the buffer is then empty), 0 otherwise
+ */
+static int
+fru_gen_read_line(char *buf, size_t size)
+{
+	size_t len;
+	int c;
+
+	if (fgets(buf, (int)size, stdin) == NULL) {
+		buf[0] = '\0';
+		return -1;
+	}
+	len = strlen(buf);
+	if (len > 0 && buf[len - 1] == '\n') {
+		buf[--len] = '\0';
+	} else {
+		/* the line was longer than the buffer: drop the rest of it */
+		while ((c = getchar()) != '\n' && c != EOF) {
+			;
+		}
+	}
+	if (len > 0 && buf[len - 1] == '\r') {
+		buf[--len] = '\0';
+	}
+	return 0;
+}
+
+/* fru_gen_input - read the value of one prompt with the default already in
+ *                  the input line, so that it can be edited (Backspace, Ctrl-U);
+ *                  Enter accepts the line.  Without a terminal a line is read
+ *                  as it is: an empty line keeps the default, "-" is empty.
+ *
+ * returns -1 at end of input (the default is returned), 0 otherwise
+ */
+static int
+fru_gen_input(const char *def, char *buf, size_t size)
+{
+	struct termios old;
+	struct termios raw;
+	size_t len;
+	int esc = 0;
+	unsigned char c;
+
+	if (!isatty(STDIN_FILENO) || tcgetattr(STDIN_FILENO, &old) != 0) {
+		if (fru_gen_read_line(buf, size) != 0) {
+			snprintf(buf, size, "%s", def);
+			return -1;
+		}
+		if (buf[0] == '\0') {
+			snprintf(buf, size, "%s", def);
+		} else if (strcmp(buf, "-") == 0) {
+			buf[0] = '\0';
+		}
+		return 0;
+	}
+
+	raw = old;
+	raw.c_lflag &= ~(ICANON | ECHO | ISIG);
+	raw.c_cc[VMIN] = 1;
+	raw.c_cc[VTIME] = 0;
+	tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+
+	snprintf(buf, size, "%s", def);
+	len = strlen(buf);
+	fputs(buf, stdout);
+	fflush(stdout);
+	for (;;) {
+		if (read(STDIN_FILENO, &c, 1) != 1 || c == '\r' || c == '\n') {
+			break;
+		}
+		if (esc) {
+			/* swallow an escape sequence (cursor keys and the like) */
+			if (esc == 1) {
+				esc = (c == '[' || c == 'O') ? 2 : 0;
+			} else if (c >= 0x40 && c <= 0x7e) {
+				esc = 0;
+			}
+			continue;
+		}
+		if (c == 0x1b) {
+			esc = 1;
+		} else if (c == 0x03) {
+			/* Ctrl-C: give the terminal back and stop */
+			tcsetattr(STDIN_FILENO, TCSANOW, &old);
+			putchar('\n');
+			exit(1);
+		} else if (c == 0x7f || c == 0x08) {
+			if (len > 0) {
+				buf[--len] = '\0';
+				fputs("\b \b", stdout);
+			}
+		} else if (c == 0x15) {
+			while (len > 0) {
+				buf[--len] = '\0';
+				fputs("\b \b", stdout);
+			}
+		} else if (c >= 0x20 && c <= 0x7e && len + 1 < size) {
+			buf[len++] = (char)c;
+			buf[len] = '\0';
+			putchar(c);
+		}
+		fflush(stdout);
+	}
+	tcsetattr(STDIN_FILENO, TCSANOW, &old);
+	putchar('\n');
+	return 0;
+}
+
+/* fru_gen_show_default - end of a prompt: the input line follows.  On a
+ *                        terminal the default is in the line itself, otherwise
+ *                        it is shown here.
+ */
+static void
+fru_gen_show_default(const char *def)
+{
+	if (!isatty(STDIN_FILENO)) {
+		printf("    default: %s\n", def[0] != '\0' ? def : "(empty)");
+	}
+	printf("    > ");
+	fflush(stdout);
+}
+
+/* fru_gen_ask_text - ask for one text field, the default is in the input line
+ *                    and can be edited
+ */
+static void
+fru_gen_ask_text(const char *label, const char *hint, const char *def,
+				 char *out)
+{
+	char line[256];
+	char prev[256];
+	const char *cur = def;
+	size_t i;
+	size_t len;
+	int ok;
+
+	for (;;) {
+		printf("%s\n    format : %s\n", label, hint);
+		fru_gen_show_default(cur);
+		fru_gen_input(cur, line, sizeof(line));
+		len = strlen(line);
+		ok = (len <= FRU_GEN_FIELD_MAX);
+		for (i = 0; ok && i < len; i++) {
+			if ((unsigned char)line[i] < 0x20 || (unsigned char)line[i] > 0x7e) {
+				ok = 0;
+			}
+		}
+		if (ok) {
+			memcpy(out, line, len + 1);
+			return;
+		}
+		printf("    invalid: printable ASCII only, at most %d characters\n",
+			   FRU_GEN_FIELD_MAX);
+		memcpy(prev, line, sizeof(prev));
+		cur = prev;
+	}
+}
+
+static uint8_t
+fru_gen_ask_chassis_type(void)
+{
+	char line[64];
+	char *end;
+	unsigned long v;
+
+	for (;;) {
+		printf("Chassis type\n"
+			   "    format : a number, decimal or 0x-hex (SMBIOS chassis type)\n"
+			   "             0x01 other, 0x03 desktop, 0x07 tower,\n"
+			   "             0x11 main server chassis, 0x17 rack mount chassis\n");
+		fru_gen_show_default("0x17");
+		fru_gen_input("0x17", line, sizeof(line));
+		v = strtoul(line, &end, 0);
+		if (end != line && *end == '\0' && v <= 0xFF) {
+			return (uint8_t)v;
+		}
+		printf("    invalid: enter a number from 0 to 255, for example 0x17\n");
+	}
+}
+
+/* days since 1970-01-01 of a calendar date (proleptic Gregorian) */
+static long
+fru_gen_days(int y, int m, int d)
+{
+	long era;
+	long yoe;
+	long doy;
+	long doe;
+
+	y -= (m <= 2);
+	era = (y >= 0 ? y : y - 399) / 400;
+	yoe = y - era * 400;
+	doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+/* default board manufacturing date */
+#define FRU_GEN_DEF_DATE    "2026-10-01"
+
+/* returns the board manufacturing time in minutes since 1996-01-01 00:00 UTC,
+ * 0 means unspecified (an empty input) */
+static uint32_t
+fru_gen_ask_date(void)
+{
+	char line[64];
+	char prev[64];
+	const char *cur = FRU_GEN_DEF_DATE;
+	int y, mo, d, h, mi, n;
+	long minutes;
+
+	for (;;) {
+		h = 0;
+		mi = 0;
+		printf("Board manufacturing date and time (UTC)\n"
+			   "    format : YYYY-MM-DD or YYYY-MM-DD HH:MM, year 1996 or later,\n"
+			   "             or empty for unspecified\n");
+		fru_gen_show_default(cur);
+		fru_gen_input(cur, line, sizeof(line));
+		if (line[0] == '\0') {
+			return 0;
+		}
+		n = sscanf(line, "%d-%d-%d %d:%d", &y, &mo, &d, &h, &mi);
+		if ((n == 3 || n == 5) && y >= 1996 && y <= 2200 && mo >= 1
+			&& mo <= 12 && d >= 1 && d <= 31 && h >= 0 && h <= 23
+			&& mi >= 0 && mi <= 59) {
+			minutes = (fru_gen_days(y, mo, d) - fru_gen_days(1996, 1, 1))
+					  * 1440L + h * 60 + mi;
+			if (minutes >= 0 && minutes < 0x1000000L) {
+				return (uint32_t)minutes;
+			}
+		}
+		printf("    invalid: use YYYY-MM-DD or YYYY-MM-DD HH:MM (year 1996 or later)\n");
+		memcpy(prev, line, sizeof(prev));
+		cur = prev;
+	}
+}
+
+/* fru_gen_add_field - append one type/length encoded field (8-bit ASCII)
+ *
+ * returns the new number of used bytes
+ */
+static size_t
+fru_gen_add_field(uint8_t *area, size_t used, const char *str)
+{
+	size_t len = strlen(str);
+
+	if (len > FRU_GEN_FIELD_MAX) {
+		len = FRU_GEN_FIELD_MAX;
+	}
+	if (len == 1) {
+		/* type/length 0xC1 is the end-of-fields marker, so a one character
+		 * value cannot be stored as it is: pad it with a space (readers strip
+		 * trailing spaces) */
+		area[used++] = 0xC0 | 2;
+		area[used++] = (uint8_t)str[0];
+		area[used++] = ' ';
+		return used;
+	}
+	/* type 11b (8-bit ASCII) in the top two bits, length in the low six */
+	area[used++] = (uint8_t)(0xC0 | len);
+	memcpy(area + used, str, len);
+	return used + len;
+}
+
+/* fru_gen_end_area - terminate an info area: end-of-fields marker, padding to
+ *                    a multiple of 8 bytes, area length byte and checksum
+ *
+ * returns the total size of the area in bytes
+ */
+static size_t
+fru_gen_end_area(uint8_t *area, size_t used)
+{
+	size_t total;
+	size_t i;
+	uint8_t sum = 0;
+
+	area[used++] = 0xC1;    /* end of fields */
+	total = (used + 1 + 7) & ~(size_t)7;    /* room for the checksum byte */
+	while (used < total - 1) {
+		area[used++] = 0;
+	}
+	area[1] = (uint8_t)(total / 8);
+	for (i = 0; i < total - 1; i++) {
+		sum += area[i];
+	}
+	area[total - 1] = (uint8_t)(0x100 - sum);
+	return total;
+}
+
+static size_t
+fru_gen_chassis_area(uint8_t *area, const char *serial)
+{
+	char text[FRU_GEN_FIELD_MAX + 1];
+	size_t used = 0;
+
+	printf("\n=== Chassis info area (1 of 3) ===\n\n");
+	area[used++] = 0x01;    /* format version */
+	area[used++] = 0;       /* length, set in fru_gen_end_area() */
+	area[used++] = fru_gen_ask_chassis_type();
+	fru_gen_ask_text("Chassis part number",
+					 "text, printable ASCII, up to 63 characters",
+					 "93-XXXXX-XX", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Chassis serial number",
+					 "YYMMDD####; UTC date plus editable sequence (default 0001)",
+					 serial, text);
+	used = fru_gen_add_field(area, used, text);
+	return fru_gen_end_area(area, used);
+}
+
+static size_t
+fru_gen_board_area(uint8_t *area, const char *serial)
+{
+	char text[FRU_GEN_FIELD_MAX + 1];
+	uint32_t date;
+	size_t used = 0;
+
+	printf("\n=== Board info area (2 of 3) ===\n\n");
+	area[used++] = 0x01;    /* format version */
+	area[used++] = 0;       /* length, set in fru_gen_end_area() */
+	area[used++] = 0;       /* language code: English */
+	date = fru_gen_ask_date();
+	area[used++] = (uint8_t)(date & 0xFF);          /* little endian */
+	area[used++] = (uint8_t)((date >> 8) & 0xFF);
+	area[used++] = (uint8_t)((date >> 16) & 0xFF);
+	fru_gen_ask_text("Board manufacturer",
+					 "text, printable ASCII, up to 63 characters",
+					 "CTOPAI", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Board product name",
+					 "text, printable ASCII, up to 63 characters",
+					 "CEB-GNR-D", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Board serial number",
+					 "YYMMDD####; UTC date plus editable sequence (default 0001)",
+					 serial, text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Board part number",
+					 "text, printable ASCII, up to 63 characters",
+					 "91-39380-A0", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Board FRU file ID",
+					 "text, printable ASCII, up to 63 characters",
+					 "0", text);
+	used = fru_gen_add_field(area, used, text);
+	return fru_gen_end_area(area, used);
+}
+
+static size_t
+fru_gen_product_area(uint8_t *area, const char *serial)
+{
+	char text[FRU_GEN_FIELD_MAX + 1];
+	size_t used = 0;
+
+	printf("\n=== Product info area (3 of 3) ===\n\n");
+	area[used++] = 0x01;    /* format version */
+	area[used++] = 0;       /* length, set in fru_gen_end_area() */
+	area[used++] = 0;       /* language code: English */
+	fru_gen_ask_text("Product manufacturer",
+					 "text, printable ASCII, up to 63 characters",
+					 "CTOPAI", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Product name",
+					 "text, printable ASCII, up to 63 characters",
+					 "CEB-GNR-D", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Product part or model number",
+					 "text, printable ASCII, up to 63 characters",
+					 "81-XXXXX-XX", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Product version",
+					 "text, printable ASCII, up to 63 characters, for example V1.0",
+					 "v1.0", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Product serial number",
+					 "YYMMDD####; UTC date plus editable sequence (default 0001)",
+					 serial, text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Product asset tag",
+					 "text, printable ASCII, up to 63 characters",
+					 "Xeon6-SOC", text);
+	used = fru_gen_add_field(area, used, text);
+	fru_gen_ask_text("Product FRU file ID",
+					 "text, printable ASCII, up to 63 characters",
+					 "0", text);
+	used = fru_gen_add_field(area, used, text);
+	return fru_gen_end_area(area, used);
+}
+
+static void
+ipmi_fru_gen_help(void)
+{
+	lprintf(LOG_NOTICE,
+			"fru gen [file] - interactively create a FRU image (default file:\n"
+			"                 fru.bin) with chassis, board and product info\n"
+			"                 areas.  Every field is explained and has a\n"
+			"                 default, which is in the input line: edit it, or\n"
+			"                 press Enter to keep it (without a terminal Enter\n"
+			"                 keeps the default and - gives an empty field).\n"
+			"                 Write the result with 'fru write <id> <file>'.");
+}
+
+/* ipmi_fru_gen - ask for the contents of the chassis, board and product info
+ *                areas and write the FRU image
+ *
+ * @filename: output file
+ *
+ * returns -1 on error
+ * returns 0 if successful
+ */
+static int
+ipmi_fru_gen(const char *filename)
+{
+	uint8_t chassis[FRU_GEN_AREA_MAX];
+	uint8_t board[FRU_GEN_AREA_MAX];
+	uint8_t product[FRU_GEN_AREA_MAX];
+	uint8_t hdr[8];
+	uint8_t sum = 0;
+	size_t clen;
+	size_t blen;
+	size_t plen;
+	size_t total;
+	size_t i;
+	FILE *fp;
+	char serial[11];
+	time_t now;
+	struct tm *utc;
+
+	/* One date per image: all three areas use the same editable serial. */
+	now = time(NULL);
+	utc = now == (time_t)-1 ? NULL : gmtime(&now);
+	if (utc == NULL || strftime(serial, sizeof(serial), "%y%m%d0001", utc) == 0) {
+		lprintf(LOG_ERR, "Cannot determine UTC date for default FRU serial");
+		return -1;
+	}
+
+	printf("Creating FRU image %s.\n"
+		   "The default of each field is in the input line: edit it with\n"
+		   "Backspace and type, or press Enter to keep it.\n",
+		   filename);
+	clen = fru_gen_chassis_area(chassis, serial);
+	blen = fru_gen_board_area(board, serial);
+	plen = fru_gen_product_area(product, serial);
+
+	memset(hdr, 0, sizeof(hdr));
+	hdr[0] = 0x01;                                  /* format version */
+	hdr[2] = 1;                                     /* chassis area offset */
+	hdr[3] = (uint8_t)(1 + clen / 8);               /* board area offset */
+	hdr[4] = (uint8_t)(1 + (clen + blen) / 8);      /* product area offset */
+	for (i = 0; i < 7; i++) {
+		sum += hdr[i];
+	}
+	hdr[7] = (uint8_t)(0x100 - sum);
+	total = sizeof(hdr) + clen + blen + plen;
+
+	fp = fopen(filename, "wb");
+	if (fp == NULL) {
+		lprintf(LOG_ERR, "Cannot open %s for writing: %s",
+				filename, strerror(errno));
+		return -1;
+	}
+	if (fwrite(hdr, 1, sizeof(hdr), fp) != sizeof(hdr)
+		|| fwrite(chassis, 1, clen, fp) != clen
+		|| fwrite(board, 1, blen, fp) != blen
+		|| fwrite(product, 1, plen, fp) != plen) {
+		lprintf(LOG_ERR, "Cannot write %s: %s", filename, strerror(errno));
+		fclose(fp);
+		return -1;
+	}
+	if (fclose(fp) != 0) {
+		lprintf(LOG_ERR, "Cannot write %s: %s", filename, strerror(errno));
+		return -1;
+	}
+
+	printf("\nWrote %s: %u bytes (chassis at 0x%x, board at 0x%x, product at 0x%x).\n"
+		   "Write it to the BMC FRU with: ipmitool fru write 0 %s\n",
+		   filename, (unsigned int)total, (unsigned int)(hdr[2] * 8),
+		   (unsigned int)(hdr[3] * 8), (unsigned int)(hdr[4] * 8), filename);
+	if (total > 1024) {
+		printf("Note: the image is larger than 1 KiB, the size of the FRU EEPROM "
+			   "on this board.\n");
+	}
+	return 0;
+}
 int
 ipmi_fru_main(struct ipmi_intf * intf, int argc, char ** argv)
 {
@@ -4801,6 +5299,13 @@
 			rc = ipmi_fru_get_multirec(intf, fru_id, argc, argv);
 		}
 	}
+	else if (!strcmp(argv[0], "gen")) {
+		if (argc > 1 && !strcmp(argv[1], "help")) {
+			ipmi_fru_gen_help();
+			return 0;
+		}
+		rc = ipmi_fru_gen(argc > 1 ? argv[1] : "fru.bin");
+	}
 	else {
 		lprintf(LOG_ERR, "Invalid FRU command: %s", argv[0]);
 		ipmi_fru_help();
