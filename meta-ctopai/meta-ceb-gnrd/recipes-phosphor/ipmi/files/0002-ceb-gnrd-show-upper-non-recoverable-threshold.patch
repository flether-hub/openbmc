From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Fri, 2 Oct 2026 00:00:00 +0000
Subject: [PATCH] sensors: show the upper non-recoverable threshold

Read NonRecoverableHigh from the private
com.ctopai.CebGnrd.Threshold.NonRecoverable interface and report it as
the upper non-recoverable threshold (Get Sensor Thresholds and the SDR
record).  The standard HardShutdown interface is deliberately not used: other
services turn it into an automatic power off.

Upstream-Status: Inappropriate [CEB-GNRD board-specific policy]
---
 include/dbus-sdr/sensorcommands.hpp | 1 +
 dbus-sdr/sensorcommands.cpp         | 41 +++++++++++++++++++++++++++++++++++
 2 files changed, 42 insertions(+)

diff --git a/include/dbus-sdr/sensorcommands.hpp b/include/dbus-sdr/sensorcommands.hpp
--- a/include/dbus-sdr/sensorcommands.hpp
+++ b/include/dbus-sdr/sensorcommands.hpp
@@ -119,6 +119,7 @@
     std::optional<uint8_t> warningHigh;
     std::optional<uint8_t> criticalLow;
     std::optional<uint8_t> criticalHigh;
+    std::optional<uint8_t> nonRecoverableHigh;
 };
 
 namespace sensor
diff --git a/dbus-sdr/sensorcommands.cpp b/dbus-sdr/sensorcommands.cpp
--- a/dbus-sdr/sensorcommands.cpp
+++ b/dbus-sdr/sensorcommands.cpp
@@ -1368,6 +1368,29 @@
                 }
             }
         }
+
+        // Board specific: the upper non-recoverable threshold is published
+        // on a private interface, so that nothing acts on it (it is shown
+        // and logged only; it must never shut the system down).
+        auto nonRecoverableInterface = sensorMap.find(
+            "com.ctopai.CebGnrd.Threshold.NonRecoverable");
+        if (nonRecoverableInterface != sensorMap.end())
+        {
+            auto& nonRecoverableMap = nonRecoverableInterface->second;
+            auto nonRecoverableHigh =
+                nonRecoverableMap.find("NonRecoverableHigh");
+
+            if (nonRecoverableHigh != nonRecoverableMap.end())
+            {
+                double value = std::visit(VariantToDoubleVisitor(),
+                                          nonRecoverableHigh->second);
+                if (std::isfinite(value))
+                {
+                    resp.nonRecoverableHigh = scaleIPMIValueFromDouble(
+                        value, mValue, rExp, bValue, bExp, bSigned);
+                }
+            }
+        }
     }
     return resp;
 }
@@ -1444,6 +1467,12 @@
             1 << static_cast<uint8_t>(IPMIThresholdRespBits::lowerCritical);
         lowerCritical = *thresholdData.criticalLow;
     }
+    if (thresholdData.nonRecoverableHigh)
+    {
+        readable |= 1 << static_cast<uint8_t>(
+                        IPMIThresholdRespBits::upperNonRecoverable);
+        upperNonRecoverable = *thresholdData.nonRecoverableHigh;
+    }
 
     return ipmi::responseSuccess(readable, lowerNC, lowerCritical,
                                  lowerNonRecoverable, upperNC, upperCritical,
@@ -1980,6 +2009,13 @@
         record.body.discreteReadingSettingMask[0] |=
             static_cast<uint8_t>(IPMISensorReadingByte3::upperCritical);
     }
+    if (thresholdData.nonRecoverableHigh)
+    {
+        record.body.upperNonrecoverableThreshold =
+            *thresholdData.nonRecoverableHigh;
+        record.body.discreteReadingSettingMask[0] |= static_cast<uint8_t>(
+            IPMISensorReadingByte3::upperNonRecoverable);
+    }
     if (thresholdData.warningHigh)
     {
         record.body.upperNoncriticalThreshold = *thresholdData.warningHigh;
