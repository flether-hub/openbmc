From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] storagecommands: FRU commands go through FruDevice, with the whole EEPROM as FRU area

Get FRU Inventory Area Info returned the length of the stored FRU image, so
'ipmitool fru write' truncated any larger image to that length.  Report the
size of the EEPROM (from sysfs) and pad the image read from fru-device with
0xFF up to it.

The phosphor-ipmi-fru handlers register the same three FRU commands at the
same priority, and the one registered last wins (library load order); Write
FRU Data was handled by them, keeping the data in /tmp and never reaching
FruDevice.  Register these handlers at prioOemBase.

Upstream-Status: Inappropriate [CEB-GNRD board-specific]
---
diff --git a/dbus-sdr/storagecommands.cpp b/dbus-sdr/storagecommands.cpp
index 6de099c..e339452 100644
--- a/dbus-sdr/storagecommands.cpp
+++ b/dbus-sdr/storagecommands.cpp
@@ -31,6 +31,8 @@
 #include <sdbusplus/timer.hpp>
 #include <xyz/openbmc_project/ObjectMapper/common.hpp>
 
+#include <array>
+#include <cstdio>
 #include <filesystem>
 #include <fstream>
 #include <functional>
@@ -233,6 +235,18 @@ void replaceCacheFru(
     recalculateHashes();
 }
 
+// Size of the EEPROM behind a FRU device, 0 if it has no eeprom file.  The FRU
+// inventory area is the whole EEPROM, not only the part holding the image.
+static size_t getEepromSize(uint16_t bus, uint8_t addr)
+{
+    std::array<char, 64> path{};
+    std::snprintf(path.data(), path.size(), "/sys/bus/i2c/devices/%u-%04x/eeprom",
+                  static_cast<unsigned>(bus), static_cast<unsigned>(addr));
+    std::error_code ec;
+    auto size = std::filesystem::file_size(path.data(), ec);
+    return ec ? 0 : static_cast<size_t>(size);
+}
+
 std::pair<ipmi::Cc, std::vector<uint8_t>> getFru(ipmi::Context::ptr ctx,
                                                  uint8_t devId)
 {
@@ -265,6 +279,15 @@ std::pair<ipmi::Cc, std::vector<uint8_t>> getFru(ipmi::Context::ptr ctx,
         return {ipmi::ccResponseError, {}};
     }
 
+    // Report the whole EEPROM as the FRU inventory area, so that a FRU image
+    // larger than the stored one can be written (ipmitool never writes more than
+    // the reported size).
+    size_t eepromSize = getEepromSize(cacheBus, cacheAddr);
+    if (fru.size() < eepromSize)
+    {
+        fru.resize(eepromSize, 0xFF);
+    }
+
     fruCache.clear();
     lastDevId = devId;
     fruCache = fru;
@@ -1258,17 +1281,22 @@ void registerStorageFunctions()
     createTimers();
     startMatch();
 
+    // The FRU commands are also registered by the phosphor-ipmi-fru handlers
+    // (fru_strgfnhandler.cpp, storagehandler.cpp) at prioOpenBmcBase; the one
+    // registered last wins, which depends on the library load order.  Register
+    // these at a higher priority so that the FruDevice based ones always win.
+
     // <Get FRU Inventory Area Info>
-    ipmi::registerHandler(ipmi::prioOpenBmcBase, ipmi::netFnStorage,
+    ipmi::registerHandler(ipmi::prioOemBase, ipmi::netFnStorage,
                           ipmi::storage::cmdGetFruInventoryAreaInfo,
                           ipmi::Privilege::User, ipmiStorageGetFruInvAreaInfo);
     // <READ FRU Data>
-    ipmi::registerHandler(ipmi::prioOpenBmcBase, ipmi::netFnStorage,
+    ipmi::registerHandler(ipmi::prioOemBase, ipmi::netFnStorage,
                           ipmi::storage::cmdReadFruData, ipmi::Privilege::User,
                           ipmiStorageReadFruData);
 
     // <WRITE FRU Data>
-    ipmi::registerHandler(ipmi::prioOpenBmcBase, ipmi::netFnStorage,
+    ipmi::registerHandler(ipmi::prioOemBase, ipmi::netFnStorage,
                           ipmi::storage::cmdWriteFruData,
                           ipmi::Privilege::Operator, ipmiStorageWriteFruData);
 
