From: CEB-GNRD maintainers
Subject: [PATCH] fru: prefill manufacturing time from the BMC UTC clock

Use one runtime UTC snapshot for serial defaults and the editable board
manufacturing timestamp. Always show the actual clock value, including when
it is outside the FRU field range, instead of silently defaulting to empty.
Keep the 24-bit minute validation, and abort generation on invalid EOF rather
than truncating the value or retrying forever.

Upstream-Status: Inappropriate [CEB-GNRD FRU generation helper]

--- a/lib/ipmi_fru.c
+++ b/lib/ipmi_fru.c
@@ -4786,18 +4786,16 @@
 	return era * 146097 + doe - 719468;
 }
 
-/* default board manufacturing date */
-#define FRU_GEN_DEF_DATE    "2026-10-01"
-
-/* returns the board manufacturing time in minutes since 1996-01-01 00:00 UTC,
- * 0 means unspecified (an empty input) */
-static uint32_t
-fru_gen_ask_date(void)
+/* Returns minutes since 1996-01-01 00:00 UTC, zero for unspecified,
+ * or -1 when EOF prevents correcting an invalid/unrepresentable date. */
+static int32_t
+fru_gen_ask_date(const char *default_date)
 {
 	char line[64];
 	char prev[64];
-	const char *cur = FRU_GEN_DEF_DATE;
+	const char *cur = default_date;
 	int y, mo, d, h, mi, n;
+	int eof;
 	long minutes;
 
 	for (;;) {
@@ -4807,7 +4805,7 @@
 			   "    format : YYYY-MM-DD or YYYY-MM-DD HH:MM, year 1996 or later,\n"
 			   "             or empty for unspecified\n");
 		fru_gen_show_default(cur);
-		fru_gen_input(cur, line, sizeof(line));
+		eof = fru_gen_input(cur, line, sizeof(line)) < 0;
 		if (line[0] == '\0') {
 			return 0;
 		}
@@ -4821,7 +4819,11 @@
 				return (uint32_t)minutes;
 			}
 		}
-		printf("    invalid: use YYYY-MM-DD or YYYY-MM-DD HH:MM (year 1996 or later)\n");
+		printf("    invalid: use YYYY-MM-DD or YYYY-MM-DD HH:MM within the FRU date range\n");
+		if (eof) {
+			lprintf(LOG_ERR, "Cannot encode the manufacturing date; correct the BMC UTC clock or enter a representable date");
+			return -1;
+		}
 		memcpy(prev, line, sizeof(prev));
 		cur = prev;
 	}
@@ -4901,17 +4903,20 @@
 }
 
 static size_t
-fru_gen_board_area(uint8_t *area, const char *serial)
+fru_gen_board_area(uint8_t *area, const char *serial, const char *default_date)
 {
 	char text[FRU_GEN_FIELD_MAX + 1];
-	uint32_t date;
+	int32_t date;
 	size_t used = 0;
 
 	printf("\n=== Board info area (2 of 3) ===\n\n");
 	area[used++] = 0x01;    /* format version */
 	area[used++] = 0;       /* length, set in fru_gen_end_area() */
 	area[used++] = 0;       /* language code: English */
-	date = fru_gen_ask_date();
+	date = fru_gen_ask_date(default_date);
+	if (date < 0) {
+		return 0;
+	}
 	area[used++] = (uint8_t)(date & 0xFF);          /* little endian */
 	area[used++] = (uint8_t)((date >> 8) & 0xFF);
 	area[used++] = (uint8_t)((date >> 16) & 0xFF);
@@ -5015,6 +5020,7 @@
 	size_t i;
 	FILE *fp;
 	char serial[11];
+	char mfg_date[32];
 	time_t now;
 	struct tm *utc;
 
@@ -5026,12 +5032,21 @@
 		return -1;
 	}
 
+	/* Read the BMC system UTC clock once for both date and serial defaults. */
+	if (strftime(mfg_date, sizeof(mfg_date), "%Y-%m-%d %H:%M", utc) == 0) {
+		lprintf(LOG_ERR, "Cannot format BMC UTC time for the manufacturing date");
+		return -1;
+	}
+
 	printf("Creating FRU image %s.\n"
 		   "The default of each field is in the input line: edit it with\n"
 		   "Backspace and type, or press Enter to keep it.\n",
 		   filename);
 	clen = fru_gen_chassis_area(chassis, serial);
-	blen = fru_gen_board_area(board, serial);
+	blen = fru_gen_board_area(board, serial, mfg_date);
+	if (blen == 0) {
+		return -1;
+	}
 	plen = fru_gen_product_area(product, serial);
 
 	memset(hdr, 0, sizeof(hdr));
