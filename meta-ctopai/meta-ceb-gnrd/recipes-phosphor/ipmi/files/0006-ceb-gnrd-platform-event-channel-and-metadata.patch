--- /dev/null
+++ b/platform_event.hpp
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <ipmid/api.hpp>
+#include <ipmid/utils.hpp>
+#include <phosphor-logging/lg2.hpp>
+#include <user_channel/channel_layer.hpp>
+
+#include <algorithm>
+#include <format>
+#include <vector>
+
+namespace ipmi::platform_event
+{
+// Both legacy and dynamic providers use this implementation. BIOS/KCS includes
+// a software Generator ID; LAN and the local D-Bus INTRABMC channel omit it.
+inline RspType<> handle(Context::ptr ctx, const std::vector<uint8_t>& data)
+{
+    ChannelInfo channelInfo;
+    if (getChannelInfo(ctx->channel, channelInfo) != ccSuccess)
+    {
+        return responseUnspecifiedError();
+    }
+    const auto medium = static_cast<EChannelMediumType>(channelInfo.mediumType);
+    const bool system = medium == EChannelMediumType::systemInterface;
+    // Retain the eight-byte workaround used by older on-BMC clients, only on
+    // the internal OEM channel. Never guess the format of LAN/IPMB messages.
+    const bool internal = medium == EChannelMediumType::oem &&
+                          ctx->channel == getChannelByName("INTRABMC");
+    const bool legacyInternal = internal && data.size() == 8 &&
+                                (data[0] & 1) != 0 && data[1] == 4;
+    const bool hasGenerator = system || legacyInternal;
+    const size_t offset = hasGenerator ? 1 : 0;
+    const size_t headerSize = offset + 4;
+    if (data.size() < headerSize + 1 || data.size() > headerSize + 3)
+    {
+        return responseReqDataLenInvalid();
+    }
+    if ((hasGenerator && (data[0] & 1) == 0) || data[offset] != 4)
+    {
+        return responseInvalidFieldRequest();
+    }
+    const uint8_t sensorType = data[offset + 1];
+    if (sensorType > 0x2c && sensorType < 0xc0)
+    {
+        return responseInvalidFieldRequest();
+    }
+    const uint8_t sensorNumber = data[offset + 2];
+    const uint8_t directionType = data[offset + 3];
+    const uint8_t eventType = directionType & 0x7f;
+    const bool asserted = (directionType & 0x80) == 0;
+    const uint8_t eventData1 = data[headerSize];
+    const size_t required = (eventData1 & 0x30) != 0 ? 3 :
+                            (eventData1 & 0xc0) != 0 ? 2 : 1;
+    if (data.size() < headerSize + required)
+    {
+        return responseReqDataLenInvalid();
+    }
+    // Preserve all supplied bytes, even when their validity bits are zero.
+    std::vector<uint8_t> eventData(3, 0xff);
+    std::copy(data.begin() + headerSize, data.end(), eventData.begin());
+    uint16_t generator = static_cast<uint16_t>(ctx->channel) << 12;
+    if (hasGenerator)
+    {
+        generator |= data[0];
+    }
+    else if (internal)
+    {
+        generator |= 0x41; // Local system-management software.
+    }
+    else
+    {
+        generator |= ((ctx->lun & 3) << 8) | (ctx->rqSA << 1);
+    }
+    const std::string message = std::format(
+        "IPMI platform event: type={:02x} sensor={:02x} event={:02x} {} data={:02x}{:02x}{:02x}",
+        sensorType, sensorNumber, eventType, asserted ? "asserted" : "deasserted",
+        eventData[0], eventData[1], eventData[2]);
+    boost::system::error_code ec;
+    const auto recordId = callDbusMethod<uint16_t>(
+        ctx, ec, "xyz.openbmc_project.Logging.IPMI", "/xyz/openbmc_project/Logging/IPMI",
+        "xyz.openbmc_project.Logging.IPMI", "IpmiSelAddPlatform", message,
+        sensorType, sensorNumber, eventType, eventData, asserted, generator);
+    if (ec)
+    {
+        lg2::error("Platform event SEL add failed: {ERROR}", "ERROR", ec.message());
+        return responseUnspecifiedError();
+    }
+    if (recordId == 0xffff)
+    {
+        return responseOutOfSpace();
+    }
+    return responseSuccess();
+}
+} // namespace ipmi::platform_event
