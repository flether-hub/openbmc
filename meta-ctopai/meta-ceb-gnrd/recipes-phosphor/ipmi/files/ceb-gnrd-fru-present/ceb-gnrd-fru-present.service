[Unit]
Description=Mark the CEB-GNRD board FRU present in the inventory
After=xyz.openbmc_project.Inventory.Manager.service
Wants=xyz.openbmc_project.Inventory.Manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ceb-gnrd-fru-present.sh

[Install]
WantedBy=multi-user.target
