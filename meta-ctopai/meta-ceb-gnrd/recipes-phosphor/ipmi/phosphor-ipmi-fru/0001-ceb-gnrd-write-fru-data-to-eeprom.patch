From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] strgfnhandler: Write FRU Data also writes the FRU EEPROM

IPMI Write FRU Data writes the FRU storage, but the handler only kept the
bytes in /tmp/ipmifru<id> and pushed the parsed fields to the inventory, so
"ipmitool fru write" was lost at the next BMC boot.  Also write the bytes to
the FRU's EEPROM, found in the obmc-read-eeprom environment files
(/etc/default/obmc/eeproms/..., FRUID= and SYSFS_PATH=).  The kernel at24/nvmem
driver handles the EEPROM write protect line.  A write error is reported to the
requester (80h when write protected).

Upstream-Status: Inappropriate [CEB-GNRD board-specific behavior]
---
--- a/strgfnhandler.cpp
+++ b/strgfnhandler.cpp
@@ -7,13 +7,103 @@
 #include <phosphor-logging/lg2.hpp>
 #include <sdbusplus/bus.hpp>
 
+#include <fcntl.h>
+
+#include <cerrno>
 #include <cstdio>
 #include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <optional>
+#include <string>
 
 void registerNetFnStorageWriteFru() __attribute__((constructor));
 
 sd_bus* ipmid_get_sd_bus_connection(void);
 
+namespace
+{
+// The EEPROM of a FRU, from the same environment files that obmc-read-eeprom@
+// uses (/etc/default/obmc/eeproms/..., lines FRUID=<id> and
+// SYSFS_PATH=<nvmem file>).
+std::optional<std::string> fruEepromPath(uint8_t fruId)
+{
+    std::error_code ec;
+    const std::filesystem::path dir{"/etc/default/obmc/eeproms"};
+    for (const auto& entry :
+         std::filesystem::recursive_directory_iterator(dir, ec))
+    {
+        if (!entry.is_regular_file(ec))
+        {
+            continue;
+        }
+        std::ifstream file(entry.path());
+        std::string line;
+        std::optional<unsigned long> id;
+        std::string sysfsPath;
+        while (std::getline(file, line))
+        {
+            if (line.starts_with("FRUID="))
+            {
+                try
+                {
+                    id = std::stoul(line.substr(6), nullptr, 0);
+                }
+                catch (const std::exception&)
+                {}
+            }
+            else if (line.starts_with("SYSFS_PATH="))
+            {
+                sysfsPath = line.substr(11);
+            }
+        }
+        if (id && *id == fruId && !sysfsPath.empty())
+        {
+            return sysfsPath;
+        }
+    }
+    return std::nullopt;
+}
+
+// IPMI Write FRU Data writes the FRU storage: put the bytes into the EEPROM.
+// The kernel nvmem/at24 driver releases the EEPROM write protect line during
+// the write.  Returns 0 or an errno value.
+int writeFruEeprom(uint8_t fruId, uint16_t offset,
+                   const std::vector<uint8_t>& buffer)
+{
+    auto path = fruEepromPath(fruId);
+    if (!path)
+    {
+        lg2::info("No EEPROM configured for FRU {FRUID}, inventory only",
+                  "FRUID", fruId);
+        return 0;
+    }
+    int fd = open(path->c_str(), O_WRONLY | O_CLOEXEC);
+    if (fd < 0)
+    {
+        int err = errno;
+        lg2::error("Cannot open FRU EEPROM {PATH}: {ERRNO}", "PATH", *path,
+                   "ERRNO", err);
+        return err;
+    }
+    ssize_t written = pwrite(fd, buffer.data(), buffer.size(), offset);
+    int err = written < 0 ? errno : 0;
+    if (written >= 0 && static_cast<size_t>(written) != buffer.size())
+    {
+        err = ENOSPC; // beyond the end of the EEPROM
+    }
+    close(fd);
+    if (err)
+    {
+        lg2::error(
+            "Writing FRU EEPROM {PATH} failed, offset: {OFFSET}, length: {LENGTH}, errno: {ERRNO}",
+            "PATH", *path, "OFFSET", offset, "LENGTH", buffer.size(), "ERRNO",
+            err);
+    }
+    return err;
+}
+} // namespace
+
 ///-------------------------------------------------------
 // Called by IPMI netfn router for write fru data command
 //--------------------------------------------------------
@@ -67,6 +157,21 @@
         return ipmi::responseInvalidFieldRequest();
     }
 
+    // Write FRU Data writes the FRU storage (IPMI spec): the EEPROM as well.
+    if (int err = writeFruEeprom(fruId, offset, buffer); err)
+    {
+        // 80h: write-protected offset; others: unspecified error
+        if (err == EACCES || err == EPERM || err == EROFS)
+        {
+            return ipmi::response(0x80);
+        }
+        if (err == ENOSPC || err == EFBIG || err == EINVAL)
+        {
+            return ipmi::responseParmOutOfRange();
+        }
+        return ipmi::responseUnspecifiedError();
+    }
+
     // Get the reference to global sd_bus object
     sd_bus* bus_type = ipmid_get_sd_bus_connection();
 
