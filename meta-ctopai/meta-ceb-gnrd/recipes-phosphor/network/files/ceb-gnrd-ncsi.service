[Unit]
Description=Gate host-powered NC-SI interface on chassis power state
After=xyz.openbmc_project.State.Chassis@0.service systemd-networkd.service
Wants=xyz.openbmc_project.State.Chassis@0.service systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/libexec/manage-ncsi-link.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
