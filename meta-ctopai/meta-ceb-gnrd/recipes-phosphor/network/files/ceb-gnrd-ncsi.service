[Unit]
Description=Gate host-powered NC-SI interface on power and BIOS POST complete
After=xyz.openbmc_project.Chassis.Control.Power@0.service systemd-networkd.service
Wants=xyz.openbmc_project.Chassis.Control.Power@0.service systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/libexec/manage-ncsi-link.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
