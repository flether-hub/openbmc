# SEL rollover with the standard logrotate: phosphor-sel-logger keeps its records in
# /var/log/ipmi_sel* (rsyslog writes ipmi_sel, the rotated copies are ipmi_sel.1 ...;
# the logger reads all of them and keeps the next record ID in a file of its own, so
# IDs are never reused).  A record is about 150 bytes, so 15 KiB per file is about
# 100 records; with one rotated copy the SEL holds the newest 100 to 200 records and
# the oldest ones are deleted.
/var/log/ipmi_sel {
    size 15k
    rotate 1
    nodateext
    nocompress
    missingok
    notifempty
    postrotate
        /bin/systemctl kill --signal=HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}

# Warning/error text replaces persistent binary journals on JFFS2.
# Current file plus five copies target 3 MiB. The minute timer allows temporary
# overshoot between rotations; this is not a hard quota.
/var/log/bmc-system.log {
    size 512k
    rotate 5
    nodateext
    nocompress
    missingok
    notifempty
    postrotate
        /bin/systemctl kill --signal=HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}

# The Redfish event log (web "Event logs"), written by rsyslog from journal entries
# with a REDFISH_MESSAGE_ID; bmcweb reads redfish and redfish.1.
/var/log/redfish {
    size 64k
    rotate 1
    nodateext
    nocompress
    missingok
    notifempty
    postrotate
        /bin/systemctl kill --signal=HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
