-            assertThresholds(sensorPtr.get(), assertValue, threshold.level,
-                             threshold.direction, assert);
+            // A delayed edge must still be valid for the latest sample.
+            // Never emit an old power-ramp value after the rail recovered.
+            const auto changes = checkThresholds(sensorPtr.get(), sensorPtr->value);
+            for (const auto& change : changes)
+            {
+                if (change.threshold.level == threshold.level &&
+                    change.threshold.direction == threshold.direction &&
+                    change.asserted == assert)
