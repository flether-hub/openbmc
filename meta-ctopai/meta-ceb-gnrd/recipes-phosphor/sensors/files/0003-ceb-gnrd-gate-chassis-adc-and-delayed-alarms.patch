+// Use the same settling gate for initial Get and PropertiesChanged.
+// Chassis.On is published by power-control after Power OK, not on request.
+static void updateChassisStatus(
+    const std::shared_ptr<sdbusplus::asio::connection>& conn, bool on,
+    const std::function<void(PowerState, bool)>& callback)
+{
+    static boost::asio::steady_timer timer(conn->get_io_context());
+    const unsigned int generation = ++chassisStatusGeneration;
+    timer.cancel();
+    chassisStatusOn = false;
+    callback(PowerState::chassisOn, false);
+    if (!on)
+    {
+        return;
+    }
+    timer.expires_after(std::chrono::seconds(10));
+    timer.async_wait([callback, generation](boost::system::error_code ec) {
+        if (ec == boost::asio::error::operation_aborted ||
+            generation != chassisStatusGeneration)
+        {
+            return;
+        }
+        if (ec)
+        {
+            lg2::error("Chassis settling timer error: {ERROR}", "ERROR",
+                       ec.message());
+            return;
+        }
+        chassisStatusOn = true;
+        callback(PowerState::chassisOn, true);
+    });
+}
