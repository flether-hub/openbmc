From: CEB-GNRD platform <ceb-gnrd@localhost>
Subject: [PATCH] post codes: preserve all values and use host events for cycles

Upstream-Status: Inappropriate [CEB-GNRD retention and host reset integration]

Do not assume zero means idle or 01 means a new BIOS boot. Preserve all raw
POST writes, including equal values at the same microsecond. Archive and flush
the previous cycle on host Off events; x86-power-control also produces these
while checking a warm reset from POST_COMPLETE. Repeated Off events with no
new POST data create no empty cycles. Stop pending writes before clearing or
deleting logs so a delayed timer cannot overwrite a completed cycle.

Without an observed host event, keep recording in the current cycle rather
than inventing a BIOS-specific reset from the POST stream.

--- a/src/post_code.cpp
+++ b/src/post_code.cpp
@@ -153,4 +153,8 @@
 void PostCode::deleteAll()
 {
+    if (timer)
+    {
+        timer->stop();
+    }
     std::uintmax_t n = fs::remove_all(postCodeListPath);
     std::cerr << "clearPostCodes deleted " << n << " files in "
@@ -197,4 +201,27 @@
 }
 
+// Host-state events define the boundary; POST byte values do not. On this
+// platform the power controller also reports Off while checking a warm reset
+// after POST_COMPLETE deasserts. Persist before clearing the in-memory cycle.
+void PostCode::archiveBootCycle()
+{
+    if (timer)
+    {
+        timer->stop();
+    }
+    if (postCodes.empty())
+    {
+        return;
+    }
+    if (serialize(postCodeListPath).empty())
+    {
+        // Keep the records if persistence fails, rather than losing them.
+        return;
+    }
+    postCodes.clear();
+    phosphor::logging::log<phosphor::logging::level::INFO>(
+        "POST cycle archived after host Off/reset state event");
+}
+
 void PostCode::savePostCodes(postcode_t code)
 {
@@ -202,5 +229,8 @@
     {
         timer = std::make_unique<sdbusplus::Timer>(event.get(), [this]() {
-            serialize(postCodeListPath);
+            if (!postCodes.empty())
+            {
+                serialize(postCodeListPath);
+            }
         });
     }
@@ -227,4 +257,10 @@
     }
 
+    // Several valid writes (including repeated 00/01) can arrive in one
+    // microsecond. map::insert would otherwise silently discard duplicates.
+    if (!postCodes.empty() && tsUS <= postCodes.rbegin()->first)
+    {
+        tsUS = postCodes.rbegin()->first + 1;
+    }
     postCodes.insert(std::make_pair(tsUS, code));
     if (postCodes.size() > MAX_POST_CODE_SIZE_PER_CYCLE)
--- a/inc/post_code.hpp
+++ b/inc/post_code.hpp
@@ -132,15 +132,5 @@
                     if (currentHostState == StateServer::Host::HostState::Off)
                     {
-                        if (this->postCodes.empty())
-                        {
-                            std::cerr
-                                << "HostState changed to OFF. Empty "
-                                   "postcode log, keep boot cycle at "
-                                << this->currentBootCycleIndex << std::endl;
-                        }
-                        else
-                        {
-                            this->postCodes.clear();
-                        }
+                        this->archiveBootCycle();
                     }
                 }
@@ -195,4 +185,5 @@
     sdbusplus::match propertiesChangedSignalCurrentHostState;
 
+    void archiveBootCycle();
     void savePostCodes(postcode_t code);
     fs::path serialize(const fs::path& path);
