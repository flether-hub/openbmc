+      "download": "下载",
+      "edit": "编辑",
+      "enable": "启用",
+      "export": "导出",
+      "exportAll": "全部导出",
+      "filter": "筛选",
+      "refresh": "刷新",
+      "reset": "重置",
+      "save": "保存",
+      "settings": "设置",
+      "ok": "确定",
+      "warning": "警告",
+      "critical": "严重"
