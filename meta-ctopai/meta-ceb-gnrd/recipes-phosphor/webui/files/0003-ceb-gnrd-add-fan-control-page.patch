diff --git a/src/views/Settings/FanControl/FanControl.vue b/src/views/Settings/FanControl/FanControl.vue
new file mode 100644
index 0000000..065091b
--- /dev/null
+++ b/src/views/Settings/FanControl/FanControl.vue
@@ -0,0 +1,256 @@
+<template>
+  <b-container fluid="xl">
+    <page-title :description="$t('pageFanControl.description')" />
+
+    <b-alert v-if="loadError" show variant="danger">
+      {{ $t('pageFanControl.loadError') }}
+    </b-alert>
+    <b-alert v-else-if="!hasControl" show variant="warning">
+      {{ $t('pageFanControl.unavailable') }}
+    </b-alert>
+
+    <b-form @submit.prevent="saveSettings">
+      <b-form-group :label="$t('pageFanControl.fan')">
+        <b-form-select
+          v-model="selectedFan"
+          :options="fanOptions"
+          :disabled="!hasControl"
+          @change="loadSelectedSettings"
+        />
+      </b-form-group>
+
+      <b-form-group :label="$t('pageFanControl.mode')">
+        <b-form-radio-group
+          v-model="mode"
+          :options="modeOptions"
+          name="fan-control-mode"
+          :disabled="!hasControl"
+        />
+      </b-form-group>
+
+      <b-form-group
+        v-if="mode === 'fixed'"
+        :label="$t('pageFanControl.fixedSpeed')"
+      >
+        <b-form-select
+          v-model.number="fixedSpeed"
+          :options="fixedOptions"
+          :disabled="!hasControl"
+        />
+      </b-form-group>
+
+      <b-form-group>
+        <b-form-checkbox v-model="persist" :disabled="!hasControl">
+          {{ $t('pageFanControl.persist') }}
+        </b-form-checkbox>
+        <small class="d-block text-muted">
+          {{ $t('pageFanControl.persistHelp') }}
+        </small>
+      </b-form-group>
+
+      <b-button
+        variant="primary"
+        type="submit"
+        :disabled="isSaving || !hasControl"
+      >
+        {{ $t('global.action.saveSettings') }}
+      </b-button>
+    </b-form>
+
+    <h2 class="h5 mt-5">{{ $t('pageFanControl.commandTitle') }}</h2>
+    <p class="text-muted">{{ $t('pageFanControl.commandHelp') }}</p>
+
+    <label for="fan-read-command">{{ $t('pageFanControl.readTitle') }}</label>
+    <textarea
+      id="fan-read-command"
+      class="form-control font-monospace mb-1"
+      rows="6"
+      readonly
+      :value="readCommand"
+    />
+    <small class="d-block text-muted mb-4">
+      {{ $t('pageFanControl.readHelp') }}
+    </small>
+
+    <label for="fan-set-command">{{ $t('pageFanControl.setTitle') }}</label>
+    <textarea
+      id="fan-set-command"
+      class="form-control font-monospace mb-1"
+      rows="2"
+      readonly
+      :value="setCommand"
+    />
+    <small class="d-block text-muted">
+      {{ $t('pageFanControl.setHelp') }}
+    </small>
+  </b-container>
+</template>
+
+<script>
+import api from '@/store/api';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import PageTitle from '@/components/Global/PageTitle';
+
+const managerPath = '/redfish/v1/Managers/bmc';
+// Adaptive mode uses the limits of the Entity-Manager configuration.
+const adaptiveMinimum = 30;
+const adaptiveMaximum = 100;
+const settingsPath = '/xyz/openbmc_project/ceb_gnrd/fan_settings';
+// Redfish adds metadata members such as @odata.id to the fan objects.
+const isConfigEntry = ([name]) => !name.startsWith('@');
+
+const hex = (value) =>
+  `0x${Number(value).toString(16).toUpperCase().padStart(2, '0')}`;
+
+export default {
+  name: 'FanControl',
+  components: { PageTitle },
+  mixins: [BVToastMixin],
+  data() {
+    return {
+      mode: 'adaptive',
+      fixedSpeed: 60,
+      selectedFan: 'all',
+      modeOptions: [
+        { text: this.$t('pageFanControl.adaptive'), value: 'adaptive' },
+        { text: this.$t('pageFanControl.fixed'), value: 'fixed' },
+      ],
+      fixedOptions: [20, 40, 60, 80, 100].map((value) => ({
+        text: `${value}%`,
+        value,
+      })),
+      controllers: [],
+      zones: [],
+      isSaving: false,
+      loadError: false,
+      persist: false,
+      readCommand: [
+        'ipmitool raw 0x30 0x01',
+        '',
+        'r=($(ipmitool raw 0x30 0x01)); echo "keep=$((0x${r[0]}))"; for i in 0 1 2 3 4 5; do b=$((1+i*4)); echo "SYS_FAN$i mode=$((0x${r[b]})) duty=$((0x${r[b+1]}))% rpm=$((0x${r[b+3]}${r[b+2]}))"; done',
+      ].join('\n'),
+    };
+  },
+  computed: {
+    hasControl() {
+      return this.controllers.length > 0 || this.zones.length > 0;
+    },
+    fanOptions() {
+      const entries = this.controllers.length ? this.controllers : this.zones;
+      return [
+        { text: this.$t('pageFanControl.allFans'), value: 'all' },
+        ...entries.map(([name]) => ({ text: name, value: name })),
+      ];
+    },
+    fanIndex() {
+      // fan number: the digits at the end of the name (SYS_FAN3 -> 3), 0xFF = all
+      const match = /(\d+)$/.exec(this.selectedFan);
+      return this.selectedFan === 'all' || !match ? 255 : Number(match[1]);
+    },
+    setCommand() {
+      const fan = this.fanIndex;
+      const fixed = this.mode === 'fixed';
+      return `ipmitool raw 0x30 0x02 ${[
+        fan,
+        fixed ? 1 : 0,
+        fixed ? Number(this.fixedSpeed) : 0,
+        this.persist ? 1 : 0,
+      ]
+        .map(hex)
+        .join(' ')}`;
+    },
+  },
+  created() {
+    this.loadSettings();
+  },
+  methods: {
+    async loadSettings() {
+      try {
+        const { data } = await api.get(managerPath);
+        const fan = data?.Oem?.OpenBmc?.Fan;
+        if (!fan) return;
+
+        this.controllers = Object.entries(fan.FanControllers || {}).filter(
+          isConfigEntry,
+        );
+        this.zones = Object.entries(fan.FanZones || {}).filter(isConfigEntry);
+        this.loadSelectedSettings();
+        await this.loadPersistence();
+      } catch {
+        this.loadError = true;
+      }
+    },
+    async loadPersistence() {
+      try {
+        const { data } = await api.get(`${settingsPath}/attr/Persist`);
+        this.persist = data?.data === true;
+      } catch {
+        // The persistence service is optional; keep the default (off).
+      }
+    },
+    loadSelectedSettings() {
+      const first = this.controllers.find(
+        ([name]) => this.selectedFan === 'all' || name === this.selectedFan,
+      )?.[1] || this.zones.find(
+        ([name]) => this.selectedFan === 'all' || name === this.selectedFan,
+      )?.[1] || this.controllers[0]?.[1] || this.zones[0]?.[1];
+      const configuredMinimum = Number(first?.OutLimitMin);
+      const configuredMaximum = Number(first?.OutLimitMax);
+      if (
+        Number.isFinite(configuredMinimum) &&
+        Number.isFinite(configuredMaximum) &&
+        configuredMinimum === configuredMaximum
+      ) {
+        this.mode = 'fixed';
+        this.fixedSpeed = configuredMaximum;
+      } else {
+        this.mode = 'adaptive';
+      }
+    },
+    async savePersistence() {
+      // bmcweb's D-Bus REST cannot pass arguments here, so use one method each.
+      const action = this.persist ? 'KeepSettings' : 'ForgetSettings';
+      await api.post(`${settingsPath}/action/${action}`, { data: [] });
+    },
+    async saveSettings() {
+      const fixed = this.mode === 'fixed';
+      const minimum = fixed ? Number(this.fixedSpeed) : adaptiveMinimum;
+      const maximum = fixed ? Number(this.fixedSpeed) : adaptiveMaximum;
+      const fanControllers = Object.fromEntries(
+        this.controllers.map(([name, config]) => [name,
+          this.selectedFan === 'all' || name === this.selectedFan
+            ? { ...config, OutLimitMin: minimum, OutLimitMax: maximum }
+            : config,
+        ]),
+      );
+      const fanZones = Object.fromEntries(
+        this.zones.map(([name, config]) => [name,
+          this.selectedFan === 'all' || name === this.selectedFan
+            ? { ...config, MinThermalOutput: minimum }
+            : config,
+        ]),
+      );
+
+      this.isSaving = true;
+      try {
+        await api.patch(managerPath, {
+          Oem: {
+            OpenBmc: {
+              Fan: {
+                ...(this.controllers.length ? { FanControllers: fanControllers } : {}),
+                ...(this.zones.length ? { FanZones: fanZones } : {}),
+              },
+            },
+          },
+        });
+        await this.savePersistence();
+        await this.loadSettings();
+        this.successToast(this.$t('pageFanControl.saveSuccess'));
+      } catch {
+        this.errorToast(this.$t('pageFanControl.saveError'));
+      } finally {
+        this.isSaving = false;
+      }
+    },  },
+};
+</script>
