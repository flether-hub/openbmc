diff --git a/src/views/Settings/FanControl/FanControl.vue b/src/views/Settings/FanControl/FanControl.vue
new file mode 100644
index 0000000..065091b
--- /dev/null
+++ b/src/views/Settings/FanControl/FanControl.vue
@@ -0,0 +1,211 @@
+<template>
+  <b-container fluid="xl">
+    <page-title :description="$t('pageFanControl.description')" />
+
+    <b-alert v-if="loadError" show variant="danger">
+      {{ $t('pageFanControl.loadError') }}
+    </b-alert>
+    <b-alert v-else-if="!hasControl" show variant="warning">
+      {{ $t('pageFanControl.unavailable') }}
+    </b-alert>
+
+    <b-form @submit.prevent="saveSettings">
+      <b-form-group :label="$t('pageFanControl.fan')">
+        <b-form-select
+          v-model="selectedFan"
+          :options="fanOptions"
+          :disabled="!hasControl"
+          @change="showSelectedFan"
+        />
+      </b-form-group>
+
+      <b-form-group :label="$t('pageFanControl.mode')">
+        <b-form-radio-group
+          v-model="mode"
+          :options="modeOptions"
+          name="fan-control-mode"
+          :disabled="!hasControl"
+        />
+      </b-form-group>
+
+      <b-form-group
+        v-if="mode === 'fixed'"
+        :label="$t('pageFanControl.fixedSpeed')"
+      >
+        <b-form-select
+          v-model.number="fixedSpeed"
+          :options="fixedOptions"
+          :disabled="!hasControl"
+        />
+      </b-form-group>
+
+      <b-form-group>
+        <b-form-checkbox v-model="persist" :disabled="!hasControl">
+          {{ $t('pageFanControl.persist') }}
+        </b-form-checkbox>
+        <small class="d-block text-muted">
+          {{ $t('pageFanControl.persistHelp') }}
+        </small>
+      </b-form-group>
+
+      <b-button
+        variant="primary"
+        type="submit"
+        :disabled="isSaving || !hasControl"
+      >
+        {{ $t('global.action.saveSettings') }}
+      </b-button>
+    </b-form>
+
+    <h2 class="h5 mt-5">{{ $t('pageFanControl.commandTitle') }}</h2>
+    <p class="text-muted">{{ $t('pageFanControl.commandHelp') }}</p>
+
+    <label for="fan-read-command">{{ $t('pageFanControl.readTitle') }}</label>
+    <textarea
+      id="fan-read-command"
+      class="form-control font-monospace mb-1"
+      rows="6"
+      readonly
+      :value="readCommand"
+    />
+    <small class="d-block text-muted mb-4">
+      {{ $t('pageFanControl.readHelp') }}
+    </small>
+
+    <label for="fan-set-command">{{ $t('pageFanControl.setTitle') }}</label>
+    <textarea
+      id="fan-set-command"
+      class="form-control font-monospace mb-1"
+      rows="2"
+      readonly
+      :value="setCommand"
+    />
+    <small class="d-block text-muted">
+      {{ $t('pageFanControl.setHelp') }}
+    </small>
+  </b-container>
+</template>
+
+<script>
+import api from '@/store/api';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import PageTitle from '@/components/Global/PageTitle';
+
+// The service has argument-free methods only: bmcweb's D-Bus REST cannot pass
+// arguments here.  Saving is three calls: select the fan(s), set the mode of
+// the selection, then choose whether the result is kept after a BMC reboot.
+const settingsPath = '/xyz/openbmc_project/ceb_gnrd/fan_settings';
+const fanCount = 6;
+
+const hex = (value) =>
+  `0x${Number(value).toString(16).toUpperCase().padStart(2, '0')}`;
+
+export default {
+  name: 'FanControl',
+  components: { PageTitle },
+  mixins: [BVToastMixin],
+  data() {
+    return {
+      mode: 'adaptive',
+      fixedSpeed: 60,
+      selectedFan: 'all',
+      fanStatus: [],
+      modeOptions: [
+        { text: this.$t('pageFanControl.adaptive'), value: 'adaptive' },
+        { text: this.$t('pageFanControl.fixed'), value: 'fixed' },
+      ],
+      fixedOptions: [20, 40, 60, 80, 100].map((value) => ({
+        text: `${value}%`,
+        value,
+      })),
+      fanOptions: [
+        { text: this.$t('pageFanControl.allFans'), value: 'all' },
+        ...Array.from({ length: fanCount }, (_, index) => ({
+          text: `SYS_FAN${index}`,
+          value: index,
+        })),
+      ],
+      hasControl: false,
+      isSaving: false,
+      loadError: false,
+      persist: false,
+      readCommand: [
+        'ipmitool raw 0x30 0x01',
+        '',
+        'r=($(ipmitool raw 0x30 0x01)); echo "keep=$((0x${r[0]}))"; for i in 0 1 2 3 4 5; do b=$((1+i*4)); echo "SYS_FAN$i mode=$((0x${r[b]})) duty=$((0x${r[b+1]}))% rpm=$((0x${r[b+3]}${r[b+2]}))"; done',
+      ].join('\n'),
+    };
+  },
+  computed: {
+    fanIndex() {
+      // fan number 0..5, 0xFF = all fans
+      return this.selectedFan === 'all' ? 255 : Number(this.selectedFan);
+    },
+    setCommand() {
+      const fixed = this.mode === 'fixed';
+      return `ipmitool raw 0x30 0x02 ${[
+        this.fanIndex,
+        fixed ? 1 : 0,
+        fixed ? Number(this.fixedSpeed) : 0,
+        this.persist ? 1 : 0,
+      ]
+        .map(hex)
+        .join(' ')}`;
+    },
+  },
+  created() {
+    this.loadSettings();
+  },
+  methods: {
+    async callService(action) {
+      const response = await api.post(`${settingsPath}/action/${action}`, {
+        data: [],
+      });
+      return response?.data?.data;
+    },
+    async loadSettings() {
+      try {
+        // [keep after reboot, then mode, duty, rpm low, rpm high for each fan]
+        const bytes = await this.callService('GetFans');
+        if (!Array.isArray(bytes) || bytes.length < 1 + 4 * fanCount) return;
+        this.hasControl = true;
+        this.persist = bytes[0] === 1;
+        this.fanStatus = Array.from({ length: fanCount }, (_, index) => ({
+          fixed: bytes[1 + index * 4] === 1,
+          duty: bytes[2 + index * 4],
+        }));
+        this.showSelectedFan();
+      } catch {
+        this.loadError = true;
+      }
+    },
+    showSelectedFan() {
+      const status = this.fanStatus[this.selectedFan === 'all' ? 0 : this.selectedFan];
+      if (status?.fixed && status.duty >= 10 && status.duty <= 100) {
+        this.mode = 'fixed';
+        this.fixedSpeed = status.duty;
+      } else {
+        this.mode = 'adaptive';
+      }
+    },
+    async saveSettings() {
+      const select =
+        this.selectedFan === 'all' ? 'All' : `${this.selectedFan}`;
+      const apply =
+        this.mode === 'fixed' ? `Fixed${this.fixedSpeed}` : 'Adaptive';
+      const keep = this.persist ? 'Keep' : 'Forget';
+      this.isSaving = true;
+      try {
+        const action = `ApplyFan${select}${apply}${keep}`;
+        if ((await this.callService(action)) !== true) throw new Error(action);
+        await this.loadSettings();
+        this.successToast(this.$t('pageFanControl.saveSuccess'));
+      } catch {
+        this.errorToast(this.$t('pageFanControl.saveError'));
+      } finally {
+        this.isSaving = false;
+      }
+    },
+  },
+};
+</script>
