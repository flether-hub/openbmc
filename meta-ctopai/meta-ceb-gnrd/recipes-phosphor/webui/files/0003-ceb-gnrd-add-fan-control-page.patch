+<template>
+  <b-container fluid="xl">
+    <page-title :description="$t('pageFanControl.description')" />
+
+    <b-alert v-if="loadError" show variant="danger">
+      {{ $t('pageFanControl.loadError') }}
+    </b-alert>
+    <b-alert v-else-if="!hasControl" show variant="warning">
+      {{ $t('pageFanControl.unavailable') }}
+    </b-alert>
+
+    <b-form @submit.prevent="saveSettings">
+      <b-form-group :label="$t('pageFanControl.mode')">
+        <b-form-radio-group
+          v-model="mode"
+          :options="modeOptions"
+          name="fan-control-mode"
+          :disabled="!hasControl"
+        />
+      </b-form-group>
+
+      <b-form-group :label="$t('pageFanControl.minimumSpeed')">
+        <b-form-input
+          v-model.number="minimumSpeed"
+          type="range"
+          min="10"
+          max="100"
+          step="1"
+          :disabled="!hasControl"
+        />
+        <output>{{ minimumSpeed }}%</output>
+      </b-form-group>
+
+      <b-form-group
+        v-if="mode === 'fixed'"
+        :label="$t('pageFanControl.fixedSpeed')"
+      >
+        <b-form-select
+          v-model.number="fixedSpeed"
+          :options="fixedOptions"
+          :disabled="!hasControl"
+        />
+      </b-form-group>
+
+      <b-button
+        variant="primary"
+        type="submit"
+        :disabled="isSaving || !hasControl"
+      >
+        {{ $t('global.action.saveSettings') }}
+      </b-button>
+    </b-form>
+  </b-container>
+</template>
+
+<script>
+import api from '@/store/api';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import PageTitle from '@/components/Global/PageTitle';
+
+const managerPath = '/redfish/v1/Managers/bmc';
+
+export default {
+  name: 'FanControl',
+  components: { PageTitle },
+  mixins: [BVToastMixin],
+  data() {
+    return {
+      mode: 'adaptive',
+      minimumSpeed: 30,
+      fixedSpeed: 60,
+      modeOptions: [
+        { text: this.$t('pageFanControl.adaptive'), value: 'adaptive' },
+        { text: this.$t('pageFanControl.fixed'), value: 'fixed' },
+      ],
+      fixedOptions: [20, 40, 60, 80, 100].map((value) => ({
+        text: `${value}%`,
+        value,
+      })),
+      controllers: [],
+      zones: [],
+      isSaving: false,
+      loadError: false,
+    };
+  },
+  computed: {
+    hasControl() {
+      return this.controllers.length > 0 || this.zones.length > 0;
+    },
+  },
+  created() {
+    this.loadSettings();
+  },
+  methods: {
+    async loadSettings() {
+      try {
+        const { data } = await api.get(managerPath);
+        const fan = data?.Oem?.OpenBmc?.Fan;
+        if (!fan) return;
+
+        this.controllers = Object.entries(fan.FanControllers || {});
+        this.zones = Object.entries(fan.FanZones || {});
+        const first = this.controllers[0]?.[1];
+        const configuredMinimum = Number(first?.OutLimitMin);
+        if (Number.isFinite(configuredMinimum)) {
+          this.minimumSpeed = Math.min(100, Math.max(10, configuredMinimum));
+        }
+        const configuredMaximum = Number(first?.OutLimitMax);
+        if (
+          Number.isFinite(configuredMaximum) &&
+          configuredMaximum < 100 &&
+          configuredMaximum >= this.minimumSpeed
+        ) {
+          this.mode = 'fixed';
+          this.fixedSpeed = configuredMaximum;
+        }
+      } catch {
+        this.loadError = true;
+      }
+    },
+    async saveSettings() {
+      const minimum = Math.min(100, Math.max(10, Number(this.minimumSpeed)));
+      const maximum = this.mode === 'fixed' ? this.fixedSpeed : 100;
+      const fanControllers = Object.fromEntries(
+        this.controllers.map(([name]) => [name, {
+          OutLimitMin: minimum,
+          OutLimitMax: maximum,
+        }]),
+      );
+      const fanZones = Object.fromEntries(
+        this.zones.map(([name]) => [name, { MinThermalOutput: minimum }]),
+      );
+
+      this.isSaving = true;
+      try {
+        await api.patch(managerPath, {
+          Oem: {
+            OpenBmc: {
+              Fan: {
+                ...(this.controllers.length ? { FanControllers: fanControllers } : {}),
+                ...(this.zones.length ? { FanZones: fanZones } : {}),
+              },
+            },
+          },
+        });
+        this.successToast(this.$t('pageFanControl.saveSuccess'));
+      } catch {
+        this.errorToast(this.$t('pageFanControl.saveError'));
+      } finally {
+        this.isSaving = false;
+      }
+    },
+  },
+};
+</script>
