From: CEB-GNRD maintainers <bmc@example.com>
Subject: [PATCH] webui: make the SOL console read-only and say so

The host serial port is only meant to be watched from the BMC. Show a notice
on the Serial over LAN page, disable terminal input and do not forward
keystrokes to the websocket.

Upstream-Status: Inappropriate [CEB-GNRD board-specific]
---
 src/locales/en-US.json                                  | 3 ++-
 src/views/Operations/SerialOverLan/SerialOverLanConsole.vue | 14 +++++++++++++-
 2 files changed, 15 insertions(+), 2 deletions(-)

--- a/src/locales/en-US.json
+++ b/src/locales/en-US.json
@@ -865,6 +865,7 @@
         "accessDeniedAriaLabel": "Serial Over LAN access denied",
         "alert": {
-            "disconnectedAlertMessage": "System must be powered on to connect"
+            "disconnectedAlertMessage": "System must be powered on to connect",
+            "readOnlyMessage": "The SOL console is read-only. You can watch the CPU serial output here, but you cannot type to control the console."
         },
         "connected": "Connected",
         "disconnected": "Disconnected",
--- a/src/views/Operations/SerialOverLan/SerialOverLanConsole.vue
+++ b/src/views/Operations/SerialOverLan/SerialOverLanConsole.vue
@@ -5,6 +5,11 @@
       :aria-label="$t('pageSerialOverLan.accessDeniedAriaLabel')"
     />
     <template v-else>
+      <alert variant="info" :small="true" class="mt-4">
+        <p class="col-form-label">
+          {{ $t('pageSerialOverLan.alert.readOnlyMessage') }}
+        </p>
+      </alert>
       <b-row class="d-flex">
         <b-col sm="4" md="6">
           <alert
@@ -138,9 +143,11 @@
           'SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace',
         scrollback: 10000,
         theme: SOL_THEME,
+        disableStdin: true,
       });
 
-      const attachAddon = new AttachAddon(this.ws);
+      // Read-only console: never forward keystrokes to the host serial port.
+      const attachAddon = new AttachAddon(this.ws, { bidirectional: false });
       this.term.loadAddon(attachAddon);
 
       const fitAddon = new FitAddon();
