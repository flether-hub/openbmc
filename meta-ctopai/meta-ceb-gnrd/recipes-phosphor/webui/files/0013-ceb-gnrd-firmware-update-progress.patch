+const BIOS_LAYOUT = `00000000:00000fff descriptor
+00001000:00001fff metadata
+00002000:00011fff pdr
+00012000:01011fff bios
+01012000:01a11fff nac1
+01a12000:02411fff nac0
+02412000:03ffffff reserved
