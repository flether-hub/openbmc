 import FormFile from '@/components/Global/FormFile';
 import ModalUpdateFirmware from './FirmwareModalUpdateFirmware';
+import api from '@/store/api';
 import i18n from '@/i18n';
 
+// CEB-GNRD: steps of the BIOS update, by the progress value that
+// bios-update.sh writes (keep in sync with that script).  Each entry is the
+// first percentage of the step.
+const BIOS_STEPS = [
+  [0, 'stageVerify'],
+  [20, 'stageStarted'],
+  [21, 'stageWaitHostOff'],
+  [25, 'stageSelectFlash'],
+  [28, 'stageDetectFlash'],
+  [30, 'stageErase'],
+  [45, 'stageWrite'],
+  [80, 'stageCheck'],
+  [89, 'stageReturnFlash'],
+  [92, 'stageForceOff'],
+  [95, 'stagePowerOn'],
+  [100, 'stageBiosDone'],
+];
+const POLL_MS = 2000;
+// Redfish TaskState values that end a task without success
+const TASK_FAILED = ['Exception', 'Killed', 'Cancelled', 'Interrupted'];
+
 export default {
   components: { FormFile, ModalUpdateFirmware },
   mixins: [BVToastMixin, LoadingBarMixin, VuelidateMixin],
