     },
+    startPolling(taskUri, timerId) {
+      this.stopPolling();
+      this.pollErrors = 0;
+      this.pollTimer = setInterval(
+        () => this.pollTask(taskUri, timerId),
+        POLL_MS,
+      );
+    },
+    stopPolling() {
+      if (this.pollTimer) clearInterval(this.pollTimer);
+      this.pollTimer = null;
+    },
+    async pollTask(taskUri, timerId) {
+      let task;
+      try {
+        ({ data: task } = await api.get(taskUri, { cache: false }));
+        this.pollErrors = 0;
+      } catch (error) {
+        // A BMC update reboots the BMC: from then on nothing answers.
+        if (++this.pollErrors >= 3 || this.progress.purpose === 'BMC') {
+          this.stopPolling();
+          if (this.progress.purpose !== 'Host') {
+            this.progress.stage = 'stageBmcReboot';
+          } else {
+            this.finish(false, timerId);
+          }
+        }
+        return;
+      }
+      const percent = Number(task?.PercentComplete ?? this.progress.percent);
+      this.progress.percent = Math.max(0, Math.min(100, percent));
+      this.progress.stage = this.stageOf(this.progress.percent);
+      if (task?.TaskState === 'Completed') {
+        this.progress.percent = 100;
+        this.progress.stage = this.stageOf(100);
+        this.finish(true, timerId);
+      } else if (TASK_FAILED.includes(task?.TaskState)) {
+        this.finish(false, timerId);
+      }
+    },
+    stageOf(percent) {
+      if (this.progress.purpose === 'Host') {
+        let stage = BIOS_STEPS[0][1];
+        for (const [from, name] of BIOS_STEPS) {
+          if (percent >= from) stage = name;
+        }
+        return stage;
+      }
+      if (percent >= 100) return 'stageBmcReboot';
+      return percent > 0 ? 'stageBmcStage' : 'stageVerify';
+    },
+    finish(success, timerId) {
+      this.stopPolling();
+      this.endLoader();
+      this.progress.state = success ? 'done' : 'failed';
+      const stage = this.$t('pageFirmware.progress.' + this.progress.stage);
+      if (this.progress.purpose === 'Host') {
+        if (timerId) clearTimeout(timerId);
+        if (success) {
+          this.successToast(this.$t('pageFirmware.progress.biosDone'));
+        } else {
+          this.errorToast(
+            this.$t('pageFirmware.progress.failedAt', { stage }),
+          );
+        }
+        this.$store.dispatch('firmware/getFirmwareInformation');
+      } else if (!success) {
+        if (timerId) clearTimeout(timerId);
+        this.errorToast(this.$t('pageFirmware.progress.failedAt', { stage }));
+      }
+    },
+    // The update package is a tar file; its MANIFEST says what it updates
+    // (purpose=...VersionPurpose.Host for the BIOS, .BMC for the BMC).
+    async readManifestPurpose(file) {
+      try {
+        const decoder = new TextDecoder();
+        let offset = 0;
+        for (let i = 0; i < 32 && offset + 512 <= file.size; i++) {
+          const header = new Uint8Array(
+            await file.slice(offset, offset + 512).arrayBuffer(),
+          );
+          if (header[0] === 0) break;
+          const name = decoder
+            .decode(header.subarray(0, 100))
+            .split('\0')[0]
+            .replace(/^\.\//, '');
+          const size =
+            parseInt(decoder.decode(header.subarray(124, 136)), 8) || 0;
+          if (name === 'MANIFEST') {
+            const text = await file
+              .slice(offset + 512, offset + 512 + size)
+              .text();
+            const match = text.match(/^purpose=.*\.(\w+)\s*$/m);
+            return match ? match[1] : null;
+          }
+          offset += 512 + Math.ceil(size / 512) * 512;
+        }
+      } catch (error) {
+        console.log(error);
+      }
+      return null;
+    },
     onSubmitUpload() {
       this.v$.$touch();
       if (this.v$.$invalid) return;
