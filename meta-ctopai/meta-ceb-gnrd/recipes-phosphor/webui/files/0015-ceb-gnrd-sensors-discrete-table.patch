From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] sensors: analog and discrete sensors on two tabs

The board's IPMI discrete sensor (host boot progress) is built from a D-Bus
property, not a D-Bus sensor, so Redfish and the sensor table do not list it.
Show the sensor page as two tabs: "Analog sensors" (the existing Redfish sensor
table, shown by default) and "Discrete sensors", a table that reads that
property through the D-Bus REST interface every 10 s.

Upstream-Status: Inappropriate [CEB-GNRD board-specific sensors]
---
--- /dev/null
+++ b/src/views/HardwareStatus/Sensors/DiscreteSensors.vue
@@ -0,0 +1,93 @@
+<template>
+  <div>
+    <b-table
+      responsive="md"
+      hover
+      thead-class="table-light"
+      :items="rows"
+      :fields="fields"
+      :busy="loading"
+      data-test-id="sensors-table-discrete"
+    />
+  </div>
+</template>
+
+<script>
+import api from '@/store/api';
+
+// CEB-GNRD: the IPMI discrete sensors (ceb-gnrd-ipmi-sensors/config.yaml) are not
+// D-Bus sensors, so Redfish and the analog sensor tab do not list them.  Read
+// the D-Bus properties they are built from (D-Bus REST) and show their state.
+const SENSORS = [
+  {
+    name: 'Boot_Progress',
+    descriptionKey: 'bootProgress',
+    path: '/xyz/openbmc_project/state/host0',
+    property: 'BootProgress',
+  },
+];
+const REFRESH_MS = 10000;
+
+// D-Bus enum values are shown by their last part (...ProgressStages.OSStart)
+function stateText(value) {
+  if (value === undefined || value === null) return '--';
+  if (typeof value === 'string') return value.split('.').pop();
+  return String(value);
+}
+
+export default {
+  data() {
+    return {
+      values: {},
+      loading: true,
+      timer: null,
+    };
+  },
+  computed: {
+    fields() {
+      return [
+        { key: 'name', label: this.$t('pageSensors.table.name') },
+        {
+          key: 'description',
+          label: this.$t('pageSensors.discrete.description'),
+        },
+        { key: 'state', label: this.$t('pageSensors.discrete.state') },
+      ];
+    },
+    rows() {
+      return SENSORS.map((sensor) => ({
+        name: sensor.name,
+        description: this.$t('pageSensors.discrete.' + sensor.descriptionKey),
+        state: stateText(this.values[sensor.path]?.[sensor.property]),
+      }));
+    },
+  },
+  created() {
+    this.load();
+    this.timer = setInterval(() => this.load(), REFRESH_MS);
+  },
+  beforeUnmount() {
+    clearInterval(this.timer);
+  },
+  methods: {
+    async load() {
+      const paths = [...new Set(SENSORS.map((sensor) => sensor.path))];
+      const values = {};
+      await Promise.all(
+        paths.map((path) =>
+          api
+            .get(path, { cache: false })
+            .then(({ data }) => {
+              values[path] = data?.data || {};
+            })
+            .catch(() => {
+              values[path] = {};
+            }),
+        ),
+      );
+      this.values = values;
+      this.loading = false;
+    },
+  },
+};
+</script>
