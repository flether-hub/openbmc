From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Mon, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] firmware: keep the update progress when the page is left

The progress bar only lived in the firmware page component, so leaving the page
during an update (for example to shut the host down for a BIOS update) and
coming back showed an empty form.  Remember the running update (the update task
of a BIOS update, the reboot wait of a BMC update) in the session storage of the
tab and resume polling when the page is opened again.

Upstream-Status: Inappropriate [CEB-GNRD board-specific update flow]
---
--- a/src/views/Operations/Firmware/FirmwareFormUpdate.vue
+++ b/src/views/Operations/Firmware/FirmwareFormUpdate.vue
@@ -200,6 +200,41 @@ const BIOS_REGIONS_FILE = 'bios-regions.txt';
 
 const textDecoder = new TextDecoder();
 
+// CEB-GNRD: a running update is remembered (per browser tab) so that the progress
+// bar comes back when the user leaves the firmware page, for example to shut the
+// host down for a BIOS update, and returns to it.
+const RESUME_KEY = 'ceb-gnrd-firmware-update';
+const RESUME_MAX_MS = 60 * 60 * 1000;
+
+function saveResume(state) {
+  try {
+    sessionStorage.setItem(
+      RESUME_KEY,
+      JSON.stringify({ ...state, savedAt: Date.now() }),
+    );
+  } catch (error) {
+    // storage not available: the progress is then lost on leaving the page
+  }
+}
+
+function loadResume() {
+  try {
+    const state = JSON.parse(sessionStorage.getItem(RESUME_KEY));
+    if (state && Date.now() - state.savedAt < RESUME_MAX_MS) return state;
+  } catch (error) {
+    // no (or unreadable) saved state
+  }
+  return null;
+}
+
+function clearResume() {
+  try {
+    sessionStorage.removeItem(RESUME_KEY);
+  } catch (error) {
+    // nothing to remove
+  }
+}
+
