+    // The page was left and opened again while an update is running: show the
+    // progress bar again and continue where the saved state says.
+    resumeUpdate(resume) {
+      this.startLoader();
+      this.progress = {
+        visible: true,
+        purpose: resume.purpose,
+        percent: 0,
+        stage: 'stageVerify',
+        state: 'running',
+        remaining: '',
+      };
+      if (resume.phase === 'task' && resume.taskUri) {
+        this.startPolling(resume.taskUri);
+      } else if (resume.phase === 'reboot') {
+        this.startRebootMonitor(!!resume.seenDown, resume.start);
+      } else {
+        clearResume();
+        this.endLoader();
+        this.progress.visible = false;
+      }
+    },
     finish(success) {
+      clearResume();
       this.stopPolling();
       this.endLoader();
       this.progress.state = success ? 'done' : 'failed';
