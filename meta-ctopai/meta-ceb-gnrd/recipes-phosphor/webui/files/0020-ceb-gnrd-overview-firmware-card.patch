From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Mon, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] overview: firmware card without backup and system firmware version

The firmware card of the overview page showed "Backup version" (--, the board
has a single BMC image) and "Firmware version" (null, the system firmware
version that this board does not provide).  Keep only the running BMC version.

Upstream-Status: Inappropriate [CEB-GNRD board-specific]
---
--- a/src/views/Overview/OverviewFirmware.vue
+++ b/src/views/Overview/OverviewFirmware.vue
@@ -3,19 +3,12 @@
     :title="$t('pageOverview.firmwareInformation')"
     :to="`/operations/firmware`"
   >
+    <!-- CEB-GNRD: no backup image and no system firmware version -->
     <b-row class="mt-3">
       <b-col sm="6">
         <dl>
           <dt>{{ $t('pageOverview.runningVersion') }}</dt>
           <dd>{{ dataFormatter(runningVersion) }}</dd>
-          <dt>{{ $t('pageOverview.backupVersion') }}</dt>
-          <dd>{{ dataFormatter(backupVersion) }}</dd>
-        </dl>
-      </b-col>
-      <b-col sm="6">
-        <dl>
-          <dt>{{ $t('pageOverview.firmwareVersion') }}</dt>
-          <dd>{{ dataFormatter(firmwareVersion) }}</dd>
         </dl>
       </b-col>
     </b-row>
@@ -35,19 +28,9 @@ export default {
   mixins: [DataFormatterMixin],
   computed: {
     ...mapState({
-      server: (state) => state.system.systems[0],
-      backupBmcFirmware() {
-        return this.$store.getters['firmware/backupBmcFirmware'];
-      },
-      backupVersion() {
-        return this.backupBmcFirmware?.version;
-      },
       activeBmcFirmware() {
         return this.$store.getters[`firmware/activeBmcFirmware`];
       },
-      firmwareVersion() {
-        return this.server?.firmwareVersion;
-      },
       runningVersion() {
         return this.activeBmcFirmware?.version;
       },
