From 0000000000000000000000000000000000000021 Mon Sep 17 00:00:00 2001
From: CEB-GNRD platform <ceb-gnrd@localhost>
Date: Mon, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] webui: refresh power state while waiting for server operations

Await reset submission and actively poll Redfish rather than watching a
store value which may never change without manual page refresh. Release
the busy flag on success, HTTP error or explicit timeout; report failures.
GracefulRestart must observe departure from On before accepting On again.
ForceRestart need not drop chassis power; its fresh On state unlocks power
controls without claiming that POST or OS boot completed.

Base: webui-vue 8538dca185982882a0d72986f45c6a76c18b4048
Upstream-Status: Pending [power-operation status refresh]
---
diff --git a/src/store/modules/Operations/ControlStore.js b/src/store/modules/Operations/ControlStore.js
--- a/src/store/modules/Operations/ControlStore.js
+++ b/src/store/modules/Operations/ControlStore.js
@@ -1,31 +1,31 @@
 import api from '@/store/api';
 import i18n from '@/i18n';
 
-/**
- * Watch for serverStatus changes in GlobalStore module
- * to set isOperationInProgress state
- * Stop watching status changes and resolve Promise when
- * serverStatus value matches passed argument or after 5 minutes
- * @param {string} serverStatus
- * @returns {Promise}
- */
-const checkForServerStatus = function (serverStatus) {
-  return new Promise((resolve) => {
-    const timer = setTimeout(() => {
-      resolve();
-      unwatch();
-    }, 300000 /*5mins*/);
-    const unwatch = this.watch(
-      (state) => state.global.serverStatus,
-      (value) => {
-        if (value === serverStatus) {
-          resolve();
-          unwatch();
-          clearTimeout(timer);
-        }
-      },
-    );
-  });
+// Actively read Redfish: a Vuex watcher alone cannot refresh PowerState.
+// GracefulRestart on this platform cycles power. Observe Off before accepting
+// On again; an initial On or LastResetTime change is not completion evidence.
+const checkForServerStatus = async function (context, systemPath, resetType, initial) {
+  const target = ['ForceOff', 'GracefulShutdown'].includes(resetType) ? 'Off' : 'On';
+  const deadline = Date.now() + 330000;
+  let transitioned = initial.PowerState !== target;
+  while (Date.now() < deadline) {
+    await new Promise((resolve) => setTimeout(resolve, 1000));
+    let response;
+    try {
+      response = await api.get(systemPath, { timeout: 10000 });
+    } catch (error) {
+      if ([401, 403].includes(error.response?.status)) throw error;
+      console.log(error);
+      continue;
+    }
+    const { PowerState, Status: { State } = {}, LastResetTime } = response.data;
+    context.commit('global/setServerStatus',
+      ['Quiesced', 'InTest'].includes(State) ? State : PowerState, { root: true });
+    if (LastResetTime) context.commit('setLastPowerOperationTime', new Date(LastResetTime));
+    if (PowerState !== target) transitioned = true;
+    if (PowerState === target && (resetType !== 'GracefulRestart' || transitioned)) return;
+  }
+  throw new Error('Power operation timed out. Check the server status before retrying.');
 };
 
 const ControlStore = {
