-      dispatch('serverPowerChange', data);
-      await checkForServerStatus.bind(this, 'off')();
-      commit('setOperationInProgress', false);
-      dispatch('getLastPowerOperationTime');
+    serverSoftPowerOff({ dispatch }) {
+      return dispatch('serverPowerChange', { ResetType: 'GracefulShutdown' });
     },
-    async serverHardPowerOff({ dispatch, commit }) {
-      const data = { ResetType: 'ForceOff' };
-      dispatch('serverPowerChange', data);
-      await checkForServerStatus.bind(this, 'off')();
-      commit('setOperationInProgress', false);
-      dispatch('getLastPowerOperationTime');
+    serverHardPowerOff({ dispatch }) {
+      return dispatch('serverPowerChange', { ResetType: 'ForceOff' });
     },
-    async serverPowerChange({ commit }, data) {
-      commit('setOperationInProgress', true);
-      api
-        .post(
-          `${await this.dispatch('global/getSystemPath')}/Actions/ComputerSystem.Reset`,
-          data,
-        )
-        .catch((error) => {
-          console.log(error);
-          commit('setOperationInProgress', false);
-        });
+    async serverPowerChange(context, data) {
+      if (context.state.isOperationInProgress) return;
+      context.commit('setOperationInProgress', true);
+      try {
+        const systemPath = await this.dispatch('global/getSystemPath');
+        if (!systemPath) throw new Error('Server power control is unavailable.');
+        const initial = (await api.get(systemPath, { timeout: 10000 })).data;
+        await api.post(`${systemPath}/Actions/ComputerSystem.Reset`, data, { timeout: 10000 });
+        // ForceRestart may leave PowerState On throughout its reset pulse.
+        // This refreshes power controls; it does not attest BIOS/OS boot success.
+        await checkForServerStatus.call(this, context, systemPath, data.ResetType, initial);
+      } finally {
+        context.commit('setOperationInProgress', false);
+      }
     },
   },
 };
