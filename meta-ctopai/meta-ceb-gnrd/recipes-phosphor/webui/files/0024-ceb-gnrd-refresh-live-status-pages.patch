diff --git a/src/components/Mixins/LiveRefreshMixin.js b/src/components/Mixins/LiveRefreshMixin.js
new file mode 100644
--- /dev/null
+++ b/src/components/Mixins/LiveRefreshMixin.js
@@ -0,0 +1,79 @@
+// Refresh read-only state without reloading routes or resetting forms.
+// Share outstanding reads when header and page use the same Vuex action.
+const pendingReads = new WeakMap();
+
+function readAction(store, action) {
+  let pending = pendingReads.get(store);
+  if (!pending) {
+    pending = new Map();
+    pendingReads.set(store, pending);
+  }
+  if (!pending.has(action)) {
+    const request = store.dispatch(action).finally(() => pending.delete(action));
+    pending.set(action, request);
+  }
+  return pending.get(action);
+}
+
+export default function createLiveRefreshMixin(actions, interval = 10000) {
+  return {
+    data() {
+      return {
+        liveRefreshTimer: null,
+        liveRefreshRunning: false,
+        liveRefreshStopped: false,
+        liveVisibilityHandler: null,
+      };
+    },
+    mounted() {
+      this.liveVisibilityHandler = () => {
+        clearTimeout(this.liveRefreshTimer);
+        if (!document.hidden) this.refreshLiveData();
+      };
+      document.addEventListener('visibilitychange', this.liveVisibilityHandler);
+      this.scheduleLiveRefresh();
+    },
+    beforeUnmount() {
+      this.liveRefreshStopped = true;
+      clearTimeout(this.liveRefreshTimer);
+      document.removeEventListener('visibilitychange', this.liveVisibilityHandler);
+    },
+    methods: {
+      scheduleLiveRefresh() {
+        clearTimeout(this.liveRefreshTimer);
+        if (!this.liveRefreshStopped && !document.hidden) {
+          this.liveRefreshTimer = setTimeout(() => this.refreshLiveData(), interval);
+        }
+      },
+      async refreshLiveData() {
+        if (this.liveRefreshStopped || this.liveRefreshRunning) return;
+        // Preserve row identity while selecting, confirming, or saving.
+        if (
+          document.hidden || this.isBusy || this.isSaving ||
+          this.selectedRows?.length ||
+          document.querySelector(
+            '.modal.show, [role="dialog"][aria-modal="true"], tr[aria-selected="true"]',
+          )
+        ) {
+          this.scheduleLiveRefresh();
+          return;
+        }
+        this.liveRefreshRunning = true;
+        try {
+          if (typeof actions === 'function') {
+            await actions.call(this);
+          } else {
+            await Promise.allSettled(
+              actions.map((action) => readAction(this.$store, action)),
+            );
+          }
+        } catch (error) {
+          console.warn('Live state refresh failed:', error);
+        } finally {
+          this.liveRefreshRunning = false;
+          this.scheduleLiveRefresh();
+        }
+      },
+    },
+  };
+}
