+    async withBmcSelection(file) {
+      if (this.bmcRegions.some((region) => region.selected && region.warning && !region.confirmed)) {
+        throw new Error(this.$t('pageFirmware.bmcPartitions.confirmTitle'));
+      }
+      const tar = await readTar(file);
+      const parts = tar.entries
