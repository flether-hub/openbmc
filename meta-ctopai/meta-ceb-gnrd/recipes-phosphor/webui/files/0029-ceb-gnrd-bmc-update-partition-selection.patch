+      return new File([
+        ...parts, ...tarEntry(BMC_REGIONS_FILE, 'version=1\n' + names.join('\n') + '\n'),
+        new Uint8Array(1024),
+      ], file.name, { type: 'application/x-tar' });
+    },
+    onBmcRegionToggle(region, event) {
+      region.confirmed = false;
+      if (event.target.checked && region.warning) {
+        event.target.checked = false;
+        this.bmcConfirm = { show: true, name: region.name, warning: region.warning };
+      } else {
+        region.selected = event.target.checked;
+      }
