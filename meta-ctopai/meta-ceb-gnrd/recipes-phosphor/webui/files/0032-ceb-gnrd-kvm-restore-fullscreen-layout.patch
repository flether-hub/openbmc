-  <div :class="marginClass">
+  <div class="kvm-console" :class="marginClass">
     <div ref="toolbar" class="kvm-toolbar">
       <b-row class="d-flex">
         <b-col class="d-flex flex-column justify-content-end" cols="4">
@@ -12,7 +12,7 @@
           </dl>
         </b-col>
 
