       status: Connecting,
       convasRef: null,
-      resizeKvmWindow: null,
+      fullscreenFrame: null,
     };
   },
   computed: {
@@ -119,21 +118,40 @@
   },
   mounted() {
     this.openTerminal();
+    document.addEventListener('fullscreenchange', this.onFullScreenChange);
   },
   beforeUnmount() {
-    window.removeEventListener('resize', this.resizeKvmWindow);
+    document.removeEventListener('fullscreenchange', this.onFullScreenChange);
+    if (this.fullscreenFrame !== null) {
+      window.cancelAnimationFrame(this.fullscreenFrame);
+    }
     this.closeTerminal();
   },
   methods: {
     sendCtrlAltDel() {
       this.rfb.sendCtrlAltDel();
     },
-    toggleFullScreen() {
-      if (document.fullscreenElement) {
-        document.exitFullscreen();
-      } else {
-        this.$refs.panel.requestFullscreen?.();
-      }
+    async toggleFullScreen() {
+      try {
+        if (document.fullscreenElement === this.$refs.panel) {
+          await document.exitFullscreen();
+        } else {
+          await this.$refs.panel.requestFullscreen?.();
+        }
+      } catch (error) {
+        console.warn('Unable to change KVM fullscreen mode', error);
+      }
+    },
+    onFullScreenChange() {
+      // Esc also exits fullscreen. Wait for the normal layout to be restored
+      // before notifying noVNC's viewport resize handler.
+      if (this.fullscreenFrame !== null) {
+        window.cancelAnimationFrame(this.fullscreenFrame);
+      }
+      this.fullscreenFrame = window.requestAnimationFrame(() => {
+        this.fullscreenFrame = null;
+        window.dispatchEvent(new Event('resize'));
+      });
     },
     captureScreenshot() {
       const canvas = this.$refs.panel.querySelector('canvas');
