     this.$store.dispatch('system/getSystem').finally(() => {
       // Emit initial data fetch complete to parent component
       eventBus.$emit('hardware-status-service-complete');
     });
   },
   methods: {
+    async loadIntrusion() {
+      try {
+        const response = await api.get(`${intrusionPath}/attr/Enabled`);
+        if (typeof response.data.data !== 'boolean') {
+          throw new Error('Invalid state');
+        }
+        this.intrusionEnabled = response.data.data;
+        this.intrusionSaved = this.intrusionEnabled;
+        this.intrusionLoaded = true;
+      } catch {
+        this.intrusionLoaded = false;
+        this.errorToast(this.$t('pageInventory.intrusion.loadError'));
+      }
+    },
+    async toggleIntrusion(state) {
+      if (!this.intrusionLoaded || this.intrusionSaving) return;
+      this.intrusionSaving = true;
+      try {
+        const method = state ? 'Enable' : 'Disable';
+        await api.post(`${intrusionPath}/action/${method}`, { data: [] });
+        await this.loadIntrusion();
+        if (!this.intrusionLoaded || this.intrusionSaved !== state) {
+          throw new Error('Chassis intrusion state was not applied');
+        }
+        this.successToast(this.$t('pageInventory.intrusion.saved'));
+      } catch {
+        this.intrusionEnabled = this.intrusionSaved;
+        this.errorToast(this.$t('pageInventory.intrusion.saveError'));
+        // A lost response may follow a successful write. Read back the BMC state.
+        await this.loadIntrusion();
+      } finally {
+        this.intrusionSaving = false;
+      }
+    },
