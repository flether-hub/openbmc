Subject: [PATCH] webui: show BIOS boot checkpoints and raw POST codes

Keep the standard boot-progress enum and show board checkpoint details.
Generic AMI mappings are explicitly marked; unknown codes remain visible.
No checkpoint is interpreted as an OS-running confirmation.

Upstream-Status: Inappropriate [CEB-GNRD boot checkpoints]

--- a/src/views/HardwareStatus/Sensors/DiscreteSensors.vue
+++ b/src/views/HardwareStatus/Sensors/DiscreteSensors.vue
@@ -64,7 +64,7 @@
       return SENSORS.map((sensor) => ({
         name: sensor.name,
         description: this.$t('pageSensors.discrete.' + sensor.descriptionKey),
-        state: stateText(this.values[sensor.path]?.[sensor.property]),
+        state: this.sensorState(sensor),
       }));
     },
   },
@@ -76,6 +76,22 @@
     clearInterval(this.timer);
   },
   methods: {
+    sensorState(sensor) {
+      const data = this.values[sensor.path] || {};
+      const stage = stateText(data[sensor.property]);
+      if (sensor.property !== 'BootProgress' || !data.BootCheckpoint) {
+        return stage;
+      }
+      const key = 'pageSensors.discrete.checkpoints.' + data.BootCheckpoint;
+      const detail = this.$te(key) ? this.$t(key) : data.BootCheckpoint;
+      const code = data.BootPostCode ? ` (${data.BootPostCode})` : '';
+      const generic =
+        data.BootPostCode &&
+        !['Unknown', 'PlatformSpecific'].includes(data.BootCheckpoint)
+          ? ` [${this.$t('pageSensors.discrete.checkpoints.generic')}]`
+          : '';
+      return `${stage} — ${detail}${code}${generic}`;
+    },
     async load() {
       const paths = [...new Set(SENSORS.map((sensor) => sensor.path))];
       const values = {};
