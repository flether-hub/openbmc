+} from './NavigationIcons';
 import IconChevronUp from '@carbon/icons-vue/es/chevron--up/16';
 import IconDataBase from '@carbon/icons-vue/es/data--base--alt/16';
 import i18n from '@/i18n';
@@ -17,9 +19,9 @@
