Subject: [PATCH] ceb-gnrd: use colored function icons in primary navigation

Use compact local SVG dashboard, log, server, console, gear and shield-lock
icons. Pale backings preserve contrast on both normal and selected rows.
Keep navigation labels, routes, permissions and expansion behavior intact.

Upstream-Status: Inappropriate [CEB-GNRD UI styling]

--- a/src/components/AppNavigation/AppNavigationMixin.js
+++ b/src/components/AppNavigation/AppNavigationMixin.js
@@ -1,9 +1,11 @@
-import IconDashboard from '@carbon/icons-vue/es/dashboard/16';
-import IconTextLinkAnalysis from '@carbon/icons-vue/es/text-link--analysis/16';
-import IconDataCheck from '@carbon/icons-vue/es/data--check/16';
-import IconSettingsAdjust from '@carbon/icons-vue/es/settings--adjust/16';
-import IconSettings from '@carbon/icons-vue/es/settings/16';
-import IconSecurity from '@carbon/icons-vue/es/security/16';
+import {
+  IconDashboard,
