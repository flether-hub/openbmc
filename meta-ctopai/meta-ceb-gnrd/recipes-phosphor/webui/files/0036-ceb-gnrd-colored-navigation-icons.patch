+import { defineComponent, h } from 'vue';
+
+// Decorative SVGs: the adjacent translated navigation label is the accessible
+// name. A pale backing keeps the same colors legible on the selected dark row.
+function navigationIcon(name, background, shapes) {
+  return defineComponent({
+    name,
+    setup() {
+      return () =>
+        h(
+          'svg',
+          {
+            xmlns: 'http://www.w3.org/2000/svg',
+            viewBox: '0 0 24 24',
+            width: 24,
+            height: 24,
+            'aria-hidden': 'true',
+            focusable: 'false',
+            style: { fill: 'none', flexShrink: 0 },
+          },
+          [
+            h('rect', { x: 0, y: 0, width: 24, height: 24, rx: 5, fill: background }),
+            ...shapes.map(([tag, attributes]) => h(tag, attributes)),
+          ],
+        );
+    },
+  });
+}
+
+export const IconDashboard = navigationIcon('NavigationDashboard', '#e7efff', [
+  ['rect', { x: 4, y: 4, width: 16, height: 16, rx: 2, fill: '#2563c9' }],
+  ['rect', { x: 6, y: 6, width: 5, height: 5, rx: 1, fill: '#ffffff' }],
+  ['rect', { x: 13, y: 6, width: 5, height: 3, rx: 1, fill: '#8fc7ff' }],
+  ['rect', { x: 6, y: 13, width: 5, height: 5, rx: 1, fill: '#8fc7ff' }],
+  ['path', { d: 'M13 17v-5m3 5v-7m2 7v-4', stroke: '#ffffff', 'stroke-width': 1.5 }],
+]);
+
+export const IconLogs = navigationIcon('NavigationLogs', '#fff0d9', [
+  ['path', { d: 'M6 3h9l4 4v14H6z', fill: '#b75c0b' }],
+  ['path', { d: 'M15 3v5h4', fill: '#ffc36b' }],
+  ['path', { d: 'M10 11h6m-6 4h6m-6 4h4', stroke: '#ffffff', 'stroke-width': 1.5, 'stroke-linecap': 'round' }],
+  ['circle', { cx: 8, cy: 11, r: 0.7, fill: '#ffdca0' }],
+  ['circle', { cx: 8, cy: 15, r: 0.7, fill: '#ffdca0' }],
+  ['circle', { cx: 8, cy: 19, r: 0.7, fill: '#ffdca0' }],
+]);
+
+export const IconHardware = navigationIcon('NavigationHardware', '#def4e8', [
+  ['rect', { x: 4, y: 4, width: 16, height: 7, rx: 2, fill: '#19804c' }],
+  ['rect', { x: 4, y: 13, width: 16, height: 7, rx: 2, fill: '#19804c' }],
+  ['path', { d: 'M7 7.5h6M7 16.5h6', stroke: '#ffffff', 'stroke-width': 1.5, 'stroke-linecap': 'round' }],
+  ['circle', { cx: 17, cy: 7.5, r: 1, fill: '#9bf0be' }],
+  ['circle', { cx: 17, cy: 16.5, r: 1, fill: '#9bf0be' }],
+]);
+
+export const IconOperations = navigationIcon('NavigationOperations', '#f0e7ff', [
