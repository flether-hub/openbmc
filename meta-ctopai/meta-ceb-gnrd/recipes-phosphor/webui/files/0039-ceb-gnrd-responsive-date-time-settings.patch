+function isNtpTimeConflict(error) {
+  const data = error?.response?.data;
+  const messages = data?.error?.['@Message.ExtendedInfo'] ||
+    data?.['@Message.ExtendedInfo'] || [];
+  return messages.some((message) =>
+    message.MessageId?.endsWith('.PropertyValueConflict') &&
+    message.MessageArgs?.includes('DateTime') &&
+    message.MessageArgs?.some((arg) => arg.includes('NTPProtocolEnabled')),
+  );
