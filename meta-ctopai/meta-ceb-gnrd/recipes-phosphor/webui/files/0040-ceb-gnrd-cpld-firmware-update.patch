--- /dev/null
+++ b/src/views/Operations/Firmware/FirmwareCpldUpdate.vue
@@ -0,0 +1,190 @@
+<template>
+  <page-section :section-title="$t('pageCpld.title')">
+    <b-row>
+      <b-col xl="10">
+        <alert variant="warning">
+          {{ $t('pageCpld.shutdownWarning') }}
+        </alert>
+        <div class="form-background p-3">
+          <b-form @submit.prevent="start">
+            <b-form-group :label="$t('pageCpld.image')" label-for="cpld-image" class="mb-3">
+              <form-file id="cpld-image" accept=".bit" :model-value="file"
+                :disabled="disabled || busy || submitting"
+                @update:model-value="selectFile" />
+            </b-form-group>
+            <b-button variant="primary" type="submit"
+              :disabled="disabled || busy || submitting || !file || !status.ready">
+              {{ $t('pageCpld.start') }}
+            </b-button>
+            <b-button v-if="status.phase === 'WaitingForHostOff'" class="ms-2"
+              :disabled="disabled" @click="cancel">
+              {{ $t('pageCpld.cancel') }}
+            </b-button>
+          </b-form>
+        </div>
+        <p v-if="error" class="text-danger mt-3" role="alert">{{ error }}</p>
+        <div v-if="status.job || pending" class="mt-4" aria-live="polite">
+          <p class="fw-bold">{{ $t(`pageCpld.phases.${status.phase || 'Preflight'}`) }}</p>
+          <b-progress :value="status.progress || 0" :max="100" show-progress
+            :variant="status.phase === 'Failed' ? 'danger' : status.phase === 'Completed' ? 'success' : 'primary'" />
+          <p class="mt-2">{{ status.detail }}</p>
+          <p v-if="status.phase === 'Verifying'">{{ $t('pageCpld.verifyHint') }}</p>
+          <p v-if="pending && !pending.expired">
+            {{ $t('pageCpld.remaining', { seconds: remainingSeconds }) }}
+          </p>
+          <p v-if="disconnected">
+            {{ $t('pageCpld.connectionLost') }}
+          </p>
+          <p v-if="status.sha256" class="small text-break">SHA256: {{ status.sha256 }}</p>
+          <p v-if="status.phase === 'Completed'">{{ $t('pageCpld.completed') }}</p>
+          <alert v-if="status.phase === 'Completed'" variant="warning">
+            {{ $t('pageCpld.activationWarning') }}
+          </alert>
+        </div>
+      </b-col>
+    </b-row>
+  </page-section>
+</template>
+
+<script>
+import api from '@/store/api';
+import Alert from '@/components/Global/Alert';
+import FormFile from '@/components/Global/FormFile';
+import PageSection from '@/components/Global/PageSection';
+
+const path = '/xyz/openbmc_project/software/cpld_update';
+const storageKey = 'ceb-gnrd-cpld-update';
+const active = ['WaitingForHostOff', 'Preflight', 'Erasing', 'Writing', 'Verifying'];
+
+export default {
+  components: { Alert, FormFile, PageSection },
+  props: { disabled: { type: Boolean, default: false } },
+  emits: ['busy-change'],
+  data() {
+    return { file: null, status: {}, loaded: false, submitting: false,
+      error: '', disconnected: false, pending: null, timer: null, disposed: false, now: Date.now() };
+  },
+  computed: {
+    busy() { return this.submitting || !!this.pending || active.includes(this.status.phase); },
+    remainingSeconds() { return this.pending ? Math.max(0, Math.ceil((this.pending.deadline - this.now) / 1000)) : 0; },
+  },
+  watch: {
+    busy: { immediate: true, handler(value) { this.$emit('busy-change', value); } },
+  },
+  mounted() {
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved.deadline === 'number' && Number.isFinite(saved.deadline) &&
+          typeof saved.job === 'string' && typeof saved.bootId === 'string') this.pending = saved;
+    } catch { /* Ignore invalid browser storage. */ }
+    this.poll();
+  },
+  beforeUnmount() {
+    this.disposed = true;
+    clearTimeout(this.timer);
+  },
+  methods: {
+    requestError(error, fallback) {
+      const body = error.response?.data;
+      // D-Bus REST places the error name under data.description and the
+      // human-readable D-Bus exception text in message (not description).
+      const message = body?.message;
+      if (typeof message === 'string' && message && !/^\d{3}(?:\s|$)/.test(message)) {
+        return message;
+      }
+      return body?.data?.description || body?.description ||
+        body?.error?.['@Message.ExtendedInfo']?.[0]?.Message ||
+        body?.error?.message || this.$t(fallback);
+    },
+    selectFile(file) {
+      this.file = null;
+      this.error = '';
+      if (!file) return;
+      if (!file.name.toLowerCase().endsWith('.bit') || file.size > 1048576) {
+        this.error = this.$t('pageCpld.invalidFile');
+        return;
+      }
+      this.file = file;
+    },
+    remember(value) {
+      this.pending = value;
+      try {
+        if (value) localStorage.setItem(storageKey, JSON.stringify(value));
+        else localStorage.removeItem(storageKey);
+      } catch { /* Server retains the job even when browser storage is unavailable. */ }
+    },
+    async start() {
+      if (!this.file || this.busy || this.disabled || !this.status.ready) return;
+      this.submitting = true;
+      this.error = '';
+      try {
+        const encoded = await new Promise((resolve, reject) => {
+          const reader = new FileReader();
+          reader.onload = () => resolve(String(reader.result).split(',')[1]);
+          reader.onerror = reject;
+          reader.readAsDataURL(this.file);
+        });
+        // Record before POST: a dropped HTTP response must not trigger a retry.
+        this.remember({ deadline: Date.now() + 600000, previousJob: this.status.job || '',
+          bootId: this.status.currentBootId, job: '' });
+        const response = await api.post(`${path}/action/Start`, { data: [encoded] }, { timeout: 10000 });
+        const returned = response.data?.data;
+        const job = Array.isArray(returned) ? returned[0] : returned;
+        if (typeof job === 'string' && this.pending) this.remember({ ...this.pending, job });
+      } catch (error) {
+        if (error.response) {
+          this.remember(null);
+          this.error = this.requestError(error, 'pageCpld.startFailed');
+        } else {
+          this.disconnected = true;
+          this.error = this.$t('pageCpld.unknownResponse');
+        }
+      } finally {
+        this.submitting = false;
+      }
+    },
+    async cancel() {
+      try {
+        await api.post(`${path}/action/Cancel`, { data: [] }, { timeout: 5000 });
+      } catch (error) { this.error = this.requestError(error, 'pageCpld.cancelFailed'); }
+    },
+    async poll() {
+      try {
+        const response = await api.get(path, { timeout: 4000, cache: false });
+        const next = JSON.parse(response.data.data.Status);
+        this.status = next;
+        this.loaded = true;
+        if (this.error === this.$t('pageCpld.unavailable') ||
+            this.error === this.$t('pageCpld.unknownResponse')) this.error = '';
+        this.disconnected = false;
+        if (this.pending) {
+          const same = this.pending.job ? next.job === this.pending.job :
+            !!next.job && next.job !== this.pending.previousJob;
+          if (same && !this.pending.job) this.remember({ ...this.pending, job: next.job });
+          if (same && ['Failed', 'Cancelled'].includes(next.phase)) this.remember(null);
+          if (same && next.phase === 'Completed' && next.flashVerified) {
+            this.remember(null);
+            this.error = '';
+          }
+        } else if (active.includes(next.phase)) {
+          // Reopened page without local state: resume the server's existing job.
+          this.remember({ job: next.job, bootId: next.bootId,
+            previousJob: '', deadline: Date.now() + Math.min(600, Math.max(0, next.remainingSeconds || 0)) * 1000 });
+        }
+      } catch {
+        this.disconnected = true;
+        if (!this.pending) this.error = this.$t('pageCpld.unavailable');
+      }
+      this.now = Date.now();
+      if (this.pending && !this.pending.expired && this.now >= this.pending.deadline) {
+        this.error = this.$t('pageCpld.timeout');
+        // Keep the original deadline across reconnects; never rearm 10 minutes.
+        this.remember({ ...this.pending, expired: true });
+      }
+      if (this.pending?.expired && this.loaded && !this.disconnected &&
+          !active.includes(this.status.phase)) this.remember(null);
+      if (!this.disposed) this.timer = setTimeout(() => this.poll(), 3000);
+    },
+  },
+};
+</script>
