+import catalog from '@/data/amiAptioVPostCodes.json';
+
+// Redfish renders the complete POST byte vector as hex. Do not truncate an
+// unknown or multi-byte value into a different, seemingly recognized code.
+function codeKey(value) {
+  if (typeof value === 'number') {
+    if (!Number.isInteger(value) || value < 0 || value > 0xff) return null;
+    return value.toString(16).toUpperCase().padStart(2, '0');
+  }
+  if (typeof value !== 'string') return null;
+  const match = value.trim().match(/^(?:0x)?([0-9a-f]+)$/i);
+  if (!match) return null;
+  const hex = match[1].replace(/^0+/, '') || '0';
+  if (hex.length > 2) return null;
+  return hex.toUpperCase().padStart(2, '0');
+}
+
+function definition(key) {
+  if (!key) return null;
+  if (catalog.codes[key]) return catalog.codes[key];
+  return (
+    catalog.ranges.find((range) => key >= range.first && key <= range.last) ||
+    null
+  );
+}
+
+export function describePostCode(value, locale = 'en-US') {
+  const language = String(locale).startsWith('zh') ? 'zh' : 'en';
+  const key = codeKey(value);
+  const entry = definition(key);
+  const unmatched = catalog.unmatched[language];
+  let text = unmatched;
+  if (entry) {
+    const error =
+      entry.kind === 'error' ? (language === 'zh' ? ' 错误' : ' error') : '';
+    text = `${entry.phase}${error}: ${entry.description[language]}`;
+    if (['reserved', 'oem'].includes(entry.kind)) text += `; ${unmatched}`;
+  }
+  // The reference gives two meanings for some values. History has no reliable
+  // firmware-phase context, so retain both instead of guessing from the value.
+  const acpi = key && catalog.acpi[key];
+  if (acpi && entry?.phase !== 'ACPI/ASL') {
+    const or = language === 'zh' ? '或' : 'or';
+    text += `; ${or} ACPI/ASL: ${acpi.description[language]}`;
+  }
+  return text;
+}
