+export function describePostCodeLogs(rows, locale) {
+  const groups = new Map();
+  const descriptions = new Map();
+  for (const row of rows) {
+    descriptions.set(row, describePostCode(row.postCode, locale));
+    const cycle = Number(row.bootCount);
+    if (
+      !Number.isInteger(cycle) ||
+      cycle < 1 ||
+      !Number.isInteger(row.index) ||
+      row.index < 0
+    )
+      continue;
+    if (!groups.has(cycle)) groups.set(cycle, []);
+    groups.get(cycle).push(row);
+  }
+  for (const group of groups.values()) {
+    // Store index follows API receive order within each cycle. Never use
+    // the table's newest-first order, display sort, or second-resolution date.
+    const indexes = new Set(group.map((row) => row.index));
+    if (indexes.size !== group.length) continue;
+    const state = {
+      memoryPending: false,
+      handoff: false,
+      s3: false,
+      lateBoot: false,
+    };
+    for (const row of [...group].sort((a, b) => a.index - b.index)) {
+      const context = consumeContext(state, codeKey(row.postCode));
+      descriptions.set(row, describePostCode(row.postCode, locale, context));
+    }
+  }
+  return rows.map((row) => ({ ...row, description: descriptions.get(row) }));
+}
