Subject: [PATCH] firmware: disable update until a package is selected and show formats

Upstream-Status: Inappropriate [CEB-GNRD firmware packages]

--- a/src/views/Operations/Firmware/FirmwareFormUpdate.vue
+++ b/src/views/Operations/Firmware/FirmwareFormUpdate.vue
@@ -21,6 +21,10 @@
               </b-form-invalid-feedback>
             </template>
           </form-file>
+          <b-form-text id="image-file-help-block">
+            {{ $t('pageFirmware.bmcPartitions.bmcFileFormat') }}<br />
+            {{ $t('pageFirmware.bmcPartitions.biosFileFormat') }}
+          </b-form-text>
         </b-form-group>
 
         <div v-if="bmcRegions.length" class="mb-3">
@@ -91,6 +95,7 @@
           variant="primary"
           :disabled="
             isPageDisabled ||
+            !file || !filePurpose ||
             inspectingPackage || !!packageError || bmcConfirm.show ||
             isUpdateRunning ||
             (biosRegions.length > 0 && !selectedRegionNames.length)
@@ -457,7 +462,12 @@
   },
   methods: {
     async updateFirmware() {
-      if (this.inspectingPackage || this.packageError || !this.file) return;
+      if (
+        this.inspectingPackage ||
+        this.packageError ||
+        !this.file ||
+        !this.filePurpose
+      ) return;
       let image = this.file;
       try {
         if (this.filePurpose === 'BMC') {
@@ -855,7 +865,14 @@
     },
     onSubmitUpload() {
       this.v$.$touch();
-      if (this.v$.$invalid || this.inspectingPackage || this.packageError || this.bmcConfirm.show) return;
+      if (
+        !this.file ||
+        !this.filePurpose ||
+        this.v$.$invalid ||
+        this.inspectingPackage ||
+        this.packageError ||
+        this.bmcConfirm.show
+      ) return;
       this.showUpdateModal = true;
     },
     onFileUpload(file) {
