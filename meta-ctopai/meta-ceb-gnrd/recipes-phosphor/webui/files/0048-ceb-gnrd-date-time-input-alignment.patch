Subject: [PATCH] date-time: align manual inputs and separate timezone text

Upstream-Status: Inappropriate [CEB-GNRD settings layout]

--- a/src/views/Settings/DateTime/DateTime.vue
+++ b/src/views/Settings/DateTime/DateTime.vue
@@ -28,7 +28,8 @@
           <dl>
             <dt>{{ $t('pageDateTime.form.time.label') }}</dt>
             <dd v-if="bmcTime">
-              {{ $filters.formatTime(bmcTime) }}
+              {{ $filters.formatTime(bmcTime).slice(0, 8) }}
+              <small class="d-block text-muted">{{ timezone }}</small>
             </dd>
             <dd v-else>--</dd>
           </dl>
@@ -49,7 +50,7 @@
           >
             {{ $t('pageDateTime.form.manual') }}
           </b-form-radio>
-          <b-row class="mt-3 ms-3">
+          <b-row class="mt-3 ms-3 mb-3">
             <b-col sm="6" lg="4" xl="3">
               <b-form-group
                 :label="$t('pageDateTime.form.date')"
@@ -79,11 +80,7 @@
             </b-col>
             <b-col sm="6" lg="4" xl="3">
               <b-form-group
-                :label="
-                  $t('pageDateTime.form.time.timezone', {
-                    timezone,
-                  })
-                "
+                :label="$t('pageDateTime.form.time.label')"
                 label-for="input-manual-time"
               >
                 <b-form-text id="time-format-help">HH:MM</b-form-text>
@@ -91,6 +88,7 @@
                   <b-form-input
                     id="input-manual-time"
                     v-model="form.manual.time"
+                    aria-describedby="time-format-help manual-timezone-help"
                     :state="getValidationState(v$.form.manual.time)"
                     :disabled="ntpOptionSelected"
                     data-test-id="dateTime-input-manualTime"
@@ -105,6 +103,9 @@
                     </div>
                   </b-form-invalid-feedback>
                 </b-input-group>
+                <b-form-text id="manual-timezone-help" class="mt-2">
+                  {{ timezone }}
+                </b-form-text>
               </b-form-group>
             </b-col>
           </b-row>
