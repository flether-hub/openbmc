+              : newDevice.isActive,
+          });
         }
         return {
           ...newDevice,
@@ -57,6 +60,15 @@
       }
     },
     clearDevices(state) {
+      // Stop browser-owned mounts on logout or application teardown, rather
+      // than losing the handles to sockets still serving the local files.
+      for (const device of state.proxyDevices) {
+        if (!device.nbd) continue;
+        device.nbd.socketStarted = () => {};
+        device.nbd.socketClosed = () => {};
+        device.nbd.errorReadingFile = () => {};
+        device.nbd.stop();
+      }
       state.proxyDevices = [];
       state.legacyDevices = [];
     },
