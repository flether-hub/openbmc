Subject: [PATCH] post codes: add scoped troubleshooting advice

Keep the existing GNR-D definitions and sequence interpretation. Add a
permanent information panel and per-row advice only where the
sequence supports the interpretation. Ambiguous and multibyte values do
not acquire an assumed memory fault or slot diagnosis. No boot state or
severity is inferred from the troubleshooting text.

Upstream-Status: Inappropriate [CEB-GNRD POST presentation]

--- a/src/utils/amiPostCodes.js
+++ b/src/utils/amiPostCodes.js
@@ -112,9 +112,28 @@
   return text;
 }
 
+// Advice follows the already-established interpretation. Never turn an
+// ambiguous byte or an old platform table into a GNR-D fault diagnosis.
+function postCodeAdvice(value, locale, context) {
+  const key = codeKey(value);
+  if (!key || context === 'acpi') return '';
+  const language = String(locale).startsWith('zh') ? 'zh' : 'en';
+  const guide = catalog.troubleshooting;
+  let topic;
+  if (context === 'intelMemory' && catalog.intelMemory[key]) {
+    topic = 'memory';
+  } else if (context === 'ami') {
+    // A project MRC definition overrides an overlapping late AMI code too.
+    if (catalog.gnrdCodes?.[key]?.phase === 'Intel MRC') return '';
+    topic = guide.amiAdvice[key];
+  }
+  return guide.advice[topic]?.[language] || '';
+}
+
 export function describePostCodeLogs(rows, locale) {
   const groups = new Map();
   const descriptions = new Map();
+  const advice = new Map();
   for (const row of rows) {
     descriptions.set(row, describePostCode(row.postCode, locale));
     const cycle = Number(row.bootCount);
@@ -137,12 +156,27 @@
     for (const row of [...group].sort((a, b) => a.index - b.index)) {
       const context = consumeContext(state, codeKey(row.postCode));
       descriptions.set(row, describePostCode(row.postCode, locale, context));
+      advice.set(row, postCodeAdvice(row.postCode, locale, context));
     }
   }
-  return rows.map((row) => ({ ...row, description: descriptions.get(row) }));
+  return rows.map((row) => ({
+    ...row,
+    description: descriptions.get(row),
+    troubleshooting: advice.get(row) || '',
+  }));
 }
 
 export function postCodeReadingGuidance(locale) {
   const language = String(locale).startsWith('zh') ? 'zh' : 'en';
   return catalog.readingGuidance[language];
 }
+
+export function postCodeTroubleshootingGuide(locale) {
+  const language = String(locale).startsWith('zh') ? 'zh' : 'en';
+  const guide = catalog.troubleshooting;
+  return {
+    title: guide.title[language],
+    adviceLabel: guide.adviceLabel[language],
+    notes: guide.notes[language],
+  };
+}
