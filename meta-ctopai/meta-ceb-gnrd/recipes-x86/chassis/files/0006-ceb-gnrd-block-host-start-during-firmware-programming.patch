@@ -42,6 +48,43 @@
 
 namespace power_control
 {
+// Hold a shared lock through accepting an On/Reset/Cycle request. BIOS and
+// CPLD take it exclusively before confirming Off and selecting flash access.
+class HostFirmwarePowerGuard
+{
+  public:
+    HostFirmwarePowerGuard()
+    {
+        fd = open("/run/lock/ceb-gnrd-host-flash.lock",
+                  O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+        if (fd < 0 || flock(fd, LOCK_SH | LOCK_NB) != 0)
+        {
+            if (fd >= 0)
+            {
+                close(fd);
+                fd = -1;
+            }
+            throw std::runtime_error("Host start/reset is blocked during firmware programming");
+        }
+        // A failed BIOS detach must survive the updater process exiting.
+        if (access("/run/ceb-gnrd-bios-flash-held", F_OK) == 0 || errno != ENOENT)
+        {
+            close(fd);
+            fd = -1;
+            throw std::runtime_error("BIOS flash ownership requires recovery before host start/reset");
+        }
+    }
+    ~HostFirmwarePowerGuard()
+    {
+        close(fd);
+    }
+    HostFirmwarePowerGuard(const HostFirmwarePowerGuard&) = delete;
+    HostFirmwarePowerGuard& operator=(const HostFirmwarePowerGuard&) = delete;
+
+  private:
+    int fd = -1;
+};
+
