     const std::string marker = "/run/ceb-gnrd-power-restore-host" + host;
+    acRestoreStatePath = std::filesystem::path(marker) / "state.json";
     if (::mkdir(marker.c_str(), 0700) != 0)
     {
         const int error = errno;
-        if (error == EEXIST)
-        {
-            lg2::info("Skipping power restore: AC boot already consumed");
-        }
-        else
+        if (error != EEXIST)
         {
             lg2::error("Cannot claim AC power restore boot: {ERROR}", "ERROR",
                        std::strerror(error));
+            return false;
+        }
+        std::ifstream saved(acRestoreStatePath);
+        if (!saved)
+        {
+            lg2::info("Skipping power restore: legacy consumed AC boot");
+            return false;
+        }
+        acRestoreState = nlohmann::json::parse(saved, nullptr, false);
+        if (!acRestoreState.is_object() ||
+            !acRestoreState.contains("phase") ||
+            !acRestoreState["phase"].is_string() ||
+            !acRestoreState.contains("powerDropped") ||
+            !acRestoreState["powerDropped"].is_boolean() ||
+            (acRestoreState.contains("policy") !=
+             acRestoreState.contains("deadline")) ||
