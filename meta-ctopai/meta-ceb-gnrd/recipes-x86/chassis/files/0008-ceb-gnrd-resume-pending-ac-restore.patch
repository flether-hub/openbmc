@@ -519,6 +556,25 @@ static std::function<void(const Event)> getPowerStateHandler(PowerState state)
 
 static void sendPowerControlEvent(const Event event)
 {
+    // An explicit power action supersedes this boot's delayed automatic one.
+    // AC restore uses its distinct event after recording completion below.
+    switch (event)
+    {
+        case Event::powerButtonPressed:
+        case Event::resetButtonPressed:
+        case Event::powerOnRequest:
+        case Event::powerOffRequest:
+        case Event::powerCycleRequest:
+        case Event::resetRequest:
+        case Event::gracefulPowerOffRequest:
+        case Event::gracefulPowerCycleRequest:
+        case Event::powerOKAssert:
+        case Event::sioPowerGoodAssert:
+            cancelPendingACRestore();
+            break;
+        default:
+            break;
+    }
     std::function<void(const Event)> handler = getPowerStateHandler(powerState);
     if (handler == nullptr)
     {
@@ -624,6 +680,29 @@ static void savePowerState(const PowerState state)
                      std::string{getChassisState(state)});
     });
 }
+static void cancelPendingACRestore()
+{
+    if (acRestorePending())
+    {
+        if (!saveACRestoreState("cancelled"))
+        {
+            // A full /run must not leave an old pending record to replay after
+            // a manual shutdown. Missing state in this existing directory is
+            // treated as consumed, as with the legacy one-shot marker.
+            std::error_code ec;
+            std::filesystem::remove(acRestoreStatePath, ec);
+            if (ec)
+            {
+                lg2::error("Cannot invalidate cancelled AC restore state: {ERROR}",
+                           "ERROR", ec.message());
+            }
+        }
+        // The original pre-AC state is no longer needed after cancellation.
+        // Keep the usual debounce when saving the state for the next AC boot.
+        savePowerState(powerState);
+    }
+}
+
 static void setPowerState(const PowerState state)
 {
     const bool chassisChanged = getChassisState(powerState) != getChassisState(state);
@@ -973,6 +1052,15 @@ void PowerRestoreController::run()
