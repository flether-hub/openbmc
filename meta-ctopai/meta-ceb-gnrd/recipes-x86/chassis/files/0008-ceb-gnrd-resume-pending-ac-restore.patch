+// /run survives this service restarting, but is fresh for each kernel boot.
+// Retain the original policy, boot-relative deadline and pre-AC power state.
+static std::filesystem::path acRestoreStatePath;
+static nlohmann::json acRestoreState;
+
+static bool acRestorePending()
+{
+    return acRestoreState.is_object() &&
+           acRestoreState.value("phase", "") == "pending";
+}
+
+static bool saveACRestoreState(const std::string& phase)
+{
+    // Also suppress the in-process timer if persisting cancellation fails.
+    acRestoreState["phase"] = phase;
+    const auto temporary = acRestoreStatePath.string() + ".tmp";
+    std::ofstream output(temporary, std::ios::trunc);
+    output << acRestoreState.dump() << '\n';
+    output.close();
+    std::error_code ec;
+    if (output)
+    {
+        std::filesystem::rename(temporary, acRestoreStatePath, ec);
+        if (!ec)
+        {
+            return true;
+        }
+    }
+    lg2::error("Cannot save AC restore state {PHASE}; automatic dispatch blocked",
+               "PHASE", phase);
+    return false;
+}
+
+static void cancelPendingACRestore();
+
