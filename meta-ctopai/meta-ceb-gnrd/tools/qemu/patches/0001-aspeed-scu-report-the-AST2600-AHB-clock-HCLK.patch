From bd484b295987658c989b8bba7053d849053dfd3b Mon Sep 17 00:00:00 2001
From: flether-hub <flether@gmail.com>
Date: Mon, 5 Oct 2026 11:14:43 +0800
Subject: [PATCH 1/9] aspeed/scu: report the AST2600 AHB clock (HCLK)

Add aspeed_scu_get_hclk_freq(), which derives HCLK from HPLL and the
AXI/AHB ratio straps in SCU500 the same way the Linux clk-ast2600 driver
does, so that models clocked by HCLK can produce the counts the guest
expects.  Only the AST2600 SCU implements it; others return 0.
---
 hw/misc/aspeed_scu.c         | 45 ++++++++++++++++++++++++++++++++++++
 include/hw/misc/aspeed_scu.h |  3 +++
 2 files changed, 48 insertions(+)

diff --git a/hw/misc/aspeed_scu.c b/hw/misc/aspeed_scu.c
index 5dbf81c..b73b618 100644
--- a/hw/misc/aspeed_scu.c
+++ b/hw/misc/aspeed_scu.c
@@ -267,6 +267,13 @@ uint32_t aspeed_scu_get_apb_freq(AspeedSCUState *s)
     return ASPEED_SCU_GET_CLASS(s)->get_apb(s);
 }
 
+uint32_t aspeed_scu_get_hclk_freq(AspeedSCUState *s)
+{
+    AspeedSCUClass *asc = ASPEED_SCU_GET_CLASS(s);
+
+    return asc->get_hclk ? asc->get_hclk(s) : 0;
+}
+
 static uint32_t aspeed_2400_scu_get_apb_freq(AspeedSCUState *s)
 {
     AspeedSCUClass *asc = ASPEED_SCU_GET_CLASS(s);
@@ -285,6 +292,43 @@ static uint32_t aspeed_2600_scu_get_apb_freq(AspeedSCUState *s)
         / asc->apb_divider;
 }
 
+/*
+ * AXI/AHB ratios selected by SCU500[16,12:11,9:8], as the Linux
+ * clk-ast2600 driver decodes them.
+ */
+static const uint32_t ast2600_a0_axi_ahb_div_table[] = { 2, 2, 3, 5 };
+static const uint32_t ast2600_a1_axi_ahb_div0_tbl[] = { 3, 2, 3, 4 };
+static const uint32_t ast2600_a1_axi_ahb_div1_tbl[] = { 3, 4, 6, 8 };
+static const uint32_t ast2600_a1_axi_ahb200_tbl[] = { 3, 4, 3, 4 };
+
+static uint32_t aspeed_2600_scu_get_hclk_freq(AspeedSCUState *s)
+{
+    AspeedSCUClass *asc = ASPEED_SCU_GET_CLASS(s);
+    uint32_t hpll = asc->calc_hpll(s, s->regs[AST2600_HPLL_PARAM]);
+    uint32_t strap = s->regs[AST2600_HW_STRAP1];
+    uint32_t rev = (s->silicon_rev >> 16) & 0xff;
+    uint32_t divbits = (strap >> 11) & 0x3;
+    uint32_t axi_div = (strap & BIT(16)) ? 1 : 2;
+    uint32_t ahb_div;
+
+    if (rev >= 1) {
+        if (!divbits) {
+            ahb_div = ast2600_a1_axi_ahb200_tbl[(strap >> 8) & 0x3];
+            if (strap & BIT(16)) {
+                ahb_div *= 2;
+            }
+        } else if (strap & BIT(16)) {
+            ahb_div = ast2600_a1_axi_ahb_div1_tbl[divbits];
+        } else {
+            ahb_div = ast2600_a1_axi_ahb_div0_tbl[divbits];
+        }
+    } else {
+        ahb_div = ast2600_a0_axi_ahb_div_table[divbits];
+    }
+
+    return hpll / (axi_div * ahb_div);
+}
+
 static uint32_t aspeed_1030_scu_get_apb_freq(AspeedSCUState *s)
 {
     AspeedSCUClass *asc = ASPEED_SCU_GET_CLASS(s);
@@ -835,6 +879,7 @@ static void aspeed_2600_scu_class_init(ObjectClass *klass, const void *data)
     asc->resets = ast2600_a3_resets;
     asc->calc_hpll = aspeed_2600_scu_calc_hpll;
     asc->get_apb = aspeed_2600_scu_get_apb_freq;
+    asc->get_hclk = aspeed_2600_scu_get_hclk_freq;
     asc->apb_divider = 4;
     asc->nr_regs = ASPEED_AST2600_SCU_NR_REGS;
     asc->clkin_25Mhz = true;
diff --git a/include/hw/misc/aspeed_scu.h b/include/hw/misc/aspeed_scu.h
index c30940a..ce9d44a 100644
--- a/include/hw/misc/aspeed_scu.h
+++ b/include/hw/misc/aspeed_scu.h
@@ -61,6 +61,7 @@ struct AspeedSCUClass {
     const uint32_t *resets;
     uint32_t (*calc_hpll)(AspeedSCUState *s, uint32_t hpll_reg);
     uint32_t (*get_apb)(AspeedSCUState *s);
+    uint32_t (*get_hclk)(AspeedSCUState *s);
     uint32_t apb_divider;
     uint32_t nr_regs;
     bool clkin_25Mhz;
@@ -70,6 +71,8 @@ struct AspeedSCUClass {
 #define ASPEED_SCU_PROT_KEY      0x1688A8A8
 
 uint32_t aspeed_scu_get_apb_freq(AspeedSCUState *s);
+/* AHB (HCLK) frequency in Hz, 0 when the SCU model does not compute it */
+uint32_t aspeed_scu_get_hclk_freq(AspeedSCUState *s);
 
 /*
