 static void aspeed_lpc_set_irq(void *opaque, int irq, int level)
 {
     AspeedLPCState *s = (AspeedLPCState *)opaque;
diff --git a/hw/misc/aspeed_vhub_sim.c b/hw/misc/aspeed_vhub_sim.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/aspeed_vhub_sim.c
@@ -0,0 +1,284 @@
+/* ASPEED AST2600 vHub: real guest UDC, synthetic host USB tokens over QMP.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * USB 2 control, interrupt and bulk endpoints, including IN descriptor DMA.
+ * Isochronous transfers and electrical bus timing are not implemented.
+ */
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/module.h"
+#include "qemu/bswap.h"
+#include "qapi/error.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "system/address-spaces.h"
+#include "qemu/timer.h"
+
+#define TYPE_VHUB_SIM "aspeed.vhub-sim"
+OBJECT_DECLARE_SIMPLE_TYPE(VHubSimState, VHUB_SIM)
+struct VHubSimState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t regs[0x1000 / 4];
+    bool host_connected;
+    char *result;
+};
+#define R(a) ((a) / 4)
+#define PORTS 7
+#define EPS 21
+#define DEV(p) (0x100 + ((p) - 1) * 0x10)
+#define EP(n) (0x200 + (n) * 0x10)
+
+static void vhub_irq(VHubSimState *s)
+{
+    uint32_t irq = s->regs[R(0x0c)] & ~0x1fe00U;
+    unsigned p;
+    for (p = 1; p <= PORTS; p++) {
+        uint32_t d = s->regs[R(DEV(p) + 4)];
+        uint32_t en = s->regs[R(DEV(p))];
+        /* EP0 SETUP, OUT ACK and IN ACK have separate enables. */
+        if (((d & BIT(0)) && (en & BIT(2))) ||
+            ((d & BIT(1)) && (en & BIT(3))) ||
+            ((d & BIT(3)) && (en & BIT(5)))) {
+            irq |= BIT(8 + p);
+        }
+    }
+    if (s->regs[R(0x18)] & s->regs[R(0x10)]) { irq |= BIT(16); }
+    s->regs[R(0x0c)] = irq;
+    qemu_set_irq(s->irq, !!(irq & s->regs[R(0x08)]));
+}
+static uint64_t vhub_read(void *opaque, hwaddr addr, unsigned size)
+{
+    VHubSimState *s = opaque;
+    if (addr == 0x24) {
+        return ((s->regs[R(0)] & BIT(1)) ? 0 : BIT(27)) |
+               ((qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) & 0x7ff) << 16);
+    }
+    return s->regs[R(addr)];
+}
+static void vhub_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    VHubSimState *s = opaque;
+    uint32_t old = s->regs[R(addr)], val = value;
+    unsigned n;
+    if (addr == 0x0c || addr == 0x18 || addr == 0x1c ||
+        (addr >= 0x100 && addr < 0x170 && (addr & 0xf) == 4)) {
+        s->regs[R(addr)] &= ~val;
+    } else if (addr >= 0x200 && addr < 0x350 && (addr & 0xf) == 0xc) {
+        /* CPU updates WPTR; hardware owns RPTR. Single mode owns TX_SIZE too. */
+        if (s->regs[R(addr - 8)] & BIT(0)) {
+            s->regs[R(addr)] = (old & 0xff00) | (val & 0xff);
+        } else {
+            s->regs[R(addr)] = val;
+        }
+    } else {
+        s->regs[R(addr)] = val;
+    }
+    if (addr == 0x20 && val) {
+        if (val & BIT(0)) {
+            memset(&s->regs[R(0x30)], 0, 8);
+        }
+        for (n = 1; n <= PORTS; n++) {
+            if (val & BIT(n)) { memset(&s->regs[R(DEV(n))], 0, 16); }
+        }
+        if (val & BIT(9)) { memset(&s->regs[R(0x200)], 0, EPS * 16); }
+    }
+    if (addr >= 0x200 && addr < 0x350 && (addr & 0xf) == 4 &&
+        (val & BIT(2))) {
+        s->regs[R(addr + 8)] = 0;
+    }
+    /* Plugging the root hub into the host creates a real bus reset interrupt. */
+    if (addr == 0 && !(old & BIT(0)) && (val & BIT(0)) && s->host_connected) {
+        s->regs[R(0x0c)] |= BIT(6);
+    }
+    vhub_irq(s);
+}
+static const MemoryRegionOps vhub_ops = {
+    .read = vhub_read, .write = vhub_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+static bool vhub_get_connected(Object *obj, Error **errp)
+{
+    return VHUB_SIM(obj)->host_connected;
+}
+static void vhub_set_connected(Object *obj, bool value, Error **errp)
+{
+    VHubSimState *s = VHUB_SIM(obj);
+    if (s->host_connected != value && (s->regs[R(0)] & BIT(0))) {
+        s->regs[R(0x0c)] |= value ? BIT(6) : BIT(7);
+    }
+    s->host_connected = value;
+    vhub_irq(s);
+}
+static char *vhub_get_result(Object *obj, Error **errp)
+{
+    return g_strdup(VHUB_SIM(obj)->result ?: "");
+}
+static void vhub_result(VHubSimState *s, const char *status,
+                        const uint8_t *data, size_t len)
+{
+    GString *out = g_string_new(status);
+    unsigned i;
+    for (i = 0; i < len; i++) { g_string_append_printf(out, "%02x", data[i]); }
+    g_free(s->result);
+    s->result = g_string_free(out, false);
+}
+static bool vhub_dma(hwaddr addr, uint8_t *data, size_t len, bool in)
+{
+    return (in ? address_space_read(&address_space_memory, addr,
+                                    MEMTXATTRS_UNSPECIFIED, data, len) :
+                 address_space_write(&address_space_memory, addr,
+                                     MEMTXATTRS_UNSPECIFIED, data, len)) == MEMTX_OK;
+}
+static void vhub_ep0_irq(VHubSimState *s, unsigned p, bool in, bool setup)
+{
+    if (p) {
+        s->regs[R(DEV(p) + 4)] |= setup ? BIT(0) : in ? BIT(3) : BIT(1);
+    } else {
+        s->regs[R(0x0c)] |= setup ? BIT(0) : in ? BIT(3) : BIT(1);
+    }
+    vhub_irq(s);
+}
+/* host-token: setup PORT 0 HEX8 / in PORT ENDPOINT MAXLEN /
+ * out PORT ENDPOINT HEX ("-" denotes a zero-length packet).
+ * Port 0 is the hub, ports 1..7 are the guest's gadget UDCs.
+ * A NAK is left pending in the guest; the host retries rather than faking ACK.
+ */
+static void vhub_token(Object *obj, const char *text, Error **errp)
+{
+    VHubSimState *s = VHUB_SIM(obj);
+    g_auto(GStrv) args = g_strsplit(text, " ", 4);
+    unsigned p, ep, len = 0, n, ctl, base, maxlen;
+    uint8_t data[4096];
+    bool in, setup;
+    if (g_strv_length(args) != 4) {
+        error_setg(errp, "host-token: setup/in/out PORT ENDPOINT DATA/MAXLEN"); return;
+    }
+    p = strtoul(args[1], NULL, 10); ep = strtoul(args[2], NULL, 10);
+    in = !strcmp(args[0], "in"); setup = !strcmp(args[0], "setup");
+    if (p > PORTS || ep > 15 || (!in && !setup && strcmp(args[0], "out"))) {
+        error_setg(errp, "invalid USB token/port/endpoint"); return;
+    }
+    if (!s->host_connected || !(s->regs[R(0)] & BIT(0)) ||
+        (p && !(s->regs[R(DEV(p))] & BIT(0)))) {
+        vhub_result(s, "disconnected", NULL, 0); return;
+    }
+    maxlen = in ? strtoul(args[3], NULL, 10) : sizeof(data);
+    if (in && (!maxlen || maxlen > sizeof(data))) {
+        error_setg(errp, "USB IN maximum must be 1..4096"); return;
+    }
+    if (!in && strcmp(args[3], "-")) {
+        size_t chars = strlen(args[3]);
+        if ((chars & 1) || chars > sizeof(data) * 2) {
+            error_setg(errp, "invalid USB packet size"); return;
+        }
+        for (n = 0; n < chars; n += 2) {
+            int hi = g_ascii_xdigit_value(args[3][n]);
+            int lo = g_ascii_xdigit_value(args[3][n + 1]);
+            if (hi < 0 || lo < 0) { error_setg(errp, "USB packet must be hex"); return; }
+            data[len++] = hi * 16 + lo;
+        }
+    }
+    if (setup) {
+        if (ep || len != 8) { error_setg(errp, "SETUP must be 8 bytes on EP0"); return; }
+        s->regs[R(0x80 + p * 8)] = ldl_le_p(data);
+        s->regs[R(0x84 + p * 8)] = ldl_le_p(data + 4);
+        s->regs[R(p ? DEV(p) + 8 : 0x30)] = 0;
+        vhub_ep0_irq(s, p, false, true);
+        vhub_result(s, "ok:", NULL, 0); return;
+    }
+    if (!ep) {
+        base = p ? DEV(p) + 8 : 0x30;
+        ctl = s->regs[R(base)];
+        if (ctl & BIT(0)) { vhub_result(s, "stall", NULL, 0); return; }
+        if (!(ctl & (in ? BIT(1) : BIT(2)))) { vhub_result(s, "nak", NULL, 0); return; }
+        if (in) { len = (ctl >> 8) & 0x7f; }
+        if (len > 64 || (in && len > maxlen) ||
+            !vhub_dma(s->regs[R(base + 4)], data, len, in)) {
+            vhub_result(s, "error", NULL, 0); return;
+        }
+        s->regs[R(base)] &= ~(in ? BIT(1) : (BIT(2) | (0x7f << 16)));
+        if (!in) { s->regs[R(base)] |= len << 16; }
+        vhub_ep0_irq(s, p, in, false);
+        vhub_result(s, "ok:", in ? data : NULL, in ? len : 0); return;
+    }
+    for (n = 0; n < EPS; n++) {
+        uint32_t cfg = s->regs[R(EP(n))];
+        if ((cfg & BIT(0)) && ((cfg >> 1) & 7) == p &&
+            ((cfg >> 8) & 15) == ep && !!(cfg & BIT(4)) == !in) { break; }
+    }
+    if (n == EPS) { vhub_result(s, "nak", NULL, 0); return; }
+    base = EP(n); ctl = s->regs[R(base + 4)];
+    if (s->regs[R(base)] & BIT(12)) { vhub_result(s, "stall", NULL, 0); return; }
+    if ((ctl & BIT(2)) || ((s->regs[R(base)] >> 5) & 3) == 3) {
+        vhub_result(s, "unsupported", NULL, 0); return;
+    }
+    if (ctl & BIT(0)) {
+        /* The Linux vHub driver only enables descriptor DMA for IN. */
+        uint32_t stat = s->regs[R(base + 12)], words[2];
+        unsigned rptr = (stat >> 8) & 0xff, wptr = stat & 0xff;
+        unsigned mask = (s->regs[R(0)] & BIT(18)) ? 255 : 31;
+        hwaddr desc = s->regs[R(base + 8)] + rptr * 8;
+        if (!in || rptr == wptr) { vhub_result(s, "nak", NULL, 0); return; }
+        if (!vhub_dma(desc, (uint8_t *)words, 8, true)) {
+            vhub_result(s, "error", NULL, 0); return;
+        }
+        len = le32_to_cpu(words[1]) & 0xfff;
+        if (len > maxlen || !vhub_dma(le32_to_cpu(words[0]), data, len, true)) {
+            vhub_result(s, "error", NULL, 0); return;
+        }
+        s->regs[R(base + 12)] = wptr | (((rptr + 1) & mask) << 8);
+        if (le32_to_cpu(words[1]) & BIT(31)) { s->regs[R(0x18)] |= BIT(n); }
+    } else {
+        uint32_t stat = s->regs[R(base + 12)];
+        unsigned packet = (s->regs[R(base)] >> 16) & 0x3ff;
+        if (!packet) { packet = 1024; }
+        if (!(stat & BIT(0))) { vhub_result(s, "nak", NULL, 0); return; }
+        if (in) { len = (stat >> 16) & 0x7ff; }
+        if (len > sizeof(data) || (in && len > maxlen) ||
+            (!in && len > packet) || !vhub_dma(s->regs[R(base + 8)], data, len, in)) {
+            vhub_result(s, "error", NULL, 0); return;
+        }
+        s->regs[R(base + 12)] = len << 16;
+        s->regs[R(0x18)] |= BIT(n);
+    }
+    vhub_irq(s);
+    vhub_result(s, "ok:", in ? data : NULL, in ? len : 0);
+}
+static void vhub_reset(DeviceState *dev)
+{
+    VHubSimState *s = VHUB_SIM(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    vhub_irq(s);
+}
+static void vhub_realize(DeviceState *dev, Error **errp)
+{
+    VHubSimState *s = VHUB_SIM(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &vhub_ops, s, TYPE_VHUB_SIM, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+}
+static void vhub_init(Object *obj)
+{
+    object_property_add_bool(obj, "host-connected", vhub_get_connected, vhub_set_connected);
+    object_property_add_str(obj, "host-token", NULL, vhub_token);
+    object_property_add_str(obj, "host-result", vhub_get_result, NULL);
+}
+static void vhub_finalize(Object *obj) { g_free(VHUB_SIM(obj)->result); }
+static void vhub_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = vhub_realize;
+    dc->desc = "AST2600 USB vHub control/interrupt/bulk software-test model";
+    dc->user_creatable = false;
+    device_class_set_legacy_reset(dc, vhub_reset);
+}
+static const TypeInfo vhub_type = {
+    .name = TYPE_VHUB_SIM, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VHubSimState), .instance_init = vhub_init,
+    .instance_finalize = vhub_finalize, .class_init = vhub_class_init,
+};
+static void vhub_register(void) { type_register_static(&vhub_type); }
+type_init(vhub_register)
