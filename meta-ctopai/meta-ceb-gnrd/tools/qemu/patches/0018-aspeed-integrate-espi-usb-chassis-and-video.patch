diff --git a/hw/misc/aspeed_chassis_sim.c b/hw/misc/aspeed_chassis_sim.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/aspeed_chassis_sim.c
@@ -0,0 +1,74 @@
+/* AST2600 CHASI# input and sticky intrusion latch. */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_CHASSIS_SIM "aspeed.chassis-sim"
+OBJECT_DECLARE_SIMPLE_TYPE(ChassisSimState, CHASSIS_SIM)
+struct ChassisSimState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t ctrl;
+    bool open;
+    bool latched;
+};
+static uint64_t chassis_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ChassisSimState *s = opaque;
+    return (s->ctrl & ~4U) | (s->latched ? 4U : 0);
+}
+static void chassis_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    ChassisSimState *s = opaque;
+    s->ctrl = val & ~4U; /* STATUS is read-only, CLEAR is bit 0. */
+    if (val & 1) { s->latched = s->open; }
+}
+static const MemoryRegionOps chassis_ops = {
+    .read = chassis_read, .write = chassis_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+static bool chassis_open(Object *obj, Error **errp)
+{
+    return CHASSIS_SIM(obj)->open;
+}
+static void chassis_set_open(Object *obj, bool value, Error **errp)
+{
+    ChassisSimState *s = CHASSIS_SIM(obj);
+    s->open = value;
+    if (value) { s->latched = true; }
+}
+static bool chassis_latched(Object *obj, Error **errp)
+{
+    return CHASSIS_SIM(obj)->latched;
+}
+static void chassis_init(Object *obj)
+{
+    ChassisSimState *s = CHASSIS_SIM(obj);
+    memory_region_init_io(&s->iomem, obj, &chassis_ops, s, TYPE_CHASSIS_SIM, 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    object_property_add_bool(obj, "open", chassis_open, chassis_set_open);
+    object_property_add_bool(obj, "latched", chassis_latched, NULL);
+}
+static void chassis_reset(DeviceState *dev)
+{
+    /* The battery-domain latch and physical input survive a BMC reboot. */
+    CHASSIS_SIM(dev)->ctrl = 0;
+}
+static void chassis_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->desc = "AST2600 CHASI# software-test latch (polling, no IRQ)";
+    dc->user_creatable = false;
+    device_class_set_legacy_reset(dc, chassis_reset);
+}
+static const TypeInfo chassis_type = {
+    .name = TYPE_CHASSIS_SIM, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ChassisSimState), .instance_init = chassis_init,
+    .class_init = chassis_class_init,
+};
+static void chassis_register(void) { type_register_static(&chassis_type); }
+type_init(chassis_register)
diff --git a/hw/misc/aspeed_espi_sim.c b/hw/misc/aspeed_espi_sim.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/aspeed_espi_sim.c
@@ -0,0 +1,317 @@
+/* AST2600 Peripheral/VW controller for host-side software simulation.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * No OOB, flash channel or electrical link timing is modeled.
+ */
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "hw/misc/aspeed_lpc.h"
+#include "qom/object.h"
+#include "migration/vmstate.h"
+
+#define TYPE_ESPI_SIM "aspeed.espi-sim"
+OBJECT_DECLARE_SIMPLE_TYPE(ESPISimState, ESPI_SIM)
+struct ESPISimState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    MemoryRegion vuart;
+    qemu_irq irq;
+    qemu_irq vuart_irq;
+    AspeedLPCState *lpc;
+    uint32_t regs[0x1000 / 4];
+    bool reset_asserted;
+    uint32_t cycles;
+    char *result;
+    uint8_t uart_regs[2][8];
+    uint8_t uart_divisor[2][2];
+    uint8_t uart_fifo[2][256];
+    uint16_t uart_head[2], uart_count[2];
+    uint32_t vuart_ctrl[8];
+};
+#define R(x) ((x) / 4)
+#define CTRL 0x000
+#define ISR 0x008
+#define IER 0x00c
+#define SYSEVT 0x098
+#define PERIF_READY BIT(1)
+#define VW_READY BIT(3)
+#define BOOT_WIRES (BIT(20) | BIT(23))
+
+static bool espi_ready(ESPISimState *s, uint32_t bit)
+{
+    return !s->reset_asserted && (s->regs[R(CTRL)] & bit);
+}
+static void espi_irq(ESPISimState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[R(ISR)] & s->regs[R(IER)]));
+}
+static bool uart_rx_irq(ESPISimState *s, unsigned side)
+{
+    return (s->uart_regs[side][1] & BIT(0)) && s->uart_count[side];
+}
+static bool uart_tx_irq(ESPISimState *s, unsigned side)
+{
+    return (s->uart_regs[side][1] & BIT(1)) && s->uart_count[!side] < 256;
+}
+static void uart_irq(ESPISimState *s)
+{
+    qemu_set_irq(s->vuart_irq, uart_rx_irq(s, 0) || uart_tx_irq(s, 0));
+}
+static uint8_t uart_read(ESPISimState *s, unsigned side, unsigned reg)
+{
+    uint8_t val;
+    if (reg < 2 && (s->uart_regs[side][3] & BIT(7))) {
+        return s->uart_divisor[side][reg]; /* divisor latch */
+    }
+    switch (reg) {
+    case 0:
+        if (!s->uart_count[side]) { return 0; }
+        val = s->uart_fifo[side][s->uart_head[side]++ & 255];
+        s->uart_count[side]--; uart_irq(s); return val;
+    case 2:
+        return 0xc0 | (uart_rx_irq(s, side) ? 4 :
+                       uart_tx_irq(s, side) ? 2 : 1);
+    case 5:
+        return (s->uart_count[side] ? BIT(0) : 0) |
+               (s->uart_count[!side] < 256 ? BIT(5) | BIT(6) : 0);
+    case 6: return 0xb0; /* CTS, DSR, DCD */
+    default: return s->uart_regs[side][reg];
+    }
+}
+static bool uart_write(ESPISimState *s, unsigned side, unsigned reg, uint8_t val)
+{
+    if (reg < 2 && (s->uart_regs[side][3] & BIT(7))) {
+        s->uart_divisor[side][reg] = val;
+    } else if (reg == 0) {
+        unsigned peer = !side;
+        if (s->uart_count[peer] == 256) { return false; }
+        s->uart_fifo[peer][(s->uart_head[peer] + s->uart_count[peer]) & 255] = val;
+        s->uart_count[peer]++;
+    } else if (reg == 2) {
+        if (val & BIT(1)) { s->uart_count[side] = 0; }
+    } else {
+        s->uart_regs[side][reg] = val;
+    }
+    uart_irq(s);
+    return true;
+}
+static uint64_t vuart_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESPISimState *s = opaque;
+    return addr < 0x20 ? uart_read(s, 0, addr >> 2) :
+                        s->vuart_ctrl[(addr - 0x20) >> 2];
+}
+static void vuart_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    ESPISimState *s = opaque;
+    if (addr < 0x20) { uart_write(s, 0, addr >> 2, val); }
+    else { s->vuart_ctrl[(addr - 0x20) >> 2] = val; }
+}
+static const MemoryRegionOps vuart_ops = {
+    .read = vuart_read, .write = vuart_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+static uint64_t espi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESPISimState *s = opaque;
+    return s->regs[R(addr)];
+}
+static void espi_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    ESPISimState *s = opaque;
+    switch (addr) {
+    case ISR: s->regs[R(ISR)] &= ~val; break;
+    case IER: s->regs[R(IER)] |= val; break;
+    case 0x0fc: s->regs[R(IER)] &= ~val; break;
+    case 0x004: case 0x0a0: case 0x0a4: case 0x0a8: break;
+    default: s->regs[R(addr)] = val; break;
+    }
+    espi_irq(s);
+}
+static const MemoryRegionOps espi_ops = {
+    .read = espi_read, .write = espi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+static bool espi_get_reset(Object *obj, Error **errp)
+{
+    return ESPI_SIM(obj)->reset_asserted;
+}
+static void espi_set_reset(Object *obj, bool value, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    bool had = s->reset_asserted;
+    s->reset_asserted = value;
+    if (value) {
+        s->regs[R(CTRL)] &= ~(PERIF_READY | VW_READY);
+        s->regs[R(SYSEVT)] = 0;
+        s->regs[R(ISR)] = 0;
+    } else if (had) {
+        s->regs[R(ISR)] |= BIT(31);
+    }
+    espi_irq(s);
+}
+static bool espi_get_perif(Object *obj, Error **errp)
+{
+    return espi_ready(ESPI_SIM(obj), PERIF_READY);
+}
+static bool espi_get_vw(Object *obj, Error **errp)
+{
+    return espi_ready(ESPI_SIM(obj), VW_READY);
+}
+static bool espi_get_boot(Object *obj, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    return espi_ready(s, VW_READY) &&
+           (s->regs[R(SYSEVT)] & BOOT_WIRES) == BOOT_WIRES;
+}
+static char *espi_get_result(Object *obj, Error **errp)
+{
+    return g_strdup(ESPI_SIM(obj)->result ?: "");
+}
+/* QMP host-cycle: "read PORT" or "write PORT BYTE", numbers in hex.
+ * Legacy I/O is routed to the same LPC state the BMC KCS/snoop driver uses.
+ */
+static void espi_cycle(Object *obj, const char *text, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    char op[16];
+    unsigned port, val = 0;
+    int n = sscanf(text, "%15s %x %x", op, &port, &val);
+    uint8_t byte;
+    bool ok = false;
+    g_free(s->result);
+    s->result = NULL;
+    if (!espi_ready(s, PERIF_READY)) {
+        s->result = g_strdup("not-ready");
+        return;
+    }
+    if (n < 2 || port > 0xffff || val > 0xff) {
+        error_setg(errp, "host-cycle: read PORT or write PORT BYTE (hex)");
+        return;
+    }
+    if (!strcmp(op, "read") && n == 2) {
+        if (port >= 0x3f8 && port <= 0x3ff && (s->vuart_ctrl[0] & BIT(0))) {
+            byte = uart_read(s, 1, port - 0x3f8); ok = true;
+        } else { ok = aspeed_lpc_host_read(s->lpc, port, &byte); }
+        if (ok) { s->result = g_strdup_printf("ok:%02x", byte); }
+    } else if (!strcmp(op, "write") && n == 3) {
+        if (port >= 0x3f8 && port <= 0x3ff && (s->vuart_ctrl[0] & BIT(0))) {
+            ok = uart_write(s, 1, port - 0x3f8, val);
+        } else { ok = aspeed_lpc_host_write(s->lpc, port, val); }
+        if (ok) { s->result = g_strdup("ok:"); }
+    }
+    if (!ok) {
+        s->result = g_strdup("unsupported");
+        return;
+    }
+    s->cycles++;
+}
+/* Host system events use a mask/value pair; BMC-owned boot wires are protected.
+ * SLP_S3/S4/S5, PLTRST and other system-event inputs can be exercised as raw bits.
+ */
+static void espi_post(Object *obj, Visitor *v, const char *name, void *opaque,
+                      Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    uint8_t code;
+    if (visit_type_uint8(v, name, &code, errp) && espi_ready(s, PERIF_READY)) {
+        aspeed_lpc_snoop_write(s->lpc, 0x80, code);
+        s->cycles++;
+    }
+}
+static bool espi_host_irq4(Object *obj, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    return espi_ready(s, VW_READY) && uart_rx_irq(s, 1);
+}
+
+static void espi_vw(Object *obj, const char *text, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    unsigned mask, value;
+    if (!espi_ready(s, VW_READY)) {
+        error_setg(errp, "Virtual Wire channel is not ready");
+        return;
+    }
+    if (sscanf(text, "%x %x", &mask, &value) != 2 || (mask & BOOT_WIRES)) {
+        error_setg(errp, "host-vw: MASK VALUE (hex), BMC boot wires are read-only");
+        return;
+    }
+    s->regs[R(SYSEVT)] = (s->regs[R(SYSEVT)] & ~mask) | (value & mask);
+    /* This board driver consumes readiness/boot wires, not VW input IRQs. */
+}
+static void espi_error(Object *obj, const char *text, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(obj);
+    unsigned mask;
+    if (sscanf(text, "%x", &mask) != 1 || (mask & ~0x33c00U)) {
+        error_setg(errp, "inject-error: Peripheral error mask (bits 10..13,16..17)");
+        return;
+    }
+    s->regs[R(ISR)] |= mask;
+    espi_irq(s);
+}
+static void espi_reset(DeviceState *dev)
+{
+    ESPISimState *s = ESPI_SIM(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->uart_regs, 0, sizeof(s->uart_regs));
+    memset(s->uart_divisor, 0, sizeof(s->uart_divisor));
+    memset(s->uart_head, 0, sizeof(s->uart_head));
+    memset(s->uart_count, 0, sizeof(s->uart_count));
+    memset(s->vuart_ctrl, 0, sizeof(s->vuart_ctrl));
+    s->cycles = 0;
+    espi_irq(s);
+    uart_irq(s);
+}
+static void espi_realize(DeviceState *dev, Error **errp)
+{
+    ESPISimState *s = ESPI_SIM(dev);
+    if (!s->lpc) { error_setg(errp, "espi-sim requires lpc link"); return; }
+    memory_region_init_io(&s->iomem, OBJECT(s), &espi_ops, s, TYPE_ESPI_SIM, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+    memory_region_init_io(&s->vuart, OBJECT(s), &vuart_ops, s, "espi-vuart", 0x40);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->vuart);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->vuart_irq);
+}
+static void espi_init(Object *obj)
+{
+    ESPI_SIM(obj)->reset_asserted = true;
+    object_property_add_bool(obj, "host-reset", espi_get_reset, espi_set_reset);
+    object_property_add_bool(obj, "peripheral-ready", espi_get_perif, NULL);
+    object_property_add_bool(obj, "vw-ready", espi_get_vw, NULL);
+    object_property_add_bool(obj, "boot-ready", espi_get_boot, NULL);
+    object_property_add_str(obj, "host-cycle", NULL, espi_cycle);
+    object_property_add_str(obj, "host-result", espi_get_result, NULL);
+    object_property_add(obj, "post-code", "uint8", NULL, espi_post, NULL, NULL);
+    object_property_add_bool(obj, "host-irq4", espi_host_irq4, NULL);
+    object_property_add_str(obj, "host-vw", NULL, espi_vw);
+    object_property_add_str(obj, "inject-error", NULL, espi_error);
+}
+static const Property espi_props[] = {
+    DEFINE_PROP_LINK("lpc", ESPISimState, lpc, TYPE_ASPEED_LPC, AspeedLPCState *),
+};
+static void espi_finalize(Object *obj) { g_free(ESPI_SIM(obj)->result); }
+static void espi_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = espi_realize;
+    device_class_set_legacy_reset(dc, espi_reset);
+    device_class_set_props(dc, espi_props);
+    dc->desc = "AST2600 eSPI Peripheral/VW software-test model";
+    dc->user_creatable = false;
+}
+static const TypeInfo espi_type = {
+    .name = TYPE_ESPI_SIM, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESPISimState), .instance_init = espi_init,
+    .instance_finalize = espi_finalize, .class_init = espi_class_init,
+};
+static void espi_register(void) { type_register_static(&espi_type); }
+type_init(espi_register)
diff --git a/hw/misc/aspeed_lpc.c b/hw/misc/aspeed_lpc.c
--- a/hw/misc/aspeed_lpc.c
+++ b/hw/misc/aspeed_lpc.c
@@ -352,6 +352,36 @@
     }
 }
 
+bool aspeed_lpc_host_read(AspeedLPCState *s, uint16_t port, uint8_t *value)
+{
+    const struct aspeed_kcs_channel *ch = &aspeed_kcs_channel_map[kcs_channel_3];
+    if (!aspeed_kcs_channel_enabled(s, ch)) { return false; }
+    if (port == 0xca3) { *value = s->regs[STR3]; return true; }
+    if (port == 0xca2) {
+        *value = s->regs[ODR3];
+        s->regs[STR3] &= ~STR_OBF;
+        return true;
+    }
+    return false;
+}
+
+bool aspeed_lpc_host_write(AspeedLPCState *s, uint16_t port, uint8_t value)
+{
+    const struct aspeed_kcs_channel *ch = &aspeed_kcs_channel_map[kcs_channel_3];
+    if (port == 0x80) { aspeed_lpc_snoop_write(s, port, value); return true; }
+    if ((port != 0xca2 && port != 0xca3) ||
+        !aspeed_kcs_channel_enabled(s, ch) || (s->regs[STR3] & STR_IBF)) {
+        return false;
+    }
+    s->regs[IDR3] = value;
+    s->regs[STR3] = (s->regs[STR3] & ~STR_CMD_DATA) |
+                    STR_IBF | (port == 0xca3 ? STR_CMD_DATA : 0);
+    if (aspeed_kcs_channel_ibf_irq_enabled(s, ch)) {
+        qemu_irq_raise(s->subdevice_irqs[aspeed_lpc_kcs_3]);
+    }
+    return true;
+}
