     /* Connect the LPC IRQ to the GIC. It is otherwise unused. */
     sysbus_connect_irq(SYS_BUS_DEVICE(&s->lpc), 0,
                        aspeed_soc_ast2600_get_irq(s, ASPEED_DEV_LPC));
@@ -768,6 +752,30 @@
                     sc->memmap[ASPEED_DEV_VIDEO]);
     sysbus_connect_irq(SYS_BUS_DEVICE(&s->video_engine), 0,
                        qdev_get_gpio_in(DEVICE(&a->a7mpcore), 7));
+
+    /* Host-facing interfaces; the BMC firmware uses its board drivers unchanged. */
