+                           qdev_get_gpio_in(DEVICE(&a->a7mpcore), 147));
+        sysbus_connect_irq(SYS_BUS_DEVICE(espi), 0,
+                           qdev_get_gpio_in(DEVICE(&a->a7mpcore), 42));
