From f6c68a1bb09fa3e6b4c52e8bf30d8fae7d62d16f Mon Sep 17 00:00:00 2001
From: flether-hub <flether@gmail.com>
Date: Mon, 5 Oct 2026 21:04:48 +0800
Subject: [PATCH] aspeed/adc: keep the channel values to 10 bits

The test ramp added 7 to the upper channel without masking, so it could set
bit 26.  A channel then given a voltage kept that bit and read back as
2047 (11 bits) instead of at most 1023: the Linux driver turned that into
about twice the reference voltage (D3V0_BAT0 read 4.997 V).  Mask the
ramp, and drop stray bits before a voltage is applied.

Upstream-Status: Inappropriate [CEB-GNRD board models for emulation only]
---
 hw/adc/aspeed_adc.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/hw/adc/aspeed_adc.c b/hw/adc/aspeed_adc.c
index d4318a3..abaa9be 100644
--- a/hw/adc/aspeed_adc.c
+++ b/hw/adc/aspeed_adc.c
@@ -64,7 +64,7 @@
 
 static inline uint32_t update_channels(uint32_t current)
 {
-    return ((((current >> 16) & ASPEED_ADC_L_MASK) + 7) << 16) |
+    return (((((current >> 16) & ASPEED_ADC_L_MASK) + 7) & ASPEED_ADC_L_MASK) << 16) |
         ((current + 5) & ASPEED_ADC_L_MASK);
 }
 
@@ -121,6 +121,8 @@ static uint32_t read_channel_sample(AspeedADCEngineState *s, int reg)
          */
         return (0x200 << 16) | 0x200;
     } else {
+        /* a channel is 10 bits; drop what the test ramp left above them */
+        s->regs[reg] &= ASPEED_ADC_LH_MASK;
         if (mv_a >= 0) {
             s->regs[reg] = (s->regs[reg] & ~ASPEED_ADC_L_MASK) |
                            channel_sample_mv(s, mv_a);
-- 
