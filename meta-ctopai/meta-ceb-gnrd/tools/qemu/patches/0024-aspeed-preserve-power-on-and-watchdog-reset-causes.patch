From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CEB-GNRD board layer <bmc@localhost>
Date: Tue, 6 Oct 2026 00:00:00 +0000
Subject: [PATCH] aspeed: model power-on and watchdog reset event logs

Generate POR only when the AST2600 machine is created. Preserve sticky
SCU064/06C event flags across warm reset, honor W1C, and record the
watchdog number/mode before requesting a reset. QMP reset is external
warm reset. This lets the same bootloader classify hardware and QEMU.

Upstream-Status: Inappropriate [CEB-GNRD reset and AC restore integration]
---
diff --git a/include/hw/misc/aspeed_scu.h b/include/hw/misc/aspeed_scu.h
--- a/include/hw/misc/aspeed_scu.h
+++ b/include/hw/misc/aspeed_scu.h
@@ -35,6 +35,7 @@
     MemoryRegion iomem;
 
     uint32_t regs[ASPEED_AST2700_SCU_NR_REGS];
+    uint32_t pending_reset_log[2];
     uint32_t silicon_rev;
     uint32_t hw_strap1;
     uint32_t hw_strap2;
diff --git a/hw/misc/aspeed_scu.c b/hw/misc/aspeed_scu.c
--- a/hw/misc/aspeed_scu.c
+++ b/hw/misc/aspeed_scu.c
@@ -593,14 +593,19 @@
                           TYPE_ASPEED_SCU, SCU_IO_REGION_SIZE);
 
     sysbus_init_mmio(sbd, &s->iomem);
+    if (object_dynamic_cast(OBJECT(s), TYPE_ASPEED_2600_SCU)) {
+        /* Creating the machine is AC power-on; subsequent resets are warm. */
+        s->pending_reset_log[0] = BIT(0);
+    }
 }
 
 static const VMStateDescription vmstate_aspeed_scu = {
     .name = "aspeed.scu",
-    .version_id = 2,
+    .version_id = 3,
     .minimum_version_id = 2,
     .fields = (const VMStateField[]) {
         VMSTATE_UINT32_ARRAY(regs, AspeedSCUState, ASPEED_AST2600_SCU_NR_REGS),
+        VMSTATE_UINT32_ARRAY_V(pending_reset_log, AspeedSCUState, 2, 3),
         VMSTATE_END_OF_LIST()
     }
 };
@@ -734,6 +739,11 @@
     trace_aspeed_scu_write(offset, size, data);
 
     switch (reg) {
+    case TO_REG(0x64):
+    case TO_REG(0x6c):
+        /* SCU reset event logs are sticky, write-one-to-clear. */
+        s->regs[reg] &= ~data;
+        return;
     case AST2600_PROT_KEY:
         /*
          * Writing a value to SCU000 will modify both protection
@@ -825,8 +835,21 @@
 {
     AspeedSCUState *s = ASPEED_SCU(dev);
     AspeedSCUClass *asc = ASPEED_SCU_GET_CLASS(dev);
-
+    uint32_t reset = s->regs[TO_REG(0x64)];
+    uint32_t reset3 = s->regs[TO_REG(0x6c)];
+
+    if (!s->pending_reset_log[0] && !s->pending_reset_log[1]) {
+        /* QMP/system_reset has no watchdog source: external warm reset. */
+        s->pending_reset_log[0] = BIT(1);
+    }
+    reset |= s->pending_reset_log[0];
+    reset3 |= s->pending_reset_log[1];
+    s->pending_reset_log[0] = s->pending_reset_log[1] = 0;
     memcpy(s->regs, asc->resets, asc->nr_regs * 4);
+    s->regs[TO_REG(0x64)] = reset;
+    s->regs[TO_REG(0x6c)] = reset3;
+    fprintf(stderr, "CEB-GNRD SCU reset: SCU064=%08x SCU06C=%08x\n",
+            reset, reset3);
 
     /*
      * A0 reports A0 in _REV, but subsequent revisions report A1 regardless
diff --git a/hw/watchdog/wdt_aspeed.c b/hw/watchdog/wdt_aspeed.c
--- a/hw/watchdog/wdt_aspeed.c
+++ b/hw/watchdog/wdt_aspeed.c
@@ -56,6 +56,24 @@
 #define AST2600_SCU_RESET_CONTROL1      (0x40 / 4)
 #define SCU_RESET_CONTROL1              (0x04 / 4)
 #define    SCU_RESET_SDRAM              BIT(0)
+
+static void aspeed_wdt_record_reset(AspeedWDTState *s, bool software)
+{
+    unsigned index, mode, log, shift;
+
+    if (!object_dynamic_cast(OBJECT(s->scu), TYPE_ASPEED_2600_SCU)) {
+        return;
+    }
+    /* AST2600 watchdogs occupy 0x40-byte windows beginning at 1e785000. */
+    if (s->iomem.addr < 0x1e785000 || s->iomem.addr >= 0x1e785200) {
+        return;
+    }
+    index = (s->iomem.addr - 0x1e785000) / 0x40;
+    log = index / 4;
+    shift = log ? (index % 4) * 4 : 16 + index * 4;
+    mode = software ? 3 : extract32(s->regs[WDT_CTRL], 5, 2);
+    s->scu->pending_reset_log[log] |= BIT(shift + mode);
+}
 
 static bool aspeed_wdt_is_soc_reset_mode(const AspeedWDTState *s)
 {
@@ -217,6 +235,7 @@
     case WDT_SW_RESET_CTRL:
         if (aspeed_wdt_is_soc_reset_mode(s) &&
             (data == WDT_SW_RESET_ENABLE)) {
+            aspeed_wdt_record_reset(s, true);
             watchdog_perform_action();
         }
         break;
@@ -275,6 +294,7 @@
 
     qemu_log_mask(CPU_LOG_RESET, "Watchdog timer %" HWADDR_PRIx " expired.\n",
                   s->iomem.addr);
+    aspeed_wdt_record_reset(s, false);
     watchdog_perform_action();
     timer_del(s->timer);
 }
