diff --git a/hw/net/ceb_gnrd_network.c.inc b/hw/net/ceb_gnrd_network.c.inc
--- /dev/null
+++ b/hw/net/ceb_gnrd_network.c.inc
@@ -0,0 +1,569 @@
+/* CEB-GNRD software test profiles. SPDX-License-Identifier: GPL-2.0-or-later */
+static bool ftgmac100_can_receive(NetClientState *nc);
+
+static unsigned ceb_phy_speed(FTGMAC100State *s)
+{
+    if (!(s->phy_control & MII_BMCR_AUTOEN)) {
+        unsigned forced = s->phy_control & MII_BMCR_SPEED1000 ? 1000 :
+                          s->phy_control & MII_BMCR_SPEED100 ? 100 : 10;
+        return forced <= s->test_speed ? forced : 0;
+    }
+    if (s->test_speed >= 1000 && (s->phy_gig_control & MII_CTRL1000_FULL)) {
+        return 1000;
+    }
+    if (s->test_speed >= 100 && (s->phy_advertise & MII_ANAR_TXFD)) {
+        return 100;
+    }
+    return s->phy_advertise & MII_ANAR_10FD ? 10 : 0;
+}
+
+static bool ceb_phy_link(FTGMAC100State *s)
+{
+    return s->test_link && !qemu_get_queue(s->nic)->link_down &&
+           !(s->phy_control & (MII_BMCR_PDOWN | MII_BMCR_ISOLATE)) &&
+           ceb_phy_speed(s);
+}
+
+static uint32_t ceb_ncsi_link(FTGMAC100State *s, unsigned ch)
+{
+    unsigned speed = s->test_speed == 100000 ? 13 :
+                     s->test_speed == 25000 ? 10 :
+                     s->test_speed == 10000 ? 8 :
+                     s->test_speed == 1000 ? 7 :
+                     s->test_speed == 100 ? 5 : 2;
+    return s->ncsi_powered && s->ncsi_link[ch] && s->test_link &&
+           !qemu_get_queue(s->nic)->link_down ? 0x61 | (speed << 1) : 0;
+}
+
+static uint32_t ceb_checksum(const uint8_t *p, size_t len)
+{
+    uint32_t sum = 0;
+    for (size_t i = 0; i < len; i += 2) {
+        sum += (uint32_t)p[i] << 8;
+        if (i + 1 < len) {
+            sum += p[i + 1];
+        }
+    }
+    return -sum;
+}
+
+static void ceb_reply_timer(void *opaque)
+{
+    FTGMAC100State *s = opaque;
+    if (!s->reply_count) {
+        return;
+    }
+    if (ftgmac100_can_receive(qemu_get_queue(s->nic))) {
+        unsigned slot = s->reply_head;
+        qemu_receive_packet(qemu_get_queue(s->nic),
+                            s->replies + slot * 256, s->reply_len[slot]);
+        s->reply_head = (slot + 1) % 32;
+        s->reply_count--;
+        s->reply_wait = 0;
+    } else if (++s->reply_wait >= 100) {
+        /* Bounded retry: no unbounded memory growth with disabled RX DMA. */
+        s->reply_head = (s->reply_head + 1) % 32;
+        s->reply_count--;
+        s->reply_wait = 0;
+        s->ncsi_dropped++;
+    }
+    if (s->reply_count) {
+        timer_mod(s->reply_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 10);
+    }
+}
+
+static void ceb_queue(FTGMAC100State *s, const uint8_t *frame, size_t len)
+{
+    unsigned slot;
+    if (s->reply_count == 32 || len > 256) {
+        s->ncsi_dropped++;
+        return;
+    }
+    slot = (s->reply_head + s->reply_count) % 32;
+    memcpy(s->replies + slot * 256, frame, len);
+    s->reply_len[slot] = len;
+    if (!s->reply_count++) {
+        timer_mod(s->reply_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1);
+    }
+}
+
+static void ceb_aen(FTGMAC100State *s, unsigned ch, unsigned type)
+{
+    uint8_t f[64] = {0};
+    unsigned payload = type == 0 ? 12 : 4;
+    if (!s->ncsi_e810 || !s->ncsi_powered || !(s->ncsi_aen[ch] & (1U << type))) {
+        return;
+    }
+    memcpy(f, s->ncsi_bmc_mac, 6);
+    memcpy(f + 6, s->conf.macaddr.a, 6);
+    stw_be_p(f + 12, 0x88f8);
+    f[14] = s->ncsi_mc_id[ch];
+    f[15] = 1;
+    f[18] = 0xff;
+    f[19] = ch;
+    stw_be_p(f + 20, payload);
+    f[33] = type;
+    if (type == 0) {
+        stl_be_p(f + 34, ceb_ncsi_link(s, ch));
+    }
+    stl_be_p(f + 30 + payload, ceb_checksum(f + 14, 16 + payload));
+    ceb_queue(s, f, sizeof(f));
+    s->ncsi_aens++;
+}
+
+static void ceb_channel_reset(FTGMAC100State *s, unsigned ch)
+{
+    s->ncsi_enabled[ch] = false;
+    s->ncsi_tx[ch] = false;
+    s->ncsi_aen[ch] = 0;
+    s->ncsi_bc[ch] = 0;
+    s->ncsi_mc[ch] = 0;
+    s->ncsi_bc_enabled[ch] = false;
+    s->ncsi_mc_enabled[ch] = false;
+    s->ncsi_vlan_enabled[ch] = false;
+    s->ncsi_flow[ch] = 0;
+    s->ncsi_link_mode[ch] = 0;
+    s->ncsi_vlan_mode[ch] = 0;
+    s->ncsi_vlan[ch] = 0;
+    s->ncsi_mac_enabled[ch] = false;
+    memset(s->ncsi_mac + ch * 6, 0, 6);
+}
+
+/* All offsets are relative to Ethernet + the 16-byte NC-SI common header.
+ * Two channels in package 0; unsupported packages/channels never respond,
+ * so the Linux discovery scan does not invent extra hardware.
+ */
+static bool ceb_ncsi_command(FTGMAC100State *s, const uint8_t *f, size_t len)
+{
+    uint8_t r[256] = {0};
+    const uint8_t *p;
+    unsigned ch, cmd, plen, out = 4, code = 0, reason = 0, need = 0;
+    uint32_t checksum;
+    if (!s->ncsi_e810 || len < 14 || lduw_be_p(f + 12) != 0x88f8) {
+        return false;
+    }
+    s->ncsi_commands++;
+    if (!s->ncsi_powered || !s->ncsi_responsive) { s->ncsi_dropped++; return true; }
+    if (len < 34 || f[15] != 1 || (f[18] & 0x80)) {
+        s->ncsi_dropped++;
+        return true;
+    }
+    cmd = f[18];
+    ch = f[19] & 31;
+    plen = lduw_be_p(f + 20);
+    if ((f[19] >> 5) != 0 ||
+        (ch >= 2 && !((cmd == 1 || cmd == 2 || cmd == 0x14 || cmd == 0x1b) && ch == 31))) {
+        s->ncsi_dropped++;
+        return true;
+    }
+    if (plen > 128 || len < 30 + ROUND_UP(plen, 4) + 4) {
+        s->ncsi_dropped++;
+        return true;
+    }
+    checksum = ldl_be_p(f + 30 + ROUND_UP(plen, 4));
+    if (checksum && checksum != ceb_checksum(f + 14, 16 + plen)) {
+        s->ncsi_bad_checksum++;
+        return true;
+    }
+    p = f + 30;
+    switch (cmd) {
+    case 1: case 4: case 5: case 0x0c: case 0x10: case 0x12: case 0x14:
+        need = 4; break;
+    case 8: case 9: case 0x0b: case 0x0e:
+        need = 8; break;
+    case 0x50:
+        need = 5; break;
+    default:
+        break;
+    }
+    if ((cmd == 0x50 && plen < need) || (cmd != 0x50 && plen != need)) {
+        code = 1; reason = 5;
+        goto reply;
+    }
+    memcpy(s->ncsi_bmc_mac, f + 6, 6);
+    switch (cmd) {
+    case 0: /* Clear Initial State */
+        ceb_channel_reset(s, ch);
+        break;
+    case 1:
+        s->ncsi_selected = true;
+        break;
+    case 2:
+        s->ncsi_selected = false;
+        for (unsigned i = 0; i < 2; i++) {
+            ceb_channel_reset(s, i);
+        }
+        break;
+    case 3: s->ncsi_enabled[ch] = true; break;
+    case 4: s->ncsi_enabled[ch] = false; s->ncsi_tx[ch] = false; break;
+    case 5: ceb_channel_reset(s, ch); break;
+    case 6:
+        s->ncsi_tx[0] = s->ncsi_tx[1] = false;
+        s->ncsi_tx[ch] = true;
+        break;
+    case 7: s->ncsi_tx[ch] = false; break;
+    case 8:
+        s->ncsi_mc_id[ch] = p[3];
+        s->ncsi_aen[ch] = ldl_be_p(p + 4) & 3;
+        break;
+    case 9: s->ncsi_link_mode[ch] = ldl_be_p(p); break;
+    case 0x0a:
+        out = 16;
+        stl_be_p(r + 34, ceb_ncsi_link(s, ch));
+        break;
+    case 0x0b:
+        if (p[6] != 1 || (p[7] & ~1)) {
+            code = 1; reason = 2; break;
+        }
+        s->ncsi_vlan_enabled[ch] = p[7];
+        s->ncsi_vlan[ch] = lduw_be_p(p + 2) & 0xfff;
+        break;
+    case 0x0c:
+        if (p[3] < 1 || p[3] > 3) { code = 1; reason = 2; break; }
+        s->ncsi_vlan_mode[ch] = p[3]; break;
+    case 0x0d: s->ncsi_vlan_mode[ch] = 0; break;
+    case 0x0e:
+        if (p[6] != 1 || (p[7] & 0xe0)) {
+            code = 1; reason = 2; break;
+        }
+        s->ncsi_mac_enabled[ch] = p[7] & 1;
+        memcpy(s->ncsi_mac + ch * 6, p, 6);
+        break;
+    case 0x10:
+        s->ncsi_bc_enabled[ch] = true;
+        s->ncsi_bc[ch] = ldl_be_p(p) & 15; break;
+    case 0x12:
+        s->ncsi_mc_enabled[ch] = true;
+        s->ncsi_mc[ch] = ldl_be_p(p) & 63; break;
+    case 0x13: s->ncsi_mc_enabled[ch] = false; break;
+    case 0x11: s->ncsi_bc_enabled[ch] = false; break;
+    case 0x14:
+        /* No pause generation advertised; disabling flow control is harmless. */
+        if (p[3]) { code = 3; reason = 0x7fff; }
+        break;
+    case 0x15:
+        out = 40;
+        r[34] = 1; r[35] = 2;
+        memcpy(r + 42, "E810-SIM", 8);
+        stl_be_p(r + 54, 1);
+        stw_be_p(r + 58, 0x1592);
+        stw_be_p(r + 60, 0x8086);
+        stl_be_p(r + 66, 0x157);
+        break;
+    case 0x16:
+        out = 32;
+        /* IPv4 broadcast and IPv6 global multicast filters; no arbitration. */
+        stl_be_p(r + 34, 0x50); /* global multicast, no hardware arbitration */
+        stl_be_p(r + 38, 15); /* ARP, DHCP client/server, NetBIOS */
+        stl_be_p(r + 42, 63); /* IPv6 ND, router, DHCPv6, MLD */
+        stl_be_p(r + 50, 3); /* link/configuration AEN */
+        r[54] = 1; /* one VLAN slot */
+        r[57] = 1; /* one unicast MAC */
+        r[60] = 7; /* VLAN modes 1, 2, 3 */
+        r[61] = 2; /* two channels */
+        break;
+    case 0x17:
+        out = 40;
+        r[34] = 1; r[37] = s->ncsi_mac_enabled[ch]; r[38] = 1;
+        stw_be_p(r + 40, s->ncsi_vlan_enabled[ch]);
+        stl_be_p(r + 42, s->ncsi_link_mode[ch]);
+        stl_be_p(r + 46, s->ncsi_bc[ch]);
+        stl_be_p(r + 50, s->ncsi_bc_enabled[ch] |
+                 (s->ncsi_enabled[ch] << 1) | (s->ncsi_tx[ch] << 2) |
+                 (s->ncsi_mc_enabled[ch] << 3));
+        r[54] = s->ncsi_vlan_mode[ch]; r[55] = s->ncsi_flow[ch];
+        stl_be_p(r + 58, s->ncsi_aen[ch]);
+        memcpy(r + 62, s->ncsi_mac + ch * 6, 6);
+        stw_be_p(r + 68, s->ncsi_vlan[ch]);
+        break;
+    case 0x18: /* Controller packet statistics: unmodelled hardware counters zero */
+        out = 204;
+        stl_be_p(r + 50, s->network_rx);
+        stl_be_p(r + 62, s->network_tx);
+        break;
+    case 0x19:
+        out = 32;
+        stl_be_p(r + 34, s->ncsi_commands);
+        stl_be_p(r + 38, s->ncsi_dropped);
+        stl_be_p(r + 42, s->ncsi_unsupported);
+        stl_be_p(r + 46, s->ncsi_bad_checksum);
+        stl_be_p(r + 50, s->ncsi_commands);
+        stl_be_p(r + 54, s->ncsi_responses);
+        stl_be_p(r + 58, s->ncsi_aens);
+        break;
+    case 0x1a:
+        out = 48;
+        stl_be_p(r + 34, s->network_tx);
+        stl_be_p(r + 38, s->network_dropped);
+        stl_be_p(r + 50, s->network_rx);
+        break;
+    case 0x1b: out = 8; break;
+    case 0x50:
+        /* Intel Get MAC Address: driver increments the returned NIC MAC. */
+        if (ldl_be_p(p) != 0x157) {
+            code = 3; reason = 0x7fff; break;
+        }
+        if (p[4] == 0x20 && plen == 7) {
+            /* Keep PHY up while powered; this cannot supply standby power. */
+            s->ncsi_keep_phy = p[6] & 1;
+            out = 12;
+            stl_be_p(r + 34, 0x157); r[38] = 0x20;
+            break;
+        }
+        if (p[4] != 6 || plen != 5) {
+            code = 3; reason = 0x7fff; break;
+        }
+        out = 16;
+        stl_be_p(r + 34, 0x157); r[38] = 6;
+        memcpy(r + 39, s->ncsi_hw_mac, 6);
+        for (int i = 44; i >= 39; i--) {
+            if (r[i]--) { break; }
+        }
+        break;
+    case 0x52:
+        out = 20;
+        memcpy(r + 34, "CEB-E810-SIM-0001", 16);
+        break;
+    default:
+        code = 3; reason = 0x7fff;
+        s->ncsi_unsupported++;
+        break;
+    }
+reply:
+    memcpy(r, f + 6, 6);
+    memcpy(r + 6, s->conf.macaddr.a, 6);
+    stw_be_p(r + 12, 0x88f8);
+    r[14] = f[14]; r[15] = 1; r[17] = f[17];
+    r[18] = cmd | 0x80; r[19] = f[19];
+    stw_be_p(r + 20, out);
+    stw_be_p(r + 30, code); stw_be_p(r + 32, reason);
+    stl_be_p(r + 30 + out, ceb_checksum(r + 14, 16 + out));
+    ceb_queue(s, r, MAX(60, 34 + out));
+    s->ncsi_responses++;
+    if (cmd != 0x0a || code) {
+        qemu_log("CEB NC-SI cmd=%02x channel=%u code=%u reason=%u selected=%u "
+                 "enabled=%u/%u tx=%u/%u\n", cmd, ch, code, reason,
+                 s->ncsi_selected, s->ncsi_enabled[0], s->ncsi_enabled[1],
+                 s->ncsi_tx[0], s->ncsi_tx[1]);
+    }
+    return true;
+}
+
+static bool ceb_rx_filter(FTGMAC100State *s, unsigned ch,
+                          const uint8_t *f, size_t len)
+{
+    unsigned offset = 14;
+    unsigned proto = lduw_be_p(f + 12);
+    bool tagged = proto == 0x8100;
+    if (tagged) {
+        if (len < 18) { return false; }
+        proto = lduw_be_p(f + 16);
+        offset = 18;
+    }
+    if (s->ncsi_vlan_mode[ch]) {
+        if (!tagged && s->ncsi_vlan_mode[ch] == 1) { return false; }
+        if (tagged && s->ncsi_vlan_mode[ch] != 3 &&
+            (!s->ncsi_vlan_enabled[ch] ||
+             (lduw_be_p(f + 14) & 0xfff) != s->ncsi_vlan[ch])) {
+            return false;
+        }
+    }
+    if (!memcmp(f, "\xff\xff\xff\xff\xff\xff", 6)) {
+        if (!s->ncsi_bc_enabled[ch]) { return true; }
+        if (proto == 0x0806) { return s->ncsi_bc[ch] & 1; }
+        if (proto == 0x0800 && len >= offset + 20) {
+            const uint8_t *ip = f + offset;
+            unsigned ihl = (ip[0] & 15) * 4;
+            if (ip[9] == 17 && ihl >= 20 && len >= offset + ihl + 8) {
+                unsigned port = lduw_be_p(ip + ihl + 2);
+                if (port == 68) { return s->ncsi_bc[ch] & 2; }
+                if (port == 67) { return s->ncsi_bc[ch] & 4; }
+                if (port == 137 || port == 138) { return s->ncsi_bc[ch] & 8; }
+            }
+        }
+        return false;
+    }
+    if (!(f[0] & 1)) {
+        return s->ncsi_mac_enabled[ch] &&
+               !memcmp(f, s->ncsi_mac + ch * 6, 6);
+    }
+    if (!s->ncsi_mc_enabled[ch]) { return true; }
+    if (proto == 0x86dd && len >= offset + 48) {
+        const uint8_t *ip = f + offset;
+        /* Selective protocol filters inspect the IPv6 base header. */
+        if (ip[6] == 58) {
+            unsigned type = ip[40];
+            if (type == 135) { return s->ncsi_mc[ch] & 0x20; }
+            if (type == 136) { return s->ncsi_mc[ch] & 1; }
+            if (type == 133 || type == 134) { return s->ncsi_mc[ch] & 2; }
+            if (type == 130 || type == 131 || type == 132 || type == 143) {
+                return s->ncsi_mc[ch] & 16;
+            }
+        } else if (ip[6] == 17) {
+            unsigned port = lduw_be_p(ip + 42);
+            if (port == 546 || port == 547) { return s->ncsi_mc[ch] & 12; }
+        }
+        return false;
+    }
+    return false;
+}
+
+static bool ceb_data_allowed(FTGMAC100State *s, const uint8_t *f,
+                             size_t len, bool tx)
+{
+    if (s->rtl8211f) { return ceb_phy_link(s); }
+    if (!s->ncsi_e810) { return true; }
+    if (!s->ncsi_powered) { return false; }
+    if (len >= 14 && lduw_be_p(f + 12) == 0x88f8) { return true; }
+    for (unsigned ch = 0; ch < 2; ch++) {
+        if (!s->ncsi_selected || !s->ncsi_enabled[ch] ||
+            !ceb_ncsi_link(s, ch) || (tx && !s->ncsi_tx[ch])) { continue; }
+        if (tx || (len >= 14 && ceb_rx_filter(s, ch, f, len))) { return true; }
+    }
+    return false;
+}
+
+static bool ceb_get_link(Object *obj, Error **errp)
+{
+    return FTGMAC100(obj)->test_link;
+}
+
+static void ceb_set_link(Object *obj, bool up, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    s->test_link = up;
+    if (s->nic) {
+        phy_update_link(s);
+        for (unsigned ch = 0; ch < 2; ch++) { ceb_aen(s, ch, 0); }
+    }
+    qemu_log("CEB network link=%s\n", up ? "up" : "down");
+}
+
+static void ceb_get_speed(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    int64_t value = FTGMAC100(obj)->test_speed;
+    visit_type_int(v, name, &value, errp);
+}
+
+static void ceb_set_speed(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    int64_t value;
+    if (!visit_type_int(v, name, &value, errp)) { return; }
+    if (value != 10 && value != 100 && value != 1000 &&
+        (!s->ncsi_e810 || (value != 10000 && value != 25000 && value != 100000))) {
+        error_setg(errp, "speed must be 10/100/1000 Mbps; NC-SI also 10000/25000/100000");
+        return;
+    }
+    s->test_speed = value;
+    s->phy_int |= PHY_INT_LINK_STATUS;
+    if (s->nic) { phy_update_link(s); }
+    for (unsigned ch = 0; ch < 2; ch++) { ceb_aen(s, ch, 0); }
+    qemu_log("CEB network speed=%" PRId64 " Mbps\n", value);
+}
+
+static bool ceb_get_channel_link(Object *obj, Error **errp)
+{
+    return FTGMAC100(obj)->ncsi_link[0];
+}
+static void ceb_set_channel_link(Object *obj, bool up, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    s->ncsi_link[0] = up; ceb_aen(s, 0, 0);
+}
+static bool ceb_get_channel1_link(Object *obj, Error **errp)
+{
+    return FTGMAC100(obj)->ncsi_link[1];
+}
+static void ceb_set_channel1_link(Object *obj, bool up, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    s->ncsi_link[1] = up; ceb_aen(s, 1, 0);
+}
+
+static void ceb_get_diagnostics(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    char *value = g_strdup_printf(
+        "profile=%s link=%u speed=%u phy-id=%08x phy-address=%u "
+        "page=%04x mdio=%u phy-negotiated=%u powered=%u selected=%u ch0=%u/%u/%u ch1=%u/%u/%u "
+        "ncsi-commands=%u responses=%u aen=%u checksum-errors=%u "
+        "unsupported=%u control-dropped=%u tx=%u rx=%u data-dropped=%u",
+        s->rtl8211f ? "RTL8211FS" : s->ncsi_e810 ? "E810-NCSI-SIM" : "generic",
+        s->test_link, s->test_speed, s->rtl8211f ? 0x001cc916 : 0x001cc915,
+        s->rtl8211f ? 2 : 0, s->phy_page, s->mdio_accesses,
+        s->rtl8211f ? ceb_phy_speed(s) : 0,
+        s->ncsi_powered, s->ncsi_selected, s->ncsi_link[0], s->ncsi_enabled[0], s->ncsi_tx[0],
+        s->ncsi_link[1], s->ncsi_enabled[1], s->ncsi_tx[1],
+        s->ncsi_commands, s->ncsi_responses, s->ncsi_aens,
+        s->ncsi_bad_checksum, s->ncsi_unsupported, s->ncsi_dropped,
+        s->network_tx, s->network_rx, s->network_dropped);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static bool ceb_get_responsive(Object *obj, Error **errp)
+{
+    return FTGMAC100(obj)->ncsi_responsive;
+}
+static void ceb_set_responsive(Object *obj, bool value, Error **errp)
+{
+    FTGMAC100(obj)->ncsi_responsive = value;
+}
+static bool ceb_get_reset(Object *obj, Error **errp)
+{
+    return false; /* pulse input */
+}
+static void ceb_set_reset(Object *obj, bool value, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    if (!value || !s->ncsi_e810) { return; }
+    for (unsigned ch = 0; ch < 2; ch++) {
+        ceb_aen(s, ch, 1);
+        ceb_channel_reset(s, ch);
+    }
+    s->ncsi_selected = false;
+    qemu_log("CEB NC-SI reset: configuration cleared; AEN queued for subscribed channels\n");
+}
+
+static bool ceb_get_powered(Object *obj, Error **errp)
+{
+    return FTGMAC100(obj)->ncsi_powered;
+}
+static void ceb_set_powered(Object *obj, bool value, Error **errp)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    if (value == s->ncsi_powered) { return; }
+    s->ncsi_powered = value;
+    s->ncsi_selected = false;
+    s->ncsi_keep_phy = false;
+    for (unsigned ch = 0; ch < 2; ch++) { ceb_channel_reset(s, ch); }
+    if (s->reply_timer) { timer_del(s->reply_timer); }
+    s->reply_count = s->reply_head = s->reply_wait = 0;
+    qemu_log("CEB NC-SI NIC power=%s (host power, no standby)\n",
+             value ? "on" : "off");
+}
+
+static void ceb_init(Object *obj)
+{
+    FTGMAC100State *s = FTGMAC100(obj);
+    s->test_link = true;
+    s->ncsi_responsive = true;
+    object_property_add_bool(obj, "ncsi-powered", ceb_get_powered, ceb_set_powered);
+    s->test_speed = 1000;
+    s->ncsi_link[0] = s->ncsi_link[1] = true;
+    object_property_add_bool(obj, "ncsi-responsive", ceb_get_responsive, ceb_set_responsive);
+    object_property_add_bool(obj, "ncsi-reset", ceb_get_reset, ceb_set_reset);
+    object_property_add_bool(obj, "test-link", ceb_get_link, ceb_set_link);
+    object_property_add(obj, "test-speed", "int", ceb_get_speed,
+                        ceb_set_speed, NULL, NULL);
+    object_property_add_bool(obj, "channel0-link", ceb_get_channel_link,
+                             ceb_set_channel_link);
+    object_property_add_bool(obj, "channel1-link", ceb_get_channel1_link,
+                             ceb_set_channel1_link);
+    object_property_add(obj, "network-diagnostics", "str",
+                        ceb_get_diagnostics, NULL, NULL, NULL);
+}
